---
interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'GSAPとAstroで構築したインタラクティブな太陽系軌道早見シミュレーター。太陽、8つの惑星、主要衛星の公転軌道・日付指定・3D視点切り替えに対応。',
} = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`} />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  :root {
    --bg-deep: #040711;
    --bg-panel: rgba(11, 17, 34, 0.78);
    --bg-panel-solid: #0c1326;
    --border-subtle: rgba(148, 163, 184, 0.18);
    --border-highlight: rgba(56, 189, 248, 0.55);
    --text-main: #f1f5f9;
    --text-muted: #94a3b8;
    --accent-cyan: #38bdf8;
    --accent-amber: #fbbf24;
    --font-sans: 'Inter', 'Hiragino Kaku Gothic ProN', 'Hiragino Sans', 'Meiryo', system-ui, -apple-system, sans-serif;
    --font-mono: 'JetBrains Mono', 'Consolas', 'SFMono-Regular', monospace;
  }

  html,
  body {
    width: 100%;
    height: 100%;
    overflow: hidden;
    background-color: var(--bg-deep);
    color: var(--text-main);
    font-family: var(--font-sans);
    -webkit-font-smoothing: antialiased;
    user-select: none;
  }
</style>

