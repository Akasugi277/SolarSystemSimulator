  }

  .detail-class-badge.badge-candidate {
    background: rgba(251, 113, 133, 0.22);
    color: #fecdd3;
    border: 1px dotted rgba(251, 113, 133, 0.65);
  }

  .detail-class-badge.badge-comet {
    background: rgba(45, 212, 191, 0.22);
    color: #99f6e4;
    border: 1px dashed rgba(45, 212, 191, 0.6);
  }

  .detail-class-badge.badge-star {
    background: rgba(251, 191, 36, 0.22);
    color: #fde047;
  }

  .detail-zone-badge {
    font-size: 0.62rem;
    color: #94a3b8;
    background: rgba(148, 163, 184, 0.14);
    padding: 0.08rem 0.45rem;
    border-radius: 4px;
  }

  .detail-name-row {
    display: flex;
    align-items: baseline;
    gap: 0.45rem;
    flex-wrap: wrap;
  }

  .detail-name-row h2 {
    font-size: 1.15rem;
    font-weight: 700;
  }

  .detail-name-en {
    font-size: 0.76rem;
    color: var(--text-muted);
  }

  .detail-category {
    display: inline-block;
    font-size: 0.68rem;
    color: #38bdf8;
    margin-top: 0.1rem;
  }

  .btn-close-detail {
    background: rgba(148, 163, 184, 0.12);
    border: 1px solid transparent;
    color: var(--text-muted);
    width: 28px;
    height: 28px;
    border-radius: 6px;
    cursor: pointer;
    display: grid;
    place-items: center;
    flex-shrink: 0;
  }

  .btn-close-detail:hover {
    color: #ffffff;
    border-color: var(--border-subtle);
  }

  .detail-live-box {
    background: rgba(15, 23, 42, 0.78);
    border: 1px solid rgba(56, 189, 248, 0.28);
    border-radius: 10px;
    padding: 0.55rem 0.7rem;
  }

  .live-box-title {
    font-size: 0.65rem;
    font-weight: 700;
    color: #38bdf8;
    letter-spacing: 0.05em;
    margin-bottom: 0.3rem;
  }

  .live-metrics-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.38rem;
  }

  .live-metric {
    display: flex;
    flex-direction: column;
  }

  .metric-label {
    font-size: 0.62rem;
    color: var(--text-muted);
  }

  .metric-value {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 700;
    color: #f8fafc;
    margin-top: 0.08rem;
  }

  .detail-specs {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.38rem;
  }

  .spec-item {
    background: rgba(15, 23, 42, 0.55);
    border: 1px solid rgba(148, 163, 184, 0.12);
    border-radius: 8px;
    padding: 0.38rem 0.55rem;
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .spec-label {
    font-size: 0.62rem;
    color: var(--text-muted);
  }

  .spec-val {
    font-size: 0.72rem;
    font-weight: 600;
    color: #e2e8f0;
  }

  .detail-description {
    font-size: 0.76rem;
    line-height: 1.52;
    color: #cbd5e1;
  }

  /* 内部・マントル断面構造セクション */
  .detail-interior-section {
    border-top: 1px solid var(--border-subtle);
    padding-top: 0.65rem;
  }

  .moon-count-badge.interior-badge {
    background: rgba(249, 115, 22, 0.22);
    color: #fdba74;
  }

  .detail-interior-summary {
    font-size: 0.7rem;
    font-weight: 600;
    color: #fed7aa;
    margin-bottom: 0.45rem;
    line-height: 1.4;
  }

  .interior-visual-row {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    background: rgba(15, 23, 42, 0.72);
    border: 1px solid rgba(249, 115, 22, 0.22);
    border-radius: 10px;
    padding: 0.45rem 0.6rem;
    margin-bottom: 0.45rem;
  }

  .detail-interior-svg {
    width: 74px;
    height: 74px;
    flex-shrink: 0;
    filter: drop-shadow(0 0 8px rgba(249, 115, 22, 0.22));
  }

  .detail-interior-legend {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.22rem;
  }

  :global(.interior-legend-item) {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.66rem;
  }

  :global(.interior-legend-dot) {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  :global(.interior-legend-name) {
    color: #e2e8f0;
    font-weight: 600;
    flex: 1;
  }

  :global(.interior-legend-pct) {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    color: #94a3b8;
  }

  .detail-interior-list {
    display: flex;
    flex-direction: column;
    gap: 0.32rem;
  }

  :global(.interior-layer-card) {
    background: rgba(15, 23, 42, 0.58);
    border: 1px solid rgba(148, 163, 184, 0.16);
    border-radius: 8px;
    padding: 0.38rem 0.55rem;
  }

  :global(.interior-layer-card.is-mantle-layer) {
    border-color: rgba(249, 115, 22, 0.42);
    background: rgba(30, 27, 38, 0.68);
  }

  :global(.interior-layer-header) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.35rem;
    margin-bottom: 0.14rem;
  }

  :global(.interior-layer-title) {
    font-size: 0.71rem;
    font-weight: 700;
    color: #f8fafc;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  :global(.interior-layer-swatch) {
    width: 9px;
    height: 9px;
    border-radius: 3px;
    flex-shrink: 0;
  }

  :global(.interior-layer-ratio) {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    color: #fdba74;
    background: rgba(249, 115, 22, 0.15);
    padding: 0.04rem 0.35rem;
    border-radius: 4px;
    flex-shrink: 0;
  }

  :global(.interior-layer-detail) {
    font-size: 0.67rem;
    color: #cbd5e1;
    line-height: 1.42;
  }

  .detail-rings-section {
    border-top: 1px solid var(--border-subtle);
    padding-top: 0.65rem;
  }

  .moon-count-badge.ring-badge {
    background: rgba(251, 191, 36, 0.2);
    color: #fde047;
  }

  .detail-ring-summary {
    font-size: 0.7rem;
    color: #fde68a;
    margin-bottom: 0.4rem;
    line-height: 1.4;
  }

  .detail-rings-list {
    display: flex;
    flex-direction: column;
    gap: 0.28rem;
  }

  :global(.ring-band-item) {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    background: rgba(15, 23, 42, 0.62);
    border: 1px solid rgba(251, 191, 36, 0.18);
    border-radius: 6px;
    padding: 0.3rem 0.5rem;
    font-size: 0.7rem;
  }

  :global(.ring-band-swatch) {
    width: 12px;
    height: 5px;
    border-radius: 999px;
    flex-shrink: 0;
    box-shadow: 0 0 6px currentColor;
  }

  :global(.ring-band-name) {
    color: #f8fafc;
    font-weight: 600;
    flex: 1;
  }

  :global(.ring-band-meta) {
    font-size: 0.62rem;
    color: #94a3b8;
    background: rgba(148, 163, 184, 0.14);
    padding: 0.04rem 0.35rem;
    border-radius: 4px;
  }

  .detail-moons-section {
    border-top: 1px solid var(--border-subtle);
    padding-top: 0.65rem;
  }

  .moons-section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.45rem;
  }

  .moons-section-header h3 {
    font-size: 0.8rem;
    font-weight: 700;
    color: #f1f5f9;
  }

  .moon-count-badge {
    font-size: 0.66rem;
    padding: 0.06rem 0.45rem;
    border-radius: 999px;
    background: rgba(56, 189, 248, 0.18);
    color: #38bdf8;
    font-weight: 600;
  }

  .detail-moons-list {
    display: flex;
    flex-direction: column;
    gap: 0.38rem;
  }

  :global(.moon-card) {
    background: rgba(15, 23, 42, 0.68);
    border: 1px solid rgba(148, 163, 184, 0.16);
    border-radius: 8px;
    padding: 0.48rem 0.6rem;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  :global(.moon-card:hover),
  :global(.moon-card.active) {
    border-color: #38bdf8;
    background: rgba(30, 41, 59, 0.9);
  }

  :global(.moon-card-header) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.4rem;
    margin-bottom: 0.15rem;
  }

  :global(.moon-card-name) {
    font-size: 0.76rem;
    font-weight: 700;
    color: #f8fafc;
    display: inline-flex;
    align-items: center;
    gap: 0.32rem;
  }

  :global(.moon-card-name.is-major-name) {
    font-weight: 800;
  }

  :global(.moon-card-name.is-minor-name) {
    font-weight: 400;
  }

  :global(.moon-dot) {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    display: inline-block;
  }

  :global(.moon-card-period) {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: #38bdf8;
  }

  :global(.moon-card-period.retro-badge) {
    color: #f472b6;
  }

  :global(.moon-card-meta) {
    font-size: 0.64rem;
    color: var(--text-muted);
    margin-bottom: 0.18rem;
  }

  :global(.moon-card-desc) {
    font-size: 0.68rem;
    line-height: 1.42;
    color: #cbd5e1;
  }

  :global(.no-moons-msg) {
    font-size: 0.74rem;
    color: var(--text-muted);
    padding: 0.35rem 0;
  }

  /* 下部タイムライン＆コントロールバー */
  .bottom-controls {
    position: relative;
    z-index: 30;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.65rem;
    padding: 0.5rem 0.95rem;
    background: var(--bg-panel);
    backdrop-filter: blur(14px);
    border-top: 1px solid var(--border-subtle);
    flex-wrap: wrap;
  }

  .transport-controls {
    display: flex;
    align-items: center;
    gap: 0.32rem;
    flex-wrap: wrap;
  }

  .ctrl-btn {
    border: 1px solid var(--border-subtle);
    background: rgba(15, 23, 42, 0.78);
    color: var(--text-main);
    font-size: 0.72rem;
    font-weight: 600;
    padding: 0.34rem 0.6rem;
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.2s ease;
