  .speed-selector {
    display: flex;
    align-items: center;
    gap: 0.2rem;
  }

  .speed-btn {
    border: 1px solid var(--border-subtle);
    background: rgba(15, 23, 42, 0.65);
    color: var(--text-muted);
    font-size: 0.68rem;
    font-weight: 600;
    padding: 0.3rem 0.48rem;
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.18s ease;
  }

  .speed-btn.active {
    background: rgba(56, 189, 248, 0.2);
    border-color: var(--accent-cyan);
    color: #38bdf8;
  }

  .timeline-scrubber {
