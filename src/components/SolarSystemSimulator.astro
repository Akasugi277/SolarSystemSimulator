  .celestial-node.is-selected .moon-label,
  .moon-node.is-highlighted .moon-label {
    opacity: 1;
    fill: #f8fafc;
  }

  .moon-node.is-highlighted .moon-sphere {
    stroke: #38bdf8;
    stroke-width: 1.2px;
  }

  /* 左上日時＆3段階縮尺ステータスバッジ */
  .hud-date-badge {
    position: absolute;
    top: 0.75rem;
    left: 0.9rem;
    background: var(--bg-panel);
    backdrop-filter: blur(12px);
    border: 1px solid var(--border-subtle);
    border-radius: 12px;
    padding: 0.5rem 0.8rem;
    pointer-events: auto;
    max-width: 340px;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.4);
    transition: all 0.25s ease;
    user-select: none;
  }

  .hud-date-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.4rem;
    margin-bottom: 0.15rem;
  }

  .hud-badge-tag {
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--accent-cyan);
  }

  .hud-speed-indicator {
    font-size: 0.62rem;
    font-family: var(--font-mono);
    color: #34d399;
    background: rgba(16, 185, 129, 0.14);
    padding: 0.06rem 0.38rem;
    border-radius: 999px;
  }

  .hud-speed-indicator.paused {
    color: #fbbf24;
    background: rgba(251, 191, 36, 0.15);
  }

  .hud-toggle-btn {
    background: transparent;
    border: none;
    color: #94a3b8;
    cursor: pointer;
    padding: 0.1rem 0.3rem;
    font-size: 0.65rem;
    line-height: 1;
    border-radius: 4px;
    transition: color 0.18s ease, background 0.18s ease;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .hud-toggle-btn:hover {
    color: #38bdf8;
    background: rgba(56, 189, 248, 0.15);
  }

  .hud-current-date {
    font-family: var(--font-mono);
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    color: #ffffff;
    line-height: 1.15;
  }

  .hud-collapsible-content {
    overflow: hidden;
    max-height: 120px;
    opacity: 1;
    transition: max-height 0.25s ease, opacity 0.2s ease, margin-top 0.2s ease;
  }

  .hud-date-badge.is-collapsed {
    padding: 0.35rem 0.65rem;
    cursor: pointer;
  }

  .hud-date-badge.is-collapsed .hud-collapsible-content {
    max-height: 0;
    opacity: 0;
    margin-top: 0;
    pointer-events: none;
  }

  .hud-date-badge.is-collapsed .hud-current-date {
    font-size: 0.95rem;
  }

  .hud-j2000-days {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--text-muted);
  }

  .hud-zone-status {
    margin-top: 0.3rem;
    padding-top: 0.28rem;
    border-top: 1px solid rgba(148, 163, 184, 0.16);
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .hud-zone-title {
    font-size: 0.68rem;
    color: #cbd5e1;
  }

  .hud-zone-title strong {
    color: #38bdf8;
    font-weight: 700;
  }

  .hud-zone-range {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    color: var(--text-muted);
  }

  /* 左下ズームコントロール */
  .hud-bottom-left {
    position: absolute;
    bottom: 0.75rem;
    left: 0.9rem;
  }

  .hud-zoom-controls {
    display: flex;
    align-items: center;
    gap: 0.38rem;
  }

  .hud-icon-btn,
  .hud-reset-btn {
    background: var(--bg-panel);
    backdrop-filter: blur(10px);
    border: 1px solid var(--border-subtle);
    color: var(--text-main);
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .hud-icon-btn {
    width: 34px;
    height: 34px;
    font-size: 1rem;
    font-weight: 700;
    display: grid;
    place-items: center;
  }

  .hud-reset-btn {
    height: 34px;
    padding: 0 0.75rem;
    font-size: 0.72rem;
    font-weight: 600;
  }

  .hud-icon-btn:hover,
  .hud-reset-btn:hover {
    border-color: var(--border-highlight);
    background: rgba(30, 41, 59, 0.85);
  }

  .quick-3d-btn.active {
    border-color: var(--accent-cyan);
    background: rgba(56, 189, 248, 0.22);
    color: #38bdf8;
    box-shadow: 0 0 10px rgba(56, 189, 248, 0.35);
  }

  /* 右側天体詳細パネル（PC表示・説明文のテキスト選択を許可） */
  .detail-panel {
    position: absolute;
    top: 0.75rem;
    right: 0.9rem;
    bottom: 0.75rem;
    width: 360px;
    max-width: calc(100vw - 1.8rem);
    background: rgba(10, 16, 33, 0.92);
    backdrop-filter: blur(16px);
    border: 1px solid rgba(148, 163, 184, 0.25);
    border-radius: 14px;
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    overflow-y: auto;
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.55);
    z-index: 25;
    user-select: text;
  }

  .sheet-drag-handle {
    display: none;
    width: 42px;
    height: 4px;
    border-radius: 999px;
    background: rgba(148, 163, 184, 0.35);
    margin: 0 auto 0.2rem;
    flex-shrink: 0;
  }

  .detail-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .detail-title-group {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .detail-symbol {
    font-size: 1.95rem;
    line-height: 1;
  }

  .detail-badges-row {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    margin-bottom: 0.18rem;
    flex-wrap: wrap;
  }

  .detail-class-badge {
    font-size: 0.62rem;
    font-weight: 700;
    padding: 0.08rem 0.45rem;
    border-radius: 4px;
  }

  .detail-class-badge.badge-planet {
    background: rgba(56, 189, 248, 0.2);
    color: #38bdf8;
  }

  .detail-class-badge.badge-dwarf {
