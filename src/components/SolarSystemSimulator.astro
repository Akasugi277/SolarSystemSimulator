    /**
     * 近傍基準圏のうち「実在の探査機が周回した軌道」を示すID。
     * これらのみ小さな正四面体（探査機）が軌道を周回する。
     * それ以外（ロッシュ限界・ヒル球・アルヴェーン臨界面・外気圏境界など）は天体ではない参照境界であり、
     * 衛星と誤解されないよう公転するマーカーは置かず、静止した境界リングとラベルだけで表示する。
     */
    const PROBE_ZONE_IDS = new Set([
      'sun_parker_perihelion',
      'mercury_bepicolombo_orbit',
      'venus_akatsuki_orbit',
      'ceres_dawn_lamo',
      'jupiter_juno_orbit',
      'saturn_cassini_orbit',
      'earth_tiangong_orbit',
      'earth_iss_orbit',
      'earth_lunar_gateway_orbit',
    ]);

    function isProbeZone(id: string): boolean {
      return PROBE_ZONE_IDS.has(id);
    }

    /**
     * 近傍基準圏のカード（詳細パネル用）のHTMLを生成する
     */
    function buildNearZoneCardsHtml(zones: NearSpaceZoneConfig[], distanceLabel: string): string {
      const isVisible = simState.showProbesAndBoundaries;
      const cardsHtml = zones
        .map((z) => {
          const probe = isProbeZone(z.id);
          const kindBadge = probe
            ? '<span class="zone-kind-badge is-probe">▲ 探査機が周回</span>'
            : '<span class="zone-kind-badge is-boundary">◌ 参照境界（天体ではありません）</span>';
          return `
            <div class="moon-card" data-moon-card-id="${z.id}" data-zone-kind="${probe ? 'probe' : 'boundary'}" style="display: ${isVisible ? '' : 'none'};">
              <div class="moon-card-header">
                <span class="moon-card-name">
                  <span class="moon-dot" style="background:${z.color}"></span>
                  ${z.nameJa} <small>(${z.nameEn})</small>
                </span>
                <span class="moon-card-period ${z.orbitalPeriodDays < 0 ? 'retro-badge' : ''}">${z.badgeLabel}</span>
              </div>
              <div class="moon-card-meta">
                ${kindBadge} ${distanceLabel}: 約${z.distanceKm.toLocaleString()} km (${z.ratioLabel})
              </div>
              <p class="moon-card-desc">${z.description}</p>
            </div>
          `;
        })
        .join('');

      return `
        <div class="probe-boundary-notice" data-probe-notice style="display: ${isVisible ? 'none' : 'flex'};">
          <span>🚀 探査機・境界線は現在非表示です</span>
          <button type="button" class="btn-quick-toggle-probes">表示する</button>
        </div>
        ${cardsHtml}
      `;
    }

    /**
     * 詳細パネル内のカード群（衛星・近傍基準圏）へハイライト連動のイベントを登録する
     */
    function bindMoonCardHighlight(container: HTMLElement | null) {
      if (!container) return;
      const cards = container.querySelectorAll<HTMLElement>('[data-moon-card-id]');
      cards.forEach((card) => {
        const cardId = card.dataset.moonCardId || '';
        card.addEventListener('mouseenter', () => {
          simState.highlightedMoonId = cardId;
          card.classList.add('active');
        });
        card.addEventListener('mouseleave', () => {
          simState.highlightedMoonId = '';
          card.classList.remove('active');
        });
        card.addEventListener('click', () => {
          simState.highlightedMoonId = simState.highlightedMoonId === cardId ? '' : cardId;
          container
            .querySelectorAll<HTMLElement>('[data-moon-card-id]')
            .forEach((c) => c.classList.toggle('active', c.dataset.moonCardId === simState.highlightedMoonId));
        });
      });
    }

