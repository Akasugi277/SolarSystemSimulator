        }

        // 大暗斑（Great Dark Spot）と白いメタン氷の伴雲（Scooter）
        const gdsGroup = document.createElementNS(svgNs, 'g');
        const gdsEl = document.createElementNS(svgNs, 'ellipse');
        gdsEl.setAttribute('rx', '13');
        gdsEl.setAttribute('ry', '7.5');
        gdsEl.setAttribute('fill', '#172554');
        gdsEl.setAttribute('stroke', '#93c5fd');
        gdsEl.setAttribute('stroke-width', '1.4');
        const companionCloud = document.createElementNS(svgNs, 'ellipse');
        companionCloud.setAttribute('cx', '4');
        companionCloud.setAttribute('cy', '-6.5');
        companionCloud.setAttribute('rx', '8.5');
        companionCloud.setAttribute('ry', '2.6');
        companionCloud.setAttribute('fill', '#f8fafc');
        gdsGroup.appendChild(gdsEl);
        gdsGroup.appendChild(companionCloud);
        atmoClipGroupEl.appendChild(gdsGroup);

        const scooterEl = document.createElementNS(svgNs, 'ellipse');
        scooterEl.setAttribute('rx', '6.5');
