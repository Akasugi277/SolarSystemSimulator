---
import {
  SUN_DATA,
  PLANETS_DATA,
  SCALE_ZONES_META,
  MOON_SYSTEM_TARGET_IDS,
  J2000_TIMESTAMP,
} from '../data/solarSystem';

// クライアント側スクリプトへ渡すためにJSONシリアライズ可能なデータを準備
const serializedSun = JSON.stringify(SUN_DATA);
const serializedPlanets = JSON.stringify(PLANETS_DATA);
const serializedZonesMeta = JSON.stringify(SCALE_ZONES_META);
const serializedMoonTargets = JSON.stringify(MOON_SYSTEM_TARGET_IDS);

// 天体・衛星軌道拡大ビュー対象の14天体スイッチャー項目（太陽・8惑星・5公認準惑星）
const moonSystemSwitcherItems = MOON_SYSTEM_TARGET_IDS.map((id) => {
  if (id === 'sun') {
    return {
      id: SUN_DATA.id,
      nameJa: SUN_DATA.nameJa,
      nameEn: SUN_DATA.nameEn,
      symbol: SUN_DATA.symbol,
      color: '#fbbf24',
      isMajor: true,
      countLabel: '(恒星)',
      titleText: '太陽 (Sun) の内部断面・コロナ・太陽圏近傍領域を拡大表示',
    };
  }
  const p = PLANETS_DATA.find((item) => item.id === id)!;
  return {
    id: p.id,
    nameJa: p.nameJa,
    nameEn: p.nameEn,
    symbol: p.symbol,
    color: p.color,
    isMajor: p.bodyClass === 'planet',
    countLabel: p.moons.length > 0 ? `(${p.moons.length})` : '(拡大)',
    titleText:
      p.moons.length > 0
        ? `${p.nameJa} (${p.nameEn}) と ${p.moons.length}個の衛星軌道を拡大表示`
        : `${p.nameJa} (${p.nameEn}) の内部断面・近傍重力圏（ロッシュ限界・ヒル球・探査軌道）を拡大表示`,
  };
});

// ナビゲーション表示用にグループ分け
const innerPlanets = PLANETS_DATA.filter((p) => p.subGroup === 'inner_planet');
const asteroidDwarfs = PLANETS_DATA.filter((p) => p.subGroup === 'asteroid_dwarf');
const outerPlanets = PLANETS_DATA.filter((p) => p.subGroup === 'outer_planet');
const plutoidDwarfs = PLANETS_DATA.filter((p) => p.subGroup === 'plutoid');
const candidateDwarfs = PLANETS_DATA.filter((p) => p.subGroup === 'tno_candidate');
const periodicComets = PLANETS_DATA.filter((p) => p.subGroup === 'comet_periodic');

// 彗星核（正六面体）の3面シェーディング色（上面を明るく、右側面を暗くして立体感を出す）
function cometCubeFaceColors(color: string): { top: string; left: string; right: string } {
  const m = /^#?([0-9a-f]{6})$/i.exec(color);
  const base = m ? parseInt(m[1], 16) : 0x99f6e4;
  const shade = (factor: number) => {
    const r = Math.min(255, Math.round(((base >> 16) & 255) * factor));
    const g = Math.min(255, Math.round(((base >> 8) & 255) * factor));
    const b = Math.min(255, Math.round((base & 255) * factor));
    return `rgb(${r}, ${g}, ${b})`;
  };
  return { top: shade(1.15), left: shade(0.78), right: shade(0.52) };
}

// 小惑星帯（メインベルト：2.1〜3.3 AU）の多層半透明ダスト・微惑星粒子群を生成（全240粒子）
const MAIN_BELT_COLORS = ['#bef264', '#d9f99d', '#fde68a', '#cbd5e1', '#a3e635'];
const mainBeltParticles = Array.from({ length: 240 }).map((_, i) => {
  // 黄金角ベースの角度分散＋微小なクラスタリングゆらぎ
  const angle = (((i * 137.508 + Math.sin(i * 0.7) * 8) % 360) * Math.PI) / 180;
  // カークウッドの間隙（共鳴ギャップ）を意識した3つのサブリング分布 (-0.50 〜 +0.50)
  const subBand = i % 3;
  const bandCenter = subBand === 0 ? -0.31 : subBand === 1 ? 0.0 : 0.31;
  const jitter = (((i * 29 + 17) % 100) / 100 - 0.5) * 0.28;
  const radiusOffset = Math.max(-0.49, Math.min(0.49, bandCenter + jitter));

  // 3段階の透明粒子レイヤー（halo: 淡い星間ダスト雲, grain: 半透明ケイ酸塩/炭素質粒子, core: 微惑星コア）
  const tier = i % 5 === 0 ? 'halo' : i % 4 === 1 ? 'core' : 'grain';
  const size =
    tier === 'halo'
      ? 2.2 + (i % 4) * 0.38
      : tier === 'core'
        ? 0.78 + (i % 3) * 0.22
        : 1.05 + (i % 4) * 0.26;
  const baseOpacity =
    tier === 'halo'
      ? 0.08 + (i % 4) * 0.022
      : tier === 'core'
        ? 0.36 + (i % 4) * 0.055
        : 0.17 + (i % 5) * 0.042;

  // 内縁（2.1 AU）ほど速く、外縁（3.3 AU）ほどゆっくり公転するケプラー周期（日）と視覚ドリフト角速度
  const normR = radiusOffset + 0.5; // 0.0 (内縁) 〜 1.0 (外縁)
  const periodDays = Math.round(1150 + normR * 980);
  const visualSpeed = Number((0.048 - normR * 0.022).toFixed(4));
  const eccOffset = Number((0.016 + ((i * 13) % 5) * 0.011).toFixed(3));
  const shimmerSpeed = Number((1.35 + (i % 6) * 0.34).toFixed(2));
  const phase = Number((((i * 53) % 360) * (Math.PI / 180)).toFixed(2));
  const color = MAIN_BELT_COLORS[i % MAIN_BELT_COLORS.length];

  return {
    angle: Number(angle.toFixed(4)),
    radiusOffset: Number(radiusOffset.toFixed(4)),
    eccOffset,
    size: Number(size.toFixed(2)),
    baseOpacity: Number(baseOpacity.toFixed(3)),
    periodDays,
    visualSpeed,
    shimmerSpeed,
    phase,
    tier,
    color,
  };
});

// エッジワース・カイパーベルト（30〜52 AU）の多層半透明メタン/窒素氷・微惑星粒子群を生成（全320粒子）
const KUIPER_BELT_COLORS = ['#d8b4fe', '#c4b5fd', '#a5f3fc', '#93c5fd', '#e0e7ff', '#f0abfc'];
const kuiperBeltParticles = Array.from({ length: 320 }).map((_, i) => {
  const angle = (((i * 137.508 + 45 + Math.cos(i * 0.5) * 10) % 360) * Math.PI) / 180;
  // 古典的キュビワノ族帯と共鳴冥王星族（プルティーノ）・外縁散乱帯の分布 (-0.50 〜 +0.50)
  const rawOffset = ((i * 43 + 11) % 100) / 100 - 0.5;
  const waveOffset = Math.sin(i * 1.15) * 0.08;
  const radiusOffset = Math.max(-0.5, Math.min(0.5, rawOffset * 0.88 + waveOffset));

  // 3段階の透明氷粒子レイヤー（frost: 淡い氷霧雲, ice: 半透明メタン・窒素氷微粒子, crystal: 氷結晶グリント）
  const tier = i % 5 === 0 ? 'frost' : i % 4 === 2 ? 'crystal' : 'ice';
  const size =
    tier === 'frost'
      ? 2.4 + (i % 4) * 0.44
      : tier === 'crystal'
        ? 0.82 + (i % 3) * 0.24
        : 1.1 + (i % 4) * 0.28;
  const baseOpacity =
    tier === 'frost'
      ? 0.065 + (i % 4) * 0.02
      : tier === 'crystal'
        ? 0.34 + (i % 4) * 0.052
        : 0.15 + (i % 5) * 0.04;

  const normR = radiusOffset + 0.5; // 0.0 (30 AU内縁) 〜 1.0 (52 AU外縁)
  const periodDays = Math.round(61000 + normR * 64000);
  const visualSpeed = Number((0.032 - normR * 0.016).toFixed(4));
  const eccOffset = Number((0.022 + ((i * 19) % 6) * 0.012).toFixed(3));
  const shimmerSpeed = Number((1.15 + (i % 7) * 0.28).toFixed(2));
  const phase = Number((((i * 71) % 360) * (Math.PI / 180)).toFixed(2));
  const color = KUIPER_BELT_COLORS[i % KUIPER_BELT_COLORS.length];

  return {
    angle: Number(angle.toFixed(4)),
    radiusOffset: Number(radiusOffset.toFixed(4)),
    eccOffset,
    size: Number(size.toFixed(2)),
    baseOpacity: Number(baseOpacity.toFixed(3)),
    periodDays,
    visualSpeed,
    shimmerSpeed,
    phase,
    tier,
    color,
  };
});
---

<div
  class="simulator-root"
  id="simulator-root"
  data-sun={serializedSun}
  data-planets={serializedPlanets}
  data-zones-meta={serializedZonesMeta}
  data-moon-targets={serializedMoonTargets}
  data-j2000={J2000_TIMESTAMP}
>
  <!-- 背景星空キャンバス -->
  <canvas id="starfield-canvas" class="starfield-canvas" aria-hidden="true"></canvas>

  <!-- 上部ヘッダー＆3段階表示縮尺セレクター＋衛星系拡大専用ビューボタン＋ハンバーガーメニュー -->
  <header class="top-bar">
    <div class="top-bar-row primary-row">
      <div class="brand-area">
        <div class="brand-icon" aria-hidden="true">☉</div>
        <div class="brand-titles">
          <h1>SOLAR SYSTEM SIMULATOR</h1>
          <p class="subtitle">太陽系軌道早見シミュレーター（8惑星・準惑星・外縁天体・5彗星）</p>
        </div>
      </div>

      <!-- 表示縮尺（3段階：内惑星 / 外惑星 / 外縁天体 ＋ 4. 衛星系拡大専用ビュー）切り替えバー -->
      <div class="scale-zone-selector" role="group" aria-label="表示縮尺および衛星系拡大ビュー切り替え">
        <span class="bar-group-label">縮尺:</span>
        <button
          type="button"
          class="zone-btn active"
          data-scale-zone="inner"
          title="内惑星（水星〜火星）・ケレス・外惑星基準の木星・周期彗星の近日点領域に自動調整します"
        >
          <span class="zone-indicator inner-dot"></span>
          <span>1. 内惑星</span>
          <small class="zone-sub-text">(水星〜火星・木星)</small>
        </button>
        <button
          type="button"
          class="zone-btn"
          data-scale-zone="outer"
          title="外惑星（木星〜海王星）・外縁基準の冥王星・木星族彗星・ハレー彗星に縮尺を自動調整します"
        >
          <span class="zone-indicator outer-dot"></span>
          <span>2. 外惑星</span>
          <small class="zone-sub-text">(木星〜海王星・冥王星)</small>
        </button>
        <button
          type="button"
          class="zone-btn"
          data-scale-zone="tno"
          title="外縁天体（海王星・冥王星型・セドナ等・長周期彗星）に縮尺を自動調整します"
        >
          <span class="zone-indicator tno-dot"></span>
          <span>3. 外縁天体</span>
          <small class="zone-sub-text">(海王星・冥王星等)</small>
        </button>
        <button
          type="button"
          id="btn-moon-system-mode"
          class="moon-mode-btn"
          title="太陽・水星・金星・地球・火星・ケレス・木星・土星・天王星・海王星・冥王星・ハウメア・マケマケ・エリスの14天体と衛星軌道・近傍圏を拡大表示する専用ビューへ切り替えます"
        >
          <span class="zone-indicator moon-mode-dot"></span>
          <span>4. 天体・衛星拡大</span>
          <small class="zone-sub-text">(14天体専用ビュー)</small>
        </button>
      </div>

      <!-- 右端：すべての表示トグルを集約したハンバーガーメニューボタン -->
      <div class="hamburger-wrapper">
        <button
          type="button"
          id="btn-hamburger"
          class="hamburger-btn"
          aria-expanded="false"
          aria-controls="hamburger-menu-drawer"
          title="視点・軌道間隔・衛星・準惑星・彗星の表示設定メニューを開く"
        >
          <span class="hamburger-icon" aria-hidden="true">
            <span></span>
            <span></span>
            <span></span>
          </span>
          <span class="hamburger-label">表示設定</span>
        </button>
      </div>
    </div>

    <!-- 下段：横スクロール可能な天体クイック選択バー -->
    <nav class="top-bar-row celestial-nav" aria-label="天体クイック選択">
      <button type="button" class="nav-pill active" data-target-id="overview" title="個別フォーカスを解除して現在の縮尺全体を表示">
        <span class="pill-symbol">✦</span>
        <span class="pill-name">縮尺全体</span>
      </button>

      <button type="button" class="nav-pill major-pill" data-target-id="sun" title="太陽を選択">
        <span class="pill-symbol" style="color: #fbbf24;">{SUN_DATA.symbol}</span>
        <span class="pill-name">{SUN_DATA.nameJa}</span>
      </button>

      <span class="nav-divider" aria-hidden="true"></span>
      <span class="nav-section-tag" data-section-zone="inner">内惑星</span>
      {
        innerPlanets.map((planet) => (
          <button
            type="button"
            class="nav-pill major-pill"
            data-target-id={planet.id}
            data-home-zone={planet.homeZone}
            data-body-class={planet.bodyClass}
          >
            <span class="pill-symbol" style={`color: ${planet.color};`}>{planet.symbol}</span>
            <span class="pill-name">{planet.nameJa}</span>
            {planet.moons.length > 0 && <span class="pill-moon-count">{planet.moons.length}</span>}
          </button>
        ))
      }

      <span class="nav-divider" aria-hidden="true"></span>
      <span class="nav-section-tag dwarf-tag" data-section-zone="inner">準惑星(小惑星)</span>
      {
        asteroidDwarfs.map((dwarf) => (
          <button
            type="button"
            class="nav-pill dwarf-pill"
            data-target-id={dwarf.id}
            data-home-zone={dwarf.homeZone}
            data-body-class={dwarf.bodyClass}
          >
            <span class="pill-symbol" style={`color: ${dwarf.color};`}>{dwarf.symbol}</span>
            <span class="pill-name">{dwarf.nameJa}</span>
            <span class="pill-class-badge">準</span>
          </button>
        ))
      }

      <span class="nav-divider" aria-hidden="true"></span>
      <span class="nav-section-tag" data-section-zone="outer">外惑星</span>
      {
        outerPlanets.map((planet) => (
          <button
            type="button"
            class="nav-pill major-pill"
            data-target-id={planet.id}
            data-home-zone={planet.homeZone}
            data-body-class={planet.bodyClass}
          >
            <span class="pill-symbol" style={`color: ${planet.color};`}>{planet.symbol}</span>
            <span class="pill-name">{planet.nameJa}</span>
            {planet.moons.length > 0 && <span class="pill-moon-count">{planet.moons.length}</span>}
          </button>
        ))
      }

      <span class="nav-divider" aria-hidden="true"></span>
      <span class="nav-section-tag plutoid-tag" data-section-zone="tno">準惑星(冥王星型)</span>
      {
        plutoidDwarfs.map((dwarf) => (
          <button
            type="button"
            class="nav-pill dwarf-pill plutoid-pill"
            data-target-id={dwarf.id}
            data-home-zone={dwarf.homeZone}
            data-body-class={dwarf.bodyClass}
          >
            <span class="pill-symbol" style={`color: ${dwarf.color};`}>{dwarf.symbol}</span>
            <span class="pill-name">{dwarf.nameJa}</span>
            <span class="pill-class-badge plutoid-badge">冥</span>
            {dwarf.moons.length > 0 && <span class="pill-moon-count">{dwarf.moons.length}</span>}
          </button>
        ))
      }

      <span class="nav-divider" aria-hidden="true"></span>
      <span class="nav-section-tag candidate-tag" data-section-zone="tno">準惑星候補(外縁)</span>
      {
        candidateDwarfs.map((cand) => (
          <button
            type="button"
            class="nav-pill candidate-pill"
            data-target-id={cand.id}
            data-home-zone={cand.homeZone}
            data-body-class={cand.bodyClass}
          >
            <span class="pill-symbol" style={`color: ${cand.color};`}>{cand.symbol}</span>
            <span class="pill-name">{cand.nameJa}</span>
            <span class="pill-class-badge candidate-badge">候</span>
            {cand.moons.length > 0 && <span class="pill-moon-count">{cand.moons.length}</span>}
          </button>
        ))
      }

      <span class="nav-divider" aria-hidden="true"></span>
      <span class="nav-section-tag comet-tag">周期彗星</span>
      {
        periodicComets.map((comet) => (
          <button
            type="button"
            class="nav-pill comet-pill"
            data-target-id={comet.id}
            data-home-zone={comet.homeZone}
            data-body-class={comet.bodyClass}
          >
            <span class="pill-symbol" style={`color: ${comet.color};`}>{comet.symbol}</span>
            <span class="pill-name">{comet.nameJa}</span>
            <span class="pill-class-badge comet-badge">彗</span>
          </button>
        ))
      }
    </nav>
  </header>

  <!-- ハンバーガーメニュー・ドロワー＆背景バックドロップ（トグル類を集約） -->
  <div id="menu-backdrop" class="menu-backdrop" aria-hidden="true"></div>
  <aside id="hamburger-menu-drawer" class="hamburger-menu-drawer" aria-label="表示設定メニュー">
    <div class="drawer-header">
      <h3>表示設定・トグルメニュー</h3>
      <button type="button" id="btn-close-drawer" class="btn-close-drawer" title="メニューを閉じる">✕</button>
    </div>

    <div class="drawer-body">
      <!-- 1. カメラ視点モード -->
      <div class="drawer-section">
        <span class="drawer-label">視点モード切り替え</span>
        <div class="toggle-group full-width" role="group" aria-label="視点モード切り替え">
          <button type="button" id="btn-view-2d" class="toggle-btn active">
            2D 真上視点 (北極側)
          </button>
          <button type="button" id="btn-view-3d" class="toggle-btn">
            3D 斜めチルト視点
          </button>
        </div>
      </div>

      <!-- 2. 縮尺内の軌道間隔モード -->
      <div class="drawer-section">
        <span class="drawer-label">縮尺内の軌道間隔モード</span>
        <div class="toggle-group full-width" role="group" aria-label="縮尺内の軌道間隔モード">
          <button type="button" id="btn-scale-equal" class="toggle-btn active">
            自動間隔 (重なり防止)
          </button>
          <button type="button" id="btn-scale-real" class="toggle-btn">
            実距離比 (AU基準)
          </button>
        </div>
      </div>

      <!-- 3. 天体・要素の表示ON/OFFトグル -->
      <div class="drawer-section">
        <span class="drawer-label">天体レイヤーの表示切替</span>
        <div class="drawer-switch-list">
          <button type="button" id="btn-toggle-moons" class="drawer-switch-btn active">
            <span>衛星・衛星軌道の表示</span>
            <span id="badge-toggle-moons" class="switch-state">ON</span>
          </button>
          <button type="button" id="btn-toggle-comets" class="drawer-switch-btn active">
            <span>☄ 周期彗星 (5天体) の表示</span>
            <span id="badge-toggle-comets" class="switch-state">ON</span>
          </button>
          <button type="button" id="btn-toggle-probes" class="drawer-switch-btn" title="探査機（ISS、天宮、ジュノー、カッシーニ等）や参照境界線（ロッシュ限界・ヒル球等）の表示切替">
            <span>🚀 探査機・境界線の表示</span>
            <span id="badge-toggle-probes" class="switch-state">OFF</span>
          </button>
        </div>
      </div>

      <!-- 4. 区分ハイライト強調トグル -->
      <div class="drawer-section">
        <span class="drawer-label">特定区分のハイライト強調</span>
        <div class="drawer-switch-list">
          <button type="button" id="btn-emphasize-rings" class="drawer-switch-btn active">
            <span>🪐 外惑星4天体（木・土・天・海）の環を強調</span>
            <span id="badge-emphasize-rings" class="switch-state">ON</span>
          </button>
          <button type="button" id="btn-highlight-dwarfs" class="drawer-switch-btn">
            <span>⚳ 準惑星 (5) ＋ 準惑星候補 (4) を強調</span>
            <span id="badge-highlight-dwarfs" class="switch-state">OFF</span>
          </button>
          <button type="button" id="btn-highlight-comets" class="drawer-switch-btn">
            <span>☄ 周期彗星 (ハレー・エンケ等5天体) を強調</span>
            <span id="badge-highlight-comets" class="switch-state">OFF</span>
          </button>
        </div>
      </div>

      <!-- 5. 3D軌道傾斜・高度ポールの表示と強調設定 -->
      <div class="drawer-section">
        <span class="drawer-label">3D軌道傾斜・高度ポールの表示</span>
        <div class="drawer-switch-list">
          <button type="button" id="btn-toggle-inclination-guides" class="drawer-switch-btn active" title="3D視点時に黄道面からの高低差ポール、足元フットプリント、交点線を表示">
            <span>📐 3D高度ポール・交点線の表示</span>
            <span id="badge-toggle-inclination-guides" class="switch-state">ON</span>
          </button>
        </div>
        <div class="drawer-label" style="margin-top: 10px; font-size: 0.72rem; color: #94a3b8;">高度ポールの表示対象</div>
        <div class="toggle-group full-width" style="margin-top: 4px;" role="group" aria-label="高度ポールの表示対象">
          <button type="button" id="btn-inc-mode-selected" class="toggle-btn active" title="選択した天体のみ、または代表天体のみスマート表示して画面の重なりを防ぎます（推奨）">
            選択天体のみ (推奨)
          </button>
          <button type="button" id="btn-inc-mode-all" class="toggle-btn" title="全天体の高度ポールを一度に表示します">
            全天体一括
          </button>
        </div>
        <div class="drawer-label" style="margin-top: 10px; font-size: 0.72rem; color: #94a3b8;">軌道傾斜角の視覚的強調倍率</div>
        <div class="toggle-group full-width" style="margin-top: 4px;" role="group" aria-label="軌道傾斜の強調倍率">
          <button type="button" id="btn-inc-boost-1x" class="toggle-btn" title="実際の天文学通りの傾斜角で表示">
            実角度 (1.0x)
          </button>
          <button type="button" id="btn-inc-boost-15x" class="toggle-btn active" title="傾斜を1.5倍に強調して立体感を際立たせる">
            強調 (1.5x)
          </button>
          <button type="button" id="btn-inc-boost-2x" class="toggle-btn" title="傾斜を2.0倍にダイナミック強調">
            大強調 (2.0x)
          </button>
        </div>
      </div>

      <!-- 6. 軌道線スタイルの凡例 -->
      <div class="drawer-section">
        <span class="drawer-label">軌道線スタイルの凡例</span>
        <div class="drawer-legend-box">
          <div class="legend-row">
            <span class="legend-line solid-line"></span>
            <span>惑星 (8天体: 水星〜海王星)</span>
          </div>
          <div class="legend-row">
            <span class="legend-line dashed-line"></span>
            <span>IAU公認 準惑星 (ケレス・冥王星型4)</span>
          </div>
          <div class="legend-row">
            <span class="legend-line dotted-line"></span>
            <span>準惑星候補・外縁天体 (オルクス・セドナ等4)</span>
          </div>
          <div class="legend-row">
            <span class="legend-line comet-line"></span>
            <span>周期彗星 (正六面体 / ハレー・エンケ等5)</span>
          </div>
          <div class="legend-row">
            <span class="legend-line" style="border-top: 2px dotted #7dd3fc;"></span>
            <span>探査機の周回軌道 (▲ 正四面体) / 静止参照境界 (◌)</span>
          </div>
        </div>
      </div>
    </div>
  </aside>

  <!-- メインSVGビューポート -->
  <main class="viewport-container" id="viewport-container">
    <svg
      id="solar-svg"
      class="solar-svg"
      viewBox="-640 -640 1280 1280"
      preserveAspectRatio="xMidYMid meet"
      role="img"
      aria-label="太陽系軌道早見盤"
    >
      <defs>
        <!-- 太陽コロナの発光フィルター -->
        <filter id="sun-glow" x="-80%" y="-80%" width="260%" height="260%">
          <feGaussianBlur stdDeviation="10" result="blur1" />
          <feGaussianBlur stdDeviation="24" result="blur2" />
          <feMerge>
            <feMergeNode in="blur2" />
            <feMergeNode in="blur1" />
            <feMergeNode in="SourceGraphic" />
          </feMerge>
        </filter>

        <!-- 惑星・準惑星・彗星のソフト発光フィルター -->
        <filter id="planet-glow" x="-50%" y="-50%" width="200%" height="200%">
          <feGaussianBlur stdDeviation="3.2" result="blur" />
          <feMerge>
            <feMergeNode in="blur" />
            <feMergeNode in="SourceGraphic" />
          </feMerge>
        </filter>

        <!-- 惑星の多重環（木星・土星・天王星・海王星等）の発光強調フィルター -->
        <filter id="ring-glow" x="-60%" y="-60%" width="220%" height="220%">
          <feGaussianBlur stdDeviation="1.4" result="ringBlur" />
          <feMerge>
            <feMergeNode in="ringBlur" />
            <feMergeNode in="SourceGraphic" />
          </feMerge>
        </filter>

        <!-- 惑星の環の「球体手前側（y >= 0）」を切り出して立体交差させるクリップパス -->
        <clipPath id="ring-front-clip" clipPathUnits="userSpaceOnUse">
          <rect x="-120" y="0" width="240" height="120" />
        </clipPath>

        <!-- 衛星系拡大専用ビュー（中心惑星 r=52px）用の大サイズ手前側リングクリップパス -->
        <clipPath id="ms-ring-front-clip" clipPathUnits="userSpaceOnUse">
          <rect x="-260" y="0" width="520" height="260" />
        </clipPath>

        <!-- 専用拡大ビューの中心天体・右上90°内部断面カット用クリップパス -->
        <clipPath id="ms-cutaway-clip" clipPathUnits="userSpaceOnUse">
          <rect x="0" y="-120" width="120" height="120" />
        </clipPath>

        <!-- 専用拡大ビューの中心天体球体内の大気流動アニメーション用クリップパス -->
        <clipPath id="ms-sphere-clip" clipPathUnits="userSpaceOnUse">
          <circle id="ms-sphere-clip-circle" cx="0" cy="0" r="52" />
        </clipPath>

        <!-- 全惑星共通：基準半径10pxの円形テクスチャクリップパス -->
        <clipPath id="planet-texture-clip" clipPathUnits="userSpaceOnUse">
          <circle cx="0" cy="0" r="10" />
        </clipPath>

        <!-- 太陽専用：基準半径22pxの光球クリップパス -->
        <clipPath id="sun-texture-clip" clipPathUnits="userSpaceOnUse">
          <circle cx="0" cy="0" r="22" />
        </clipPath>

        <!-- 太陽の多層高解像度グラデーション（中心超白熱プラズマ〜光球〜周辺減光リム） -->
        <radialGradient id="sun-gradient" cx="35%" cy="35%" r="65%">
          <stop offset="0%" stop-color="#ffffff" />
          <stop offset="18%" stop-color="#fffef0" />
          <stop offset="45%" stop-color="#fde047" />
          <stop offset="72%" stop-color="#f59e0b" />
          <stop offset="90%" stop-color="#ea580c" />
          <stop offset="100%" stop-color="#9a3412" />
        </radialGradient>

        <!-- 彗星の尾（テイル）用グラデーション (+X方向へ伸びる尾を回転させて使用) -->
        <linearGradient id="comet-tail-grad" x1="0%" y1="50%" x2="100%" y2="50%">
          <stop offset="0%" stop-color="#67e8f9" stop-opacity="0.88" />
          <stop offset="40%" stop-color="#38bdf8" stop-opacity="0.38" />
          <stop offset="100%" stop-color="#38bdf8" stop-opacity="0" />
        </linearGradient>

        <!-- 各天体の球体グラデーション（8惑星＋冥王星・ケレス実写ベース高精度配色） -->
        {
          PLANETS_DATA.map((planet) =>
            planet.id === 'mercury' ? (
              <radialGradient id="grad-mercury" cx="30%" cy="28%" r="72%">
                <stop offset="0%" stop-color="#f8fafc" stop-opacity="0.9" />
                <stop offset="25%" stop-color="#cbd5e1" />
                <stop offset="62%" stop-color="#64748b" />
                <stop offset="88%" stop-color="#334155" />
                <stop offset="100%" stop-color="#0f172a" />
              </radialGradient>
            ) : planet.id === 'venus' ? (
              <radialGradient id="grad-venus" cx="32%" cy="28%" r="72%">
                <stop offset="0%" stop-color="#fffbeb" stop-opacity="0.95" />
                <stop offset="28%" stop-color="#fef08a" />
                <stop offset="64%" stop-color="#eab308" />
                <stop offset="85%" stop-color="#b45309" />
                <stop offset="100%" stop-color="#451a03" />
              </radialGradient>
            ) : planet.id === 'earth' ? (
              <radialGradient id="grad-earth" cx="30%" cy="26%" r="74%">
                <stop offset="0%" stop-color="#e0f2fe" stop-opacity="0.95" />
                <stop offset="22%" stop-color="#38bdf8" />
                <stop offset="58%" stop-color="#0284c7" />
                <stop offset="85%" stop-color="#1e3a8a" />
                <stop offset="100%" stop-color="#020617" />
              </radialGradient>
            ) : planet.id === 'mars' ? (
              <radialGradient id="grad-mars" cx="32%" cy="28%" r="72%">
                <stop offset="0%" stop-color="#fee2e2" stop-opacity="0.92" />
                <stop offset="26%" stop-color="#f87171" />
                <stop offset="62%" stop-color="#dc2626" />
                <stop offset="86%" stop-color="#991b1b" />
                <stop offset="100%" stop-color="#450a0a" />
              </radialGradient>
            ) : planet.id === 'jupiter' ? (
              <radialGradient id="grad-jupiter" cx="32%" cy="30%" r="70%">
                <stop offset="0%" stop-color="#fffbeb" stop-opacity="0.92" />
                <stop offset="26%" stop-color="#fde047" />
                <stop offset="55%" stop-color="#d97706" />
                <stop offset="84%" stop-color="#92400e" />
                <stop offset="100%" stop-color="#451a03" />
              </radialGradient>
            ) : planet.id === 'saturn' ? (
              <radialGradient id="grad-saturn" cx="32%" cy="30%" r="70%">
                <stop offset="0%" stop-color="#fef9c3" stop-opacity="0.92" />
                <stop offset="28%" stop-color="#fef08a" />
                <stop offset="62%" stop-color="#ca8a04" />
                <stop offset="86%" stop-color="#854d0e" />
                <stop offset="100%" stop-color="#451a03" />
              </radialGradient>
            ) : planet.id === 'uranus' ? (
              <radialGradient id="grad-uranus" cx="30%" cy="28%" r="72%">
                <stop offset="0%" stop-color="#f0fdfa" stop-opacity="0.95" />
                <stop offset="28%" stop-color="#67e8f9" />
                <stop offset="68%" stop-color="#0891b2" />
                <stop offset="88%" stop-color="#0e7490" />
                <stop offset="100%" stop-color="#164e63" />
              </radialGradient>
            ) : planet.id === 'neptune' ? (
              <radialGradient id="grad-neptune" cx="30%" cy="28%" r="72%">
                <stop offset="0%" stop-color="#dbeafe" stop-opacity="0.95" />
                <stop offset="26%" stop-color="#60a5fa" />
                <stop offset="62%" stop-color="#2563eb" />
                <stop offset="86%" stop-color="#1e3a8a" />
                <stop offset="100%" stop-color="#020617" />
              </radialGradient>
            ) : planet.id === 'pluto' ? (
              <radialGradient id="grad-pluto" cx="30%" cy="28%" r="74%">
                <stop offset="0%" stop-color="#faead8" />
                <stop offset="36%" stop-color="#dfb695" />
                <stop offset="72%" stop-color="#a86b47" />
                <stop offset="100%" stop-color="#472014" />
              </radialGradient>
            ) : planet.id === 'ceres' ? (
              <radialGradient id="grad-ceres" cx="58%" cy="60%" r="76%">
                <stop offset="0%" stop-color="#dfd4b4" />
                <stop offset="38%" stop-color="#ada284" />
                <stop offset="74%" stop-color="#625c4b" />
                <stop offset="100%" stop-color="#28251e" />
              </radialGradient>
            ) : (
              <radialGradient id={`grad-${planet.id}`} cx="32%" cy="30%" r="70%">
                <stop offset="0%" stop-color="#ffffff" stop-opacity="0.72" />
                <stop offset="32%" stop-color={planet.color} />
                <stop offset="100%" stop-color={planet.accentColor} />
              </radialGradient>
            )
          )
        }

        <!-- ケレス・オッカトル・クレーターの青白い炭酸ナトリウム塩ドーム発光グラデーション -->
        <radialGradient id="ceres-occator-glow" cx="50%" cy="50%" r="50%">
          <stop offset="0%" stop-color="#ffffff" stop-opacity="1" />
          <stop offset="38%" stop-color="#93c5fd" stop-opacity="0.92" />
          <stop offset="72%" stop-color="#3b82f6" stop-opacity="0.52" />
          <stop offset="100%" stop-color="#1e3a8a" stop-opacity="0" />
        </radialGradient>

        <!-- 冥王星トンボー領域（ハート形の窒素氷河）専用グラデーション -->
        <radialGradient id="pluto-heart-grad" cx="38%" cy="42%" r="65%">
          <stop offset="0%" stop-color="#fffaf3" />
          <stop offset="55%" stop-color="#f8dfc8" />
          <stop offset="100%" stop-color="#e5baa0" />
        </radialGradient>
      </defs>

      <!-- カメラ変換グループ -->
      <g id="camera-rig">
        <!-- 黄経ガイド目盛りサークル -->
        <g id="ecliptic-grid" class="ecliptic-grid">
          <!-- 黄道面（基準面）の半透明ベースディスク（3D傾斜時に基準床面として立体感を強調） -->
          <ellipse id="ecliptic-base-disk" cx="0" cy="0" rx="575" ry="575" class="ecliptic-base-disk" />
          <ellipse id="grid-outer-ring" cx="0" cy="0" rx="575" ry="575" class="grid-ring" />
          {
            Array.from({ length: 12 }).map((_, idx) => {
              const deg = idx * 30;
              return (
                <g class="grid-tick" data-deg={deg}>
                  <line x1="0" y1="0" x2="575" y2="0" class="grid-spoke" />
                  <text x="595" y="4" class="grid-deg-label">
                    {deg}°
                  </text>
                </g>
              );
            })
          }
        </g>

        <!-- 小惑星帯（メインベルト）＆ エッジワース・カイパーベルト（多層半透明粒子レイヤー） -->
        <g id="belts-layer">
          <g id="main-asteroid-belt" class="belt-group main-belt">
            <ellipse id="main-belt-halo" cx="0" cy="0" rx="435" ry="435" class="belt-band main-belt-halo" />
            <ellipse id="main-belt-band" cx="0" cy="0" rx="435" ry="435" class="belt-band main-belt-band" />
            {
              mainBeltParticles.map((pt) => (
                <circle
                  class={`belt-particle main-particle tier-${pt.tier}`}
                  data-angle={pt.angle}
                  data-offset={pt.radiusOffset}
                  data-ecc={pt.eccOffset}
                  data-period={pt.periodDays}
                  data-vspeed={pt.visualSpeed}
                  data-opacity={pt.baseOpacity}
                  data-shimmer={pt.shimmerSpeed}
                  data-phase={pt.phase}
                  r={pt.size}
                  fill={pt.color}
                  fill-opacity={pt.baseOpacity}
                />
              ))
            }
          </g>

          <g id="kuiper-belt" class="belt-group kuiper-belt">
            <ellipse id="kuiper-belt-halo" cx="0" cy="0" rx="345" ry="345" class="belt-band kuiper-belt-halo" />
            <ellipse id="kuiper-belt-band" cx="0" cy="0" rx="345" ry="345" class="belt-band kuiper-belt-band" />
            {
              kuiperBeltParticles.map((pt) => (
                <circle
                  class={`belt-particle kuiper-particle tier-${pt.tier}`}
                  data-angle={pt.angle}
                  data-offset={pt.radiusOffset}
                  data-ecc={pt.eccOffset}
                  data-period={pt.periodDays}
                  data-vspeed={pt.visualSpeed}
                  data-opacity={pt.baseOpacity}
                  data-shimmer={pt.shimmerSpeed}
                  data-phase={pt.phase}
                  r={pt.size}
                  fill={pt.color}
                  fill-opacity={pt.baseOpacity}
                />
              ))
            }
          </g>
        </g>

        <!-- 惑星・準惑星・準惑星候補・彗星のケプラー楕円軌道線レイヤー -->
        <g id="orbits-layer">
          {
            PLANETS_DATA.map((planet) => (
              <path
                id={`orbit-${planet.id}`}
                class:list={['planet-orbit', `orbit-style-${planet.orbitStyle}`]}
                data-planet-id={planet.id}
                data-home-zone={planet.homeZone}
                data-body-class={planet.bodyClass}
                data-sub-group={planet.subGroup}
                stroke={planet.orbitColor}
              />
            ))
          }
        </g>

        <!-- 3D軌道傾斜・高度ポール・黄道面フットプリント・交点線レイヤー -->
        <g id="inclination-guides-layer" class="inclination-guides-layer" pointer-events="none">
          <!-- 選択天体の黄道面交点線 (Line of Nodes: 昇交点☊ と 降交点☋ を結ぶ軸) -->
          <g id="sel-nodes-axis-group" class="sel-nodes-axis-group" style="display: none;">
            <line id="sel-nodes-axis-line" class="nodes-axis-line" x1="0" y1="0" x2="0" y2="0" />
            <g id="sel-node-asc-marker" class="node-marker asc-node">
              <circle cx="0" cy="0" r="5" class="node-marker-bg" />
              <text x="0" y="3.5" class="node-symbol">☊</text>
              <text x="9" y="3.5" class="node-label">昇交点</text>
            </g>
            <g id="sel-node-desc-marker" class="node-marker desc-node">
              <circle cx="0" cy="0" r="5" class="node-marker-bg" />
              <text x="0" y="3.5" class="node-symbol">☋</text>
              <text x="9" y="3.5" class="node-label">降交点</text>
            </g>
          </g>

          <!-- 各天体の高度ドロップライン（黄道面への垂直ステム線）と足元フットプリント -->
          {
            PLANETS_DATA.map((planet) => (
              <g id={`inc-guide-${planet.id}`} class="planet-inc-guide" data-planet-id={planet.id}>
                <!-- 黄道面上のフットプリント影・ドット -->
                <ellipse id={`inc-footprint-${planet.id}`} class="inc-footprint" cx="0" cy="0" rx="3.5" ry="1.8" />
                <!-- 天体から黄道面へ下ろす垂直ステム線 (高度ドロップライン) -->
                <line id={`inc-stem-${planet.id}`} class="inc-stem" x1="0" y1="0" x2="0" y2="0" />
              </g>
            ))
          }

          <!-- 選択天体の高度・傾斜情報バッジ -->
          <g id="sel-elevation-badge-group" class="sel-elevation-badge-group" style="display: none;">
            <rect id="sel-elevation-badge-bg" class="elevation-badge-bg" rx="4" ry="4" x="0" y="0" width="130" height="22" />
            <text id="sel-elevation-badge-text" class="elevation-badge-text" x="65" y="14.5">Z: +0.00 AU | 傾斜 0.0°</text>
          </g>
        </g>

        <!-- 天体（太陽＋8惑星＋5準惑星＋4準惑星候補＋5周期彗星＋各衛星）レイヤー -->
        <g id="bodies-layer">
          <!-- 中心の太陽 -->
          <g id="node-sun" class="celestial-node sun-node" data-body-id="sun" tabindex="0" role="button" aria-label="太陽">
            <!-- 太陽コロナ外部光芒（放射状8方向フレア光条） -->
            <g id="sun-corona-rays" class="sun-corona-rays" pointer-events="none">
              {Array.from({ length: 8 }).map((_, i) => {
                const angle = i * 45;
                return (
                  <polygon
                    points="-1.2,0 0,-34 1.2,0"
                    fill="#f59e0b"
                    fill-opacity="0.32"
                    transform={`rotate(${angle})`}
                  />
                );
              })}
            </g>
            <circle
              id="sun-corona-outer"
              cx="0"
              cy="0"
              r={SUN_DATA.sizeByZonePx.inner * 1.6}
              fill="rgba(251, 191, 36, 0.16)"
              class="sun-corona-outer"
            />
            <circle
              id="sun-corona-inner"
              cx="0"
              cy="0"
              r={SUN_DATA.sizeByZonePx.inner * 1.24}
              fill="rgba(251, 191, 36, 0.28)"
              class="sun-corona-inner"
            />
            <circle
              id="sun-sphere"
              cx="0"
              cy="0"
              r={SUN_DATA.sizeByZonePx.inner}
              fill="url(#sun-gradient)"
              filter="url(#sun-glow)"
            />
            <!-- 太陽光球表面の高精細テクスチャ（粒状斑・黒点群・白斑・周辺減光リム） -->
            <g id="sun-surface-texture" class="sun-mini-texture" clip-path="url(#sun-texture-clip)" pointer-events="none" transform={`scale(${(SUN_DATA.sizeByZonePx.inner / 22).toFixed(3)})`}>
              <!-- 対流粒状斑の微細な明暗パターン -->
              <circle cx="-6.5" cy="-8.5" r="5.2" fill="rgba(254, 240, 138, 0.28)" />
              <circle cx="8.5" cy="-5.2" r="5.8" fill="rgba(254, 240, 138, 0.24)" />
              <circle cx="-8.2" cy="7.5" r="5.4" fill="rgba(254, 240, 138, 0.26)" />
              <circle cx="6.8" cy="8.5" r="6.0" fill="rgba(254, 240, 138, 0.25)" />
              <circle cx="0" cy="0" r="7.0" fill="rgba(255, 255, 240, 0.35)" />
              <!-- 巨大黒点群（本影＋半影＋白斑） -->
              <ellipse cx="-5.2" cy="-3.8" rx="3.0" ry="2.2" fill="#7c2d12" fill-opacity="0.88" />
              <ellipse cx="-5.2" cy="-3.8" rx="1.8" ry="1.2" fill="#451a03" />
              <circle cx="-5.2" cy="-3.8" r="0.75" fill="#1c0a02" />
              <!-- 周囲の白斑（Faculae） -->
              <ellipse cx="-5.2" cy="-3.8" rx="4.5" ry="3.2" fill="none" stroke="#fef08a" stroke-width="0.7" stroke-opacity="0.85" />
              <!-- 第2黒点群 -->
              <circle cx="7.2" cy="3.5" r="1.6" fill="#7c2d12" fill-opacity="0.85" />
              <circle cx="7.2" cy="3.5" r="0.9" fill="#451a03" />
              <circle cx="9.2" cy="4.8" r="1.0" fill="#7c2d12" fill-opacity="0.8" />
              <!-- 周辺減光（Limb Darkening：縁が暗く赤みを帯びる物理現象） -->
              <circle cx="0" cy="0" r="21.2" fill="none" stroke="#ea580c" stroke-width="2.4" stroke-opacity="0.55" />
              <circle cx="0" cy="0" r="21.8" fill="none" stroke="#9a3412" stroke-width="1.3" stroke-opacity="0.75" />
            </g>
            <text id="sun-label" y={SUN_DATA.sizeByZonePx.inner + 15} class="body-label sun-label major-label">太陽</text>
          </g>

          <!-- 全27天体とそれぞれの衛星 -->
          {
            PLANETS_DATA.map((planet) => (
              <g
                id={`node-${planet.id}`}
                class:list={[
                  'celestial-node',
                  'planet-node',
                  { 'dwarf-node': planet.bodyClass === 'dwarf_planet' },
                  { 'candidate-node': planet.bodyClass === 'dwarf_candidate' },
                  { 'comet-node': planet.bodyClass === 'comet' },
                ]}
                data-body-id={planet.id}
                data-home-zone={planet.homeZone}
                data-body-class={planet.bodyClass}
                data-sub-group={planet.subGroup}
                tabindex="0"
                role="button"
                aria-label={`${planet.nameJa} (${planet.nameEn}) - ${planet.category}`}
              >
                <!-- 彗星の場合：反太陽方向へ伸びる彗星の尾（Comet Tail）とコマ -->
                {planet.bodyClass === 'comet' && (
                  <g id={`comet-tail-${planet.id}`} class="comet-tail-group">
                    <path
                      id={`comet-tail-path-${planet.id}`}
                      d="M 0,-3.2 L 38,0 L 0,3.2 Z"
                      fill="url(#comet-tail-grad)"
                      class="comet-tail-cone"
                    />
                    <circle
                      cx="0"
                      cy="0"
                      r={planet.scaleConfig.bodySizePx.inner * 1.8}
                      fill="rgba(103, 232, 249, 0.24)"
                      class="comet-coma"
                    />
                  </g>
                )}

                <!-- 天体の衛星システム -->
                <g id={`moons-group-${planet.id}`} class="moons-group">
                  {planet.moons.map((moon) => (
                    <g class="moon-system" data-moon-id={moon.id}>
                      <ellipse
                        id={`moon-orbit-${moon.id}`}
                        class="moon-orbit"
                        cx="0"
                        cy="0"
                        rx={moon.orbitRadiusPx}
                        ry={moon.orbitRadiusPx}
                      />
                      <g id={`moon-node-${moon.id}`} class="moon-node" data-moon-id={moon.id} data-parent-id={planet.id}>
                        <circle
                          id={`moon-sphere-${moon.id}`}
                          cx="0"
                          cy="0"
                          r={moon.sizePx}
                          fill={moon.color}
                          class="moon-sphere"
                        />
                        <text id={`moon-label-${moon.id}`} y={-moon.sizePx - 4} class="moon-label">
                          {moon.nameJa}
                        </text>
                      </g>
                    </g>
                  ))}
                </g>

                <!-- 選択リング -->
                <circle
                  id={`sel-ring-${planet.id}`}
                  cx="0"
                  cy="0"
                  r={planet.scaleConfig.bodySizePx.inner + 6}
                  class="selection-ring"
                  stroke={planet.color}
                />

                <!-- 木星・土星・天王星・海王星・ハウメア・クワオアーの多重環（球体背面の奥側ハーフ） -->
                {planet.hasRings && planet.ringSystem && (
                  <g
                    id={`ring-back-${planet.id}`}
                    class="planet-ring-group ring-back-group"
                    transform={`rotate(${planet.ringSystem.tiltDeg})`}
                    filter="url(#ring-glow)"
                  >
                    {planet.ringSystem.bands.map((band, bIdx) => (
                      <ellipse
                        id={`ring-back-band-${planet.id}-${bIdx}`}
                        cx="0"
                        cy="0"
                        rx={planet.scaleConfig.bodySizePx.outer * band.radiusMultiplier}
                        ry={
                          planet.scaleConfig.bodySizePx.outer *
                          band.radiusMultiplier *
                          planet.ringSystem!.aspectRatio
                        }
                        fill="none"
                        stroke={band.color}
                        stroke-width={band.strokeWidthPx}
                        stroke-opacity={band.opacity * 0.82}
                        stroke-dasharray={band.dashArray}
                        class="planet-ring-band"
                      />
                    ))}
                  </g>
                )}

                <!-- クリック・タップ判定ヒットエリア -->
                <circle
                  id={`hit-${planet.id}`}
                  cx="0"
                  cy="0"
                  r="16"
                  fill="transparent"
                  class="hit-area"
                />

                <!-- 天体本体 -->
                {planet.bodyClass === 'comet' ? (
                  /* 彗星核：正六面体（等角投影の立方体）。外接円の半径1の単位図形を JS 側で bodySizePx 倍に拡大する */
                  <g id={`sphere-${planet.id}`} class="planet-sphere comet-cube" transform={`scale(${planet.scaleConfig.bodySizePx.inner})`}>
                    <polygon points="0,-1 0.866,-0.5 0,0 -0.866,-0.5" fill={cometCubeFaceColors(planet.color).top} class="comet-cube-face" />
                    <polygon points="-0.866,-0.5 0,0 0,1 -0.866,0.5" fill={cometCubeFaceColors(planet.color).left} class="comet-cube-face" />
                    <polygon points="0,0 0.866,-0.5 0.866,0.5 0,1" fill={cometCubeFaceColors(planet.color).right} class="comet-cube-face" />
                  </g>
                ) : planet.id === 'haumea' ? (
                  <ellipse
                    id={`sphere-${planet.id}`}
                    cx="0"
                    cy="0"
                    rx={planet.scaleConfig.bodySizePx.tno * 1.32}
                    ry={planet.scaleConfig.bodySizePx.tno * 0.82}
                    fill={`url(#grad-${planet.id})`}
                    transform="rotate(-25)"
                    class="planet-sphere"
                  />
                ) : (
                  <circle
                    id={`sphere-${planet.id}`}
                    cx="0"
                    cy="0"
                    r={planet.scaleConfig.bodySizePx.inner}
                    fill={`url(#grad-${planet.id})`}
                    class="planet-sphere"
                  />
                )}

                {/* 太陽系8惑星の高解像度ミニチュア表面テクスチャ（実写写真・探査機観測に基づく地形・気候・大気模様） */}
                {planet.id === 'mercury' && (
                  <g id={`planet-texture-${planet.id}`} class="planet-mini-texture" clip-path="url(#planet-texture-clip)" pointer-events="none" transform={`scale(${(planet.scaleConfig.bodySizePx.inner / 10).toFixed(3)})`}>
                    <!-- カロリス盆地（巨大同心円衝突痕） -->
                    <ellipse cx="-3.2" cy="-2.4" rx="4.2" ry="3.8" fill="rgba(30, 41, 59, 0.45)" />
                    <ellipse cx="-3.2" cy="-2.4" rx="2.8" ry="2.4" fill="rgba(15, 23, 42, 0.62)" />
                    <circle cx="-3.2" cy="-2.4" r="1.1" fill="rgba(241, 245, 249, 0.55)" />
                    <!-- クレーター群と光条（コイパー・クレーター等） -->
                    <circle cx="2.8" cy="3.2" r="1.6" fill="rgba(15, 23, 42, 0.55)" />
                    <circle cx="2.8" cy="3.2" r="0.8" fill="#f8fafc" />
                    <line x1="2.8" y1="3.2" x2="6.2" y2="5.5" stroke="#f8fafc" stroke-width="0.35" stroke-opacity="0.65" />
                    <line x1="2.8" y1="3.2" x2="0.8" y2="6.2" stroke="#f8fafc" stroke-width="0.35" stroke-opacity="0.65" />
                    <circle cx="4.2" cy="-3.6" r="1.3" fill="rgba(30, 41, 59, 0.5)" />
                    <circle cx="-2.2" cy="4.5" r="1.4" fill="rgba(30, 41, 59, 0.45)" />
                    <!-- 険しい高地・リンクルリッジの陰影 -->
                    <path d="M -7,2 Q -4,5 1,7" fill="none" stroke="rgba(15, 23, 42, 0.4)" stroke-width="0.6" />
                  </g>
                )}

                {planet.id === 'venus' && (
                  <g id={`planet-texture-${planet.id}`} class="planet-mini-texture" clip-path="url(#planet-texture-clip)" pointer-events="none" transform={`scale(${(planet.scaleConfig.bodySizePx.inner / 10).toFixed(3)})`}>
                    <!-- スーパーローテーションV字雲（Chevron Patterns） -->
                    <path d="M -8,-6 Q -1,-4 7,-8" fill="none" stroke="rgba(254, 249, 195, 0.65)" stroke-width="1.2" stroke-linecap="round" />
                    <path d="M -9,-1 Q -2,0 8,-2" fill="none" stroke="rgba(254, 249, 195, 0.75)" stroke-width="1.6" stroke-linecap="round" />
                    <path d="M -8,4 Q -1,3 7,2" fill="none" stroke="rgba(254, 249, 195, 0.6)" stroke-width="1.3" stroke-linecap="round" />
                    <path d="M -7,8 Q -1,7 6,7" fill="none" stroke="rgba(254, 249, 195, 0.5)" stroke-width="1.0" stroke-linecap="round" />
                    <!-- 紫外線吸収帯の黄褐色濃淡ストリーム -->
                    <path d="M -10,-3.5 Q -3,-2.5 9,-4.5" fill="none" stroke="rgba(146, 64, 14, 0.35)" stroke-width="1.5" />
                    <path d="M -9,1.8 Q -2,2.8 8,0.5" fill="none" stroke="rgba(146, 64, 14, 0.32)" stroke-width="1.4" />
                    <!-- 極渦 -->
                    <ellipse cx="-0.5" cy="-8.5" rx="3.5" ry="1.2" fill="rgba(180, 83, 9, 0.28)" />
                    <ellipse cx="0.5" cy="8.5" rx="3.5" ry="1.2" fill="rgba(180, 83, 9, 0.28)" />
                    <!-- 厚密大気リムグロー -->
                    <circle cx="0" cy="0" r="9.5" fill="none" stroke="rgba(254, 240, 138, 0.45)" stroke-width="0.8" />
                  </g>
                )}

                {planet.id === 'earth' && (
                  <g id={`planet-texture-${planet.id}`} class="planet-mini-texture" clip-path="url(#planet-texture-clip)" pointer-events="none" transform={`scale(${(planet.scaleConfig.bodySizePx.inner / 10).toFixed(3)})`}>
                    <!-- ユーラシア・アジア大陸・日本列島 -->
                    <path d="M -4.5,-7 C -2.5,-8 2,-7.5 4,-6 C 5.5,-4.5 4.5,-2 2,-2.5 C 0.5,-3 -2,-1.5 -3.5,-2.5 C -4.5,-3.5 -5.5,-5 -4.5,-7 Z" fill="#166534" fill-opacity="0.88" />
                    <path d="M 4.5,-3.5 Q 5.5,-2 4.8,-0.5" fill="none" stroke="#22c55e" stroke-width="0.55" stroke-linecap="round" />
                    <!-- アフリカ大陸とサハラ砂漠 -->
                    <path d="M -5.5,-2 C -3.5,-2.5 -2.5,-1 -3,1.5 C -3.5,3.5 -4.5,5.5 -5.5,5 C -6.5,4.5 -7,0 -5.5,-2 Z" fill="#15803d" fill-opacity="0.85" />
