    </div>

    <!-- 左上フローティング：現在の早見日時＆3段階縮尺ステータス表示（開閉アコーディオン対応） -->
    <div id="hud-date-badge" class="hud-date-badge" role="region" aria-label="シミュレーションステータスHUD">
      <div class="hud-date-row">
