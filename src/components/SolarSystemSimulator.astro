                    <ellipse cx="3.8" cy="3.5" rx="1.8" ry="1.4" fill="#15803d" fill-opacity="0.82" />
                    <!-- 南北アメリカ大陸（背面〜端） -->
                    <path d="M -8.5,-5 C -7.5,-4 -7,-2 -7.8,-0.5 C -8.2,1 -8.8,3 -9.2,2 C -9.5,0.5 -9.2,-3 -8.5,-5 Z" fill="#166534" fill-opacity="0.7" />
                    <!-- 北極海氷 ＆ 南極氷床 -->
                    <ellipse cx="0" cy="-9.2" rx="4.8" ry="1.6" fill="#ffffff" fill-opacity="0.95" />
                    <ellipse cx="0" cy="9.2" rx="5.2" ry="1.8" fill="#ffffff" fill-opacity="0.95" />
                    <!-- 白い台風渦と雲バンド -->
                    <path d="M -6,-3.5 Q -1,-4.5 5,-3.2 Q 2,-2 -2,-2.5 Z" fill="#ffffff" fill-opacity="0.7" />
                    <path d="M -3,2.5 Q 1,2 6,3.5 Q 2,4.2 -1,3.2 Z" fill="#ffffff" fill-opacity="0.65" />
                    <path d="M 1,-1 C 2.5,-1.8 3,-0.5 2.2,0.2 C 1.5,0.8 0.5,0.2 1,-1 Z" fill="#ffffff" fill-opacity="0.85" />
                    <!-- 大気散乱リムライト（美しい青い大気光） -->
                    <circle cx="0" cy="0" r="9.6" fill="none" stroke="#38bdf8" stroke-width="0.85" stroke-opacity="0.75" />
                  </g>
                )}

                {planet.id === 'mars' && (
                  <g id={`planet-texture-${planet.id}`} class="planet-mini-texture" clip-path="url(#planet-texture-clip)" pointer-events="none" transform={`scale(${(planet.scaleConfig.bodySizePx.inner / 10).toFixed(3)})`}>
                    <!-- 北極冠（純白の氷） -->
                    <ellipse cx="0" cy="-8.8" rx="3.6" ry="1.3" fill="#ffffff" fill-opacity="0.95" />
                    <!-- 南極冠（小さな氷点） -->
                    <ellipse cx="0.5" cy="9.0" rx="2.0" ry="0.9" fill="#ffffff" fill-opacity="0.9" />
                    <!-- 大シルティス平原（濃い玄武岩三角地形） -->
                    <path d="M -1,-1.5 L 2.5,-4 L 3,0.5 Z" fill="#451a03" fill-opacity="0.75" />
                    <!-- アキダリア平原（北部の広大な暗色平原） -->
                    <ellipse cx="-2.5" cy="-5.2" rx="4.5" ry="1.8" fill="#3f1a07" fill-opacity="0.68" />
                    <!-- 南部暗色高地バンド -->
                    <path d="M -8,2.5 C -4,1.5 1,4 7,2 C 4,5 -2,4.5 -8,2.5 Z" fill="#3f1a07" fill-opacity="0.65" />
                    <!-- マリネリス峡谷（赤道付近の長大な亀裂ライン） -->
                    <path d="M -5,0.8 Q -1,0.2 3.5,0.5" fill="none" stroke="#260b02" stroke-width="0.75" stroke-linecap="round" />
                    <!-- オリンポス山 -->
                    <circle cx="-5.5" cy="-2.5" r="1.2" fill="#78350f" fill-opacity="0.7" />
                    <circle cx="-5.5" cy="-2.5" r="0.45" fill="#fca5a5" />
                  </g>
                )}

                {planet.id === 'jupiter' && (
                  <g id={`planet-texture-${planet.id}`} class="planet-mini-texture" clip-path="url(#planet-texture-clip)" pointer-events="none" transform={`scale(${(planet.scaleConfig.bodySizePx.inner / 10).toFixed(3)})`}>
                    <!-- 北極冠・南極冠の暗青灰ゾーン -->
                    <ellipse cx="0" cy="-8.8" rx="8.5" ry="1.8" fill="rgba(88, 47, 7, 0.45)" />
                    <ellipse cx="0" cy="8.8" rx="8.5" ry="1.8" fill="rgba(88, 47, 7, 0.45)" />
                    <!-- 北温帯縞（NTB） -->
                    <rect x="-10" y="-6.2" width="20" height="1.4" fill="#92400e" fill-opacity="0.75" />
                    <!-- 北赤道縞（NEB：濃く太い赤褐色縞） -->
                    <rect x="-10" y="-3.6" width="20" height="2.2" fill="#78350f" fill-opacity="0.9" />
                    <!-- 赤道帯（EZ：クリーム色の明るい帯とフェストゥーン波） -->
                    <rect x="-10" y="-1.2" width="20" height="1.8" fill="#fef3c7" fill-opacity="0.65" />
                    <path d="M -9,-1.2 Q -7,-0.2 -5,-1.2 Q -3,-0.2 -1,-1.2 Q 1,-0.2 3,-1.2 Q 5,-0.2 7,-1.2 Q 9,-0.2 10,-1.2" fill="none" stroke="#0284c7" stroke-width="0.45" stroke-opacity="0.55" />
                    <!-- 南赤道縞（SEB：太い赤褐色縞と大赤斑のくぼみ） -->
                    <rect x="-10" y="0.8" width="20" height="2.4" fill="#78350f" fill-opacity="0.88" />
                    <!-- 大赤斑（Great Red Spot / GRS）：南半球の巨大な朱色の嵐 -->
                    <ellipse cx="2.8" cy="2.5" rx="2.6" ry="1.7" fill="#b91c1c" />
                    <ellipse cx="2.8" cy="2.5" rx="1.8" ry="1.0" fill="#dc2626" />
                    <ellipse cx="2.8" cy="2.5" rx="0.9" ry="0.5" fill="#fef08a" fill-opacity="0.75" />
                    <!-- 南温帯縞（STB） ＆ 白斑（Oval BA） -->
                    <rect x="-10" y="4.2" width="20" height="1.3" fill="#92400e" fill-opacity="0.72" />
                    <circle cx="-3.5" cy="4.8" r="0.75" fill="#ffffff" fill-opacity="0.9" />
                    <circle cx="-6.2" cy="4.8" r="0.6" fill="#ffffff" fill-opacity="0.85" />
                  </g>
                )}

                {planet.id === 'saturn' && (
                  <g id={`planet-texture-${planet.id}`} class="planet-mini-texture" clip-path="url(#planet-texture-clip)" pointer-events="none" transform={`scale(${(planet.scaleConfig.bodySizePx.inner / 10).toFixed(3)})`}>
                    <!-- 北極の六角形（ヘキサゴン）模様 -->
                    <polygon points="0,-8.8 1.4,-8.2 1.4,-7.2 0,-6.6 -1.4,-7.2 -1.4,-8.2" fill="rgba(163, 230, 53, 0.45)" stroke="rgba(202, 138, 4, 0.7)" stroke-width="0.3" />
                    <!-- 繊細な多層黄金色平行気流バンド -->
                    <rect x="-10" y="-5.5" width="20" height="1.1" fill="#a16207" fill-opacity="0.45" />
                    <rect x="-10" y="-3.2" width="20" height="1.3" fill="#ca8a04" fill-opacity="0.5" />
                    <!-- 赤道ジェット気流の明るい黄金バンド -->
                    <rect x="-10" y="-0.8" width="20" height="1.8" fill="#fef08a" fill-opacity="0.6" />
                    <rect x="-10" y="1.8" width="20" height="1.3" fill="#a16207" fill-opacity="0.45" />
                    <rect x="-10" y="4.2" width="20" height="1.1" fill="#854d0e" fill-opacity="0.4" />
                    <!-- 南極域 -->
                    <ellipse cx="0" cy="8.6" rx="6.5" ry="1.6" fill="rgba(113, 63, 18, 0.35)" />
                  </g>
                )}

                {planet.id === 'uranus' && (
                  <g id={`planet-texture-${planet.id}`} class="planet-mini-texture" clip-path="url(#planet-texture-clip)" pointer-events="none" transform={`scale(${(planet.scaleConfig.bodySizePx.inner / 10).toFixed(3)})`}>
                    <!-- 98度横倒し自転軸を反映した極フード（明るい極冠の輝き） -->
                    <ellipse cx="-4.5" cy="0" rx="3.5" ry="8.5" fill="rgba(236, 254, 255, 0.5)" />
                    <!-- 横倒し軸に沿ったメタン雲バンド -->
                    <path d="M -1,-9.5 L -1,9.5" stroke="rgba(8, 145, 178, 0.35)" stroke-width="1.2" />
                    <path d="M 2.5,-9.2 L 2.5,9.2" stroke="rgba(207, 250, 254, 0.45)" stroke-width="1.4" />
                    <path d="M 5.8,-8.2 L 5.8,8.2" stroke="rgba(22, 78, 99, 0.3)" stroke-width="1.1" />
                    <!-- 上層メタン氷の白光リム -->
                    <circle cx="0" cy="0" r="9.6" fill="none" stroke="rgba(207, 250, 254, 0.65)" stroke-width="0.75" />
                  </g>
                )}

                {planet.id === 'neptune' && (
                  <g id={`planet-texture-${planet.id}`} class="planet-mini-texture" clip-path="url(#planet-texture-clip)" pointer-events="none" transform={`scale(${(planet.scaleConfig.bodySizePx.inner / 10).toFixed(3)})`}>
                    <!-- 大暗斑（Great Dark Spot：南半球の巨大濃紺嵐） -->
                    <ellipse cx="-2.6" cy="1.6" rx="2.5" ry="1.6" fill="#020617" fill-opacity="0.82" />
                    <ellipse cx="-2.6" cy="1.6" rx="1.6" ry="0.9" fill="#172554" fill-opacity="0.95" />
                    <!-- スクーター雲（Scooter：大暗斑を伴走する純白メタン氷巻雲） -->
                    <ellipse cx="-0.2" cy="1.1" rx="1.2" ry="0.6" fill="#ffffff" fill-opacity="0.95" />
                    <circle cx="0.8" cy="1.4" r="0.45" fill="#ffffff" />
                    <!-- 超音速メタン風の高速白巻雲バンド -->
                    <path d="M -9.5,-3 Q 0,-3.8 9.5,-3" fill="none" stroke="rgba(255, 255, 255, 0.72)" stroke-width="0.8" stroke-dasharray="3.5 2" />
                    <path d="M -9,4.2 Q 0,4.8 9,4.2" fill="none" stroke="rgba(255, 255, 255, 0.65)" stroke-width="0.7" stroke-dasharray="2.5 1.5" />
                    <!-- 南極域の白雲 -->
                    <ellipse cx="0" cy="8.4" rx="4.5" ry="1.2" fill="rgba(255, 255, 255, 0.55)" />
                    <!-- 深層大気リム -->
                    <circle cx="0" cy="0" r="9.6" fill="none" stroke="rgba(147, 197, 253, 0.55)" stroke-width="0.8" />
                  </g>
                )}

                {/* ケレス（ceres）の全体ビュー用ミニチュア地表テクスチャ（青紫イジェクタ平原＋オッカトル・クレーターの青白い塩ドーム輝点） */}
                {planet.id === 'ceres' && (
                  <g id="ceres-mini-texture" class="ceres-mini-texture" pointer-events="none">
                    <ellipse cx="-0.6" cy="0.6" rx="2.8" ry="2.4" fill="rgba(129, 140, 248, 0.36)" />
                    <circle cx="-0.9" cy="-0.4" r="1.45" fill="#1e3a8a" fill-opacity="0.78" />
                    <circle cx="-0.9" cy="-0.4" r="0.85" fill="#93c5fd" />
                    <circle cx="-0.9" cy="-0.4" r="0.45" fill="#ffffff" />
                  </g>
                )}

                {/* 冥王星（pluto）の全体ビュー用ミニチュア地表テクスチャ（暗赤褐色のクトゥルフ領域＋右下の白いハート地形トンボー領域） */}
                {planet.id === 'pluto' && (
                  <g id="pluto-mini-texture" class="pluto-mini-texture" pointer-events="none">
                    <path
                      d="M -5.8,0.4 C -4.2,-0.2 -2.2,0.8 -0.8,2.6 C -0.2,3.8 -1.4,5.4 -3.2,5.6 C -4.8,5.2 -5.9,3.1 -5.8,0.4 Z"
                      fill="#3d1910"
                      fill-opacity="0.82"
                    />
                    <path
                      d="M 1.2,-0.5 C 0.3,-2.3 -2.2,-1.9 -2.1,0.4 C -2.0,2.5 -0.3,4.2 1.3,5.2 C 2.9,4.0 4.6,2.1 4.4,0.2 C 4.2,-1.5 2.1,-1.6 1.2,-0.5 Z"
                      fill="url(#pluto-heart-grad)"
                      fill-opacity="0.94"
                      transform="rotate(-12)"
                    />
                  </g>
                )}

                <!-- 木星・土星・天王星・海王星・ハウメア・クワオアーの多重環（球体手前を横切る前面ハーフ） -->
                {planet.hasRings && planet.ringSystem && (
                  <g
                    id={`ring-front-${planet.id}`}
                    class="planet-ring-group ring-front-group"
                    transform={`rotate(${planet.ringSystem.tiltDeg})`}
                    clip-path="url(#ring-front-clip)"
                    filter="url(#ring-glow)"
                  >
                    {planet.ringSystem.bands.map((band, bIdx) => (
                      <ellipse
                        id={`ring-front-band-${planet.id}-${bIdx}`}
                        cx="0"
                        cy="0"
                        rx={planet.scaleConfig.bodySizePx.outer * band.radiusMultiplier}
                        ry={
                          planet.scaleConfig.bodySizePx.outer *
                          band.radiusMultiplier *
                          planet.ringSystem!.aspectRatio
                        }
                        fill="none"
                        stroke={band.color}
                        stroke-width={band.strokeWidthPx}
                        stroke-opacity={band.opacity}
                        stroke-dasharray={band.dashArray}
                        class="planet-ring-band"
                      />
                    ))}
                  </g>
                )}

                <!-- 天体名ラベル -->
                <g id={`label-group-${planet.id}`} class="planet-label-group" transform="translate(0, 18)">
                  <text
                    class:list={[
                      'body-label',
                      'planet-label',
                      { 'dwarf-label': planet.bodyClass === 'dwarf_planet' },
                      { 'candidate-label': planet.bodyClass === 'dwarf_candidate' },
                      { 'comet-label': planet.bodyClass === 'comet' },
                      { 'major-label': planet.bodyClass === 'planet' },
                    ]}
                  >
                    {planet.symbol} {planet.nameJa}
                  </text>
                </g>
              </g>
            ))
          }
        </g>

        <!-- 惑星と衛星の軌道を拡大表示する専用ビューステージ（対象10天体：地球・火星・木星・土星・天王星・海王星・冥王星・ハウメア・マケマケ・エリス） -->
        <g id="moon-system-stage" class="moon-system-stage" style="display: none;">
          <g id="ms-grid-group" class="ms-grid-group"></g>
          <g id="ms-orbits-group" class="ms-orbits-group"></g>
          <g id="ms-central-planet-group" class="ms-central-planet-group"></g>
          <g id="ms-moons-nodes-group" class="ms-moons-nodes-group"></g>
