    // 9. ズームボタン・マウスホイール・マルチタッチ（ピンチズーム＆スワイプパン）操作
    // ホイール連続操作時は「進行中のトゥイーンの目標値」を基準に倍率を計算する（途中値を基準にすると操作量が不安定になるため）
    let zoomGoal = simState.cameraZoom;
    let zoomGoalSetAt = 0;
    function zoomBy(factor: number, duration: number) {
      const now = performance.now();
      const base = now - zoomGoalSetAt < 450 ? zoomGoal : simState.cameraZoom;
      zoomGoal = clampZoom(base * factor);
      zoomGoalSetAt = now;
      gsap.to(simState, {
        cameraZoom: zoomGoal,
        duration,
        ease: 'power2.out',
        overwrite: 'auto',
      });
    }

    document.getElementById('btn-zoom-in')?.addEventListener('click', () => {
      zoomBy(1.35, 0.4);
    });
    document.getElementById('btn-zoom-out')?.addEventListener('click', () => {
      zoomBy(1 / 1.35, 0.4);
    });

    const viewportEl = document.getElementById('viewport-container');
    viewportEl?.addEventListener(
      'wheel',
      (e) => {
        e.preventDefault();
        zoomBy(e.deltaY < 0 ? 1.14 : 0.88, 0.25);
      },
      { passive: false }
    );

    // マルチポインタ（1本指パン ＆ 2本指ピンチズーム）管理
    const activePointers = new Map<number, { x: number; y: number }>();
    let isDragging = false;
    let dragStartX = 0;
    let dragStartY = 0;
    let cameraStartX = 0;
    let cameraStartY = 0;
    let initialPinchDist = 0;
    let initialPinchZoom = 1.0;

    function getPinchDistance(): number {
      const pts = Array.from(activePointers.values());
      if (pts.length < 2) return 0;
      return Math.hypot(pts[0].x - pts[1].x, pts[0].y - pts[1].y);
    }

    svgEl?.addEventListener('pointerdown', (e) => {
      const target = e.target as Element;
      if (target.closest('.celestial-node, .ms-moon-node')) return;

      activePointers.set(e.pointerId, { x: e.clientX, y: e.clientY });
      svgEl.setPointerCapture(e.pointerId);
      // ユーザー操作を優先し、進行中のカメラ移動・ズームのトゥイーンを止める
      gsap.killTweensOf(simState, 'cameraX,cameraY,cameraZoom');

      if (activePointers.size === 1) {
        isDragging = true;
        dragStartX = e.clientX;
        dragStartY = e.clientY;
        cameraStartX = simState.cameraX;
        cameraStartY = simState.cameraY;
        svgEl.style.cursor = 'grabbing';
      } else if (activePointers.size === 2) {
        // 2本指タッチ開始：ピンチズームモードへ移行
        isDragging = false;
        initialPinchDist = getPinchDistance();
        initialPinchZoom = simState.cameraZoom;
      }
    });

    svgEl?.addEventListener('pointermove', (e) => {
      if (!activePointers.has(e.pointerId) || !svgEl) return;
      activePointers.set(e.pointerId, { x: e.clientX, y: e.clientY });

      if (activePointers.size === 2 && initialPinchDist > 10) {
        const currentDist = getPinchDistance();
        const scaleRatio = currentDist / initialPinchDist;
        simState.cameraZoom = clampZoom(initialPinchZoom * scaleRatio);
        return;
      }

      if (isDragging && activePointers.size === 1) {
        const rect = svgEl.getBoundingClientRect();
        const svgScale = 1280 / Math.min(rect.width, rect.height);
        const dx = ((e.clientX - dragStartX) * svgScale) / simState.cameraZoom;
        const dy = ((e.clientY - dragStartY) * svgScale) / simState.cameraZoom;

        if (
          !simState.isMoonSystemView &&
          simState.selectedBodyId !== 'overview' &&
          Math.hypot(e.clientX - dragStartX, e.clientY - dragStartY) > 12
        ) {
          // 天体追従を解除（カメラ位置はユーザーのパン操作に任せるため、位置・ズームはリセットしない）
          clearSelectionKeepCamera();
        }

        simState.cameraX = cameraStartX - dx;
        simState.cameraY = cameraStartY - dy;
      }
    });

    function handlePointerUpOrCancel(e: PointerEvent) {
      activePointers.delete(e.pointerId);
      if (activePointers.size < 2) {
        initialPinchDist = 0;
      }
      if (activePointers.size === 0 && svgEl) {
        isDragging = false;
        svgEl.style.cursor = 'grab';
      }
    }

    svgEl?.addEventListener('pointerup', handlePointerUpOrCancel);
    svgEl?.addEventListener('pointercancel', handlePointerUpOrCancel);

    // キーボードショートカット
    window.addEventListener('keydown', (e) => {
      if (e.ctrlKey || e.metaKey || e.altKey) return;
      const target = e.target instanceof Element ? e.target : null;
      const inTextField = !!target?.closest('input, select, textarea');
      // ボタン・フォーカス可能な天体ノード上の Space は、そのボタン本来の操作（クリック）を優先する
      const onActivatable = !!target?.closest('button, [role="button"], a[href]');
      if (e.code === 'Escape') {
        if (isDrawerOpen) {
          setDrawerOpen(false);
        } else {
          selectCelestialBody('overview');
        }
        return;
      }
      if (inTextField) return;
      if (e.code === 'Space') {
        if (onActivatable) return;
        e.preventDefault();
        setPlayingState(!simState.isPlaying);
      } else if (e.key === '1') {
        switchScaleZone('inner');
      } else if (e.key === '2') {
        switchScaleZone('outer');
      } else if (e.key === '3') {
        switchScaleZone('tno');
      } else if (e.key === '4') {
        openMoonSystemView();
      }
    });

    // 初期状態の設定
    if (menuDrawerEl) {
      gsap.set(menuDrawerEl, { x: 340, autoAlpha: 0 });
    }
    if (detailPanelEl) {
      const mobile = isMobileSheetLayout();
      gsap.set(detailPanelEl, { x: mobile ? 0 : 420, y: mobile ? 480 : 0, autoAlpha: 0 });
    }
    switchScaleZone('inner', { keepSelection: false });
    updateSpeedHud();

    // --- 背景星空キャンバスの描画 ---
    const canvas = document.getElementById('starfield-canvas') as HTMLCanvasElement | null;
    if (canvas) {
      const ctx = canvas.getContext('2d');
      // 星は 0〜1 の正規化座標で保持し、リサイズ時は再生成せず再描画のみ行う（ちらつき防止）
      const stars: { nx: number; ny: number; r: number; alpha: number; color: string }[] = [];
      let canvasCssW = 0;
      let canvasCssH = 0;

      function initStars() {
        const count = Math.floor((window.innerWidth * window.innerHeight) / 3800);
        const palette = ['#ffffff', '#e0f2fe', '#fef3c7', '#cbd5e1'];
        stars.length = 0;
        for (let i = 0; i < count; i++) {
          stars.push({
            nx: Math.random(),
            ny: Math.random(),
            r: Math.random() * 1.35 + 0.25,
            alpha: Math.random() * 0.75 + 0.15,
            color: palette[Math.floor(Math.random() * palette.length)],
          });
        }
      }

      /**
       * キャンバスサイズをデバイスピクセル比に合わせて更新し、再描画する（HiDPI対応）
       */
      function resizeStarfield() {
        if (!canvas || !ctx) return;
        const dpr = Math.min(window.devicePixelRatio || 1, 2);
        canvasCssW = window.innerWidth;
        canvasCssH = window.innerHeight;
        canvas.width = Math.floor(canvasCssW * dpr);
        canvas.height = Math.floor(canvasCssH * dpr);
        canvas.style.width = `${canvasCssW}px`;
        canvas.style.height = `${canvasCssH}px`;
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        drawStars();
      }

      function drawStars() {
        if (!canvas || !ctx) return;
        ctx.clearRect(0, 0, canvasCssW, canvasCssH);

        const grad = ctx.createRadialGradient(
          canvasCssW * 0.5,
          canvasCssH * 0.5,
          20,
          canvasCssW * 0.5,
          canvasCssH * 0.5,
          Math.max(canvasCssW, canvasCssH) * 0.7
        );
        grad.addColorStop(0, 'rgba(15, 25, 55, 0.55)');
        grad.addColorStop(0.5, 'rgba(6, 11, 26, 0.85)');
        grad.addColorStop(1, 'rgba(3, 5, 14, 1)');
        ctx.fillStyle = grad;
        ctx.fillRect(0, 0, canvasCssW, canvasCssH);

        for (const s of stars) {
          ctx.globalAlpha = s.alpha;
          ctx.fillStyle = s.color;
          ctx.beginPath();
          ctx.arc(s.nx * canvasCssW, s.ny * canvasCssH, s.r, 0, Math.PI * 2);
          ctx.fill();
        }
        ctx.globalAlpha = 1;
      }

      initStars();
      resizeStarfield();

      let resizeTimer: number | undefined;
      window.addEventListener('resize', () => {
        // リサイズ中の連続イベントをまとめて処理（デバウンス）
        window.clearTimeout(resizeTimer);
        resizeTimer = window.setTimeout(resizeStarfield, 120);
        // 画面回転・リサイズ時に非表示状態の詳細パネル待機座標を更新
        if (detailPanelEl && simState.selectedBodyId === 'overview') {
          const mobile = isMobileSheetLayout();
          gsap.set(detailPanelEl, { x: mobile ? 0 : 420, y: mobile ? 480 : 0, autoAlpha: 0 });
        }
      });
    }

    // 詳細パネル内の「ライブ数値」は毎フレーム更新されるため、スクリーンリーダーへの連続通知を抑止する
    detailLiveBoxEl?.setAttribute('aria-live', 'off');
  }
</script>

