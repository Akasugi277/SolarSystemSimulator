    /**
     * 天体・衛星軌道拡大専用ビューのDOMキャッシュ構造
     */
    interface MoonSystemStageCache {
      targetId: string;
      planet: PlanetData | null;
      centralRadiusPx: number;
      outerGridRingEl: SVGEllipseElement | null;
      gridSpokes: { deg: number; lineEl: SVGLineElement; textEl: SVGTextElement }[];
      ringBands: {
        band: NonNullable<PlanetData['ringSystem']>['bands'][number];
        aspectRatio: number;
        backEl: SVGEllipseElement;
        frontEl: SVGEllipseElement;
      }[];
      ringParticles: {
        radiusMultiplier: number;
        aspectRatio: number;
        baseAngleRad: number;
        angularSpeedRadPerSec: number;
        baseOpacity: number;
        backDotEl: SVGCircleElement;
        frontDotEl: SVGCircleElement;
      }[];
      atmoUpdaters: ((t: number) => void)[];
      moons: {
        id: string;
        nameJa: string;
        nameEn: string;
        orbitalPeriodDays: number;
        initialAngleDeg: number;
        autoRadiusPx: number;
        realRadiusPx: number;
        expandedSizePx: number;
        orbitEl: SVGEllipseElement;
        orbitTagEl: SVGTextElement;
        nodeEl: SVGGElement;
      }[];
    }

    let activeMoonStageCache: MoonSystemStageCache | null = null;

    /**
     * 指定した14天体（太陽・水星・金星・地球・火星・ケレス・木星・土星・天王星・海王星・冥王星・ハウメア・マケマケ・エリス）の
     * 天体＋衛星軌道・近傍重力圏拡大専用ビューSVGステージを構築する
     */
    function buildMoonSystemStageDom(targetId: string) {
      if (!msGridGroupEl || !msOrbitsGroupEl || !msCentralPlanetGroupEl || !msMoonsNodesGroupEl) return;

      const svgNs = 'http://www.w3.org/2000/svg';
      msGridGroupEl.innerHTML = '';
      msOrbitsGroupEl.innerHTML = '';
      msCentralPlanetGroupEl.innerHTML = '';
      msMoonsNodesGroupEl.innerHTML = '';

      const isSun = targetId === 'sun';
      const planet = isSun ? null : planetsData.find((p) => p.id === targetId) || null;
      if (!isSun && !planet) return;

      const hasNaturalMoons = !isSun && !!planet && planet.moons.length > 0;
      const centralR = isSun ? 84 : hasNaturalMoons ? 52 : 76;
      const maxGridR = 525;
      const bodyColor = isSun ? '#fbbf24' : planet!.color;
      const bodySymbol = isSun ? sunData.symbol : planet!.symbol;
      const bodyNameJa = isSun ? sunData.nameJa : planet!.nameJa;
      const bodyNameEn = isSun ? sunData.nameEn : planet!.nameEn;
      const bodyDiameterKm = isSun ? sunData.diameterKm : planet!.diameterKm;
      const interior = isSun ? sunData.interiorStructure : planet?.interiorStructure;

      const sphereClipCircleEl = document.getElementById('ms-sphere-clip-circle');
      if (sphereClipCircleEl) {
        sphereClipCircleEl.setAttribute('r', String(centralR));
      }

      const atmoUpdaters: ((t: number) => void)[] = [];
      const ringParticles: MoonSystemStageCache['ringParticles'] = [];

      // 1. 背景極座標グリッド（外周リング＋30°ごとの方位スポーク）
      const outerGridRingEl = document.createElementNS(svgNs, 'ellipse');
      outerGridRingEl.setAttribute('cx', '0');
      outerGridRingEl.setAttribute('cy', '0');
      outerGridRingEl.setAttribute('rx', String(maxGridR));
      outerGridRingEl.setAttribute('ry', String(maxGridR));
      outerGridRingEl.setAttribute('class', 'grid-ring ms-outer-grid-ring');
      msGridGroupEl.appendChild(outerGridRingEl);

      const gridSpokes: MoonSystemStageCache['gridSpokes'] = [];
      for (let i = 0; i < 12; i++) {
        const deg = i * 30;
        const lineEl = document.createElementNS(svgNs, 'line');
        lineEl.setAttribute('class', 'grid-spoke');
        const textEl = document.createElementNS(svgNs, 'text');
        textEl.setAttribute('class', 'grid-deg-label');
        textEl.textContent = `${deg}°`;
        msGridGroupEl.appendChild(lineEl);
        msGridGroupEl.appendChild(textEl);
        gridSpokes.push({ deg, lineEl, textEl });
      }

      // 2. 中心天体（大サイズ球体＋大気/コロナ/外気圏アニメーション＋右上90°内部断面カット＋多重環＆環粒子立体交差）
      const haloEl = document.createElementNS(svgNs, 'circle');
      haloEl.setAttribute('cx', '0');
      haloEl.setAttribute('cy', '0');
      haloEl.setAttribute('r', (centralR * (isSun ? 1.58 : 1.42)).toFixed(1));
      haloEl.setAttribute('fill', bodyColor);
      haloEl.setAttribute('fill-opacity', isSun ? '0.2' : '0.15');
      msCentralPlanetGroupEl.appendChild(haloEl);

      // 太陽専用：回転するコロナ光条・プロミネンス（紅炎）脈動・太陽風プラズマ粒子の放射状流出アニメーション
      if (isSun) {
        const innerCoronaEl = document.createElementNS(svgNs, 'circle');
        innerCoronaEl.setAttribute('cx', '0');
        innerCoronaEl.setAttribute('cy', '0');
        innerCoronaEl.setAttribute('r', (centralR * 1.24).toFixed(1));
        innerCoronaEl.setAttribute('fill', '#f59e0b');
        innerCoronaEl.setAttribute('fill-opacity', '0.26');
        msCentralPlanetGroupEl.appendChild(innerCoronaEl);

        const coronaRaysGroupEl = document.createElementNS(svgNs, 'g');
        for (let i = 0; i < 8; i++) {
          const rayEl = document.createElementNS(svgNs, 'polygon');
          const rDeg = i * 45;
          rayEl.setAttribute(
            'points',
            `-12,-${(centralR * 0.95).toFixed(1)} 0,-${(centralR * 1.72).toFixed(1)} 12,-${(centralR * 0.95).toFixed(1)}`
          );
          rayEl.setAttribute('fill', 'rgba(253, 224, 71, 0.16)');
          rayEl.setAttribute('transform', `rotate(${rDeg})`);
          coronaRaysGroupEl.appendChild(rayEl);
        }
        msCentralPlanetGroupEl.appendChild(coronaRaysGroupEl);

        const promEls: { el: SVGPathElement; deg: number; phase: number }[] = [];
        const promAngles = [-38, 128, 215, 305];
        promAngles.forEach((deg, idx) => {
          const promEl = document.createElementNS(svgNs, 'path');
          promEl.setAttribute('fill', 'none');
          promEl.setAttribute('stroke', '#fb7185');
          promEl.setAttribute('stroke-width', '2.8');
          promEl.setAttribute('transform', `rotate(${deg})`);
          promEl.setAttribute('filter', 'url(#ring-glow)');
          msCentralPlanetGroupEl.appendChild(promEl);
          promEls.push({ el: promEl, deg, phase: idx * 1.55 });
        });

        // 放射状に流出する18個の太陽風プラズマ粒子
        const solarWindParticles: { el: SVGCircleElement; angleRad: number; phaseOffset: number }[] = [];
        for (let i = 0; i < 18; i++) {
          const swEl = document.createElementNS(svgNs, 'circle');
          swEl.setAttribute('r', i % 2 === 0 ? '2.2' : '1.6');
          swEl.setAttribute('fill', i % 3 === 0 ? '#fef08a' : '#fb923c');
          msCentralPlanetGroupEl.appendChild(swEl);
          solarWindParticles.push({
            el: swEl,
            angleRad: (i * 20 + (i % 2) * 7) * DEG_TO_RAD,
            phaseOffset: i / 18,
          });
        }

        atmoUpdaters.push((t) => {
          const coronaPulse = 1 + Math.sin(t * 2.1) * 0.05;
          innerCoronaEl.setAttribute('r', (centralR * 1.24 * coronaPulse).toFixed(1));
          coronaRaysGroupEl.setAttribute('transform', `rotate(${(t * 7.5) % 360})`);

          for (const pr of promEls) {
            const h = 22 + Math.sin(t * 2.4 + pr.phase) * 10;
            const w = 16 + Math.cos(t * 1.8 + pr.phase) * 5;
            pr.el.setAttribute(
              'd',
              `M 0,-${(centralR - 2).toFixed(1)} C ${w.toFixed(1)},-${(centralR + h).toFixed(1)} -${w.toFixed(1)},-${(centralR + h).toFixed(1)} 0,-${(centralR - 2).toFixed(1)}`
            );
            pr.el.setAttribute('stroke-opacity', (0.62 + Math.sin(t * 2.4 + pr.phase) * 0.28).toFixed(2));
          }

          for (const sw of solarWindParticles) {
            const prog = ((t * 0.38 + sw.phaseOffset) % 1 + 1) % 1;
            const r = centralR * (1.03 + prog * 0.92);
            sw.el.setAttribute('cx', (Math.cos(sw.angleRad) * r).toFixed(1));
            sw.el.setAttribute('cy', (Math.sin(sw.angleRad) * r).toFixed(1));
            sw.el.setAttribute('fill-opacity', ((1 - prog) * 0.85).toFixed(2));
          }
        });
      }

      // 水星専用：太陽風磁気バウショック弧＆反太陽方向ナトリウム希薄外気圏テイルと放出粒子アニメーション
      if (targetId === 'mercury') {
        const bowShockEl = document.createElementNS(svgNs, 'path');
        bowShockEl.setAttribute(
          'd',
          `M -${(centralR * 0.45).toFixed(1)},-${(centralR * 1.32).toFixed(1)} Q -${(centralR * 1.62).toFixed(1)},0 -${(centralR * 0.45).toFixed(1)},${(centralR * 1.32).toFixed(1)}`
        );
        bowShockEl.setAttribute('fill', 'none');
        bowShockEl.setAttribute('stroke', '#38bdf8');
        bowShockEl.setAttribute('stroke-width', '1.8');
        bowShockEl.setAttribute('stroke-dasharray', '4 3');
        msCentralPlanetGroupEl.appendChild(bowShockEl);

        const tailEl = document.createElementNS(svgNs, 'path');
        tailEl.setAttribute('fill', 'url(#comet-tail-grad)');
        msCentralPlanetGroupEl.appendChild(tailEl);

        const naParticles: { el: SVGCircleElement; yBase: number; phase: number }[] = [];
        for (let i = 0; i < 14; i++) {
          const pEl = document.createElementNS(svgNs, 'circle');
          pEl.setAttribute('r', i % 2 === 0 ? '2.1' : '1.5');
          pEl.setAttribute('fill', i % 3 === 0 ? '#fde047' : '#67e8f9');
          msCentralPlanetGroupEl.appendChild(pEl);
          const ySpread = ((i % 7) - 3) * (centralR * 0.16);
          naParticles.push({ el: pEl, yBase: ySpread, phase: i / 14 });
        }

        atmoUpdaters.push((t) => {
          const tailLen = centralR * (2.25 + Math.sin(t * 2.6) * 0.18);
          const tailHalfW = centralR * (0.68 + Math.cos(t * 2.0) * 0.06);
          tailEl.setAttribute(
            'd',
            `M 0,-${tailHalfW.toFixed(1)} L ${tailLen.toFixed(1)},0 L 0,${tailHalfW.toFixed(1)} Z`
          );
          tailEl.setAttribute('opacity', (0.5 + Math.sin(t * 2.2) * 0.12).toFixed(2));
          bowShockEl.setAttribute('stroke-opacity', (0.45 + Math.sin(t * 3.1) * 0.25).toFixed(2));

          for (const np of naParticles) {
            const prog = ((t * 0.52 + np.phase) % 1 + 1) % 1;
            const px = centralR * 0.25 + prog * (centralR * 1.95);
            const py = np.yBase * (1 - prog * 0.55) + Math.sin(t * 4 + np.phase * 10) * 2.5;
            np.el.setAttribute('cx', px.toFixed(1));
            np.el.setAttribute('cy', py.toFixed(1));
            np.el.setAttribute('fill-opacity', ((1 - prog) * 0.88).toFixed(2));
          }
        });
      }

      const ringBands: MoonSystemStageCache['ringBands'] = [];
      const ringTiltDeg = planet?.ringSystem?.tiltDeg ?? -14;
      const ringAspect = planet?.ringSystem?.aspectRatio ?? 0.36;

      let backRingGroupEl: SVGGElement | null = null;
      let frontRingGroupEl: SVGGElement | null = null;

      if (planet && planet.hasRings && planet.ringSystem) {
        backRingGroupEl = document.createElementNS(svgNs, 'g');
        backRingGroupEl.setAttribute('transform', `rotate(${ringTiltDeg})`);
        backRingGroupEl.setAttribute('filter', 'url(#ring-glow)');
        msCentralPlanetGroupEl.appendChild(backRingGroupEl);
      }

      // 中心天体球体（太陽は#sun-gradient、ハウメアは長楕円体、その他は#grad-${id}）
      if (targetId === 'haumea') {
        const ellEl = document.createElementNS(svgNs, 'ellipse');
        ellEl.setAttribute('cx', '0');
        ellEl.setAttribute('cy', '0');
        ellEl.setAttribute('rx', (centralR * 1.32).toFixed(1));
        ellEl.setAttribute('ry', (centralR * 0.82).toFixed(1));
        ellEl.setAttribute('transform', 'rotate(-18)');
        ellEl.setAttribute('fill', `url(#grad-${targetId})`);
        ellEl.setAttribute('filter', 'url(#planet-glow)');
        ellEl.setAttribute('class', 'ms-central-sphere');
        msCentralPlanetGroupEl.appendChild(ellEl);
      } else {
        const sphereEl = document.createElementNS(svgNs, 'circle');
        sphereEl.setAttribute('cx', '0');
        sphereEl.setAttribute('cy', '0');
        sphereEl.setAttribute('r', String(centralR));
        sphereEl.setAttribute('fill', isSun ? 'url(#sun-gradient)' : `url(#grad-${targetId})`);
        sphereEl.setAttribute('filter', isSun ? 'url(#sun-glow)' : 'url(#planet-glow)');
        sphereEl.setAttribute('class', 'ms-central-sphere');
        msCentralPlanetGroupEl.appendChild(sphereEl);
      }

      // 球体内部にクリップされた大気・対流・雲バンド・渦の専用アニメーションレイヤー
      const atmoClipGroupEl = document.createElementNS(svgNs, 'g');
      atmoClipGroupEl.setAttribute('clip-path', 'url(#ms-sphere-clip)');
      msCentralPlanetGroupEl.appendChild(atmoClipGroupEl);

      // 太陽：光球面の差動自転対流バンド＆黒点・白斑活動領域の移動
      if (isSun) {
        const sunSpots: { el: SVGGElement; y: number; speed: number; offset: number }[] = [];
        for (const cfg of [
          { y: -22, speed: 18, offset: -35 },
          { y: 14, speed: 22, offset: 12 },
          { y: 34, speed: 15, offset: -18 },
        ]) {
          const bandEl = document.createElementNS(svgNs, 'line');
          bandEl.setAttribute('x1', String(-centralR));
          bandEl.setAttribute('y1', String(cfg.y));
          bandEl.setAttribute('x2', String(centralR));
          bandEl.setAttribute('y2', String(cfg.y));
          bandEl.setAttribute('stroke', 'rgba(254, 240, 138, 0.28)');
          bandEl.setAttribute('stroke-width', '5');
          bandEl.setAttribute('stroke-dasharray', '14 10');
          atmoClipGroupEl.appendChild(bandEl);

          const spotGroup = document.createElementNS(svgNs, 'g');
          const facula = document.createElementNS(svgNs, 'ellipse');
          facula.setAttribute('rx', '9');
          facula.setAttribute('ry', '5.5');
          facula.setAttribute('fill', 'rgba(255, 255, 240, 0.45)');
          const umbra = document.createElementNS(svgNs, 'circle');
          umbra.setAttribute('r', '3.2');
          umbra.setAttribute('fill', '#7c2d12');
          spotGroup.appendChild(facula);
          spotGroup.appendChild(umbra);
          atmoClipGroupEl.appendChild(spotGroup);
          sunSpots.push({ el: spotGroup, y: cfg.y, speed: cfg.speed, offset: cfg.offset });
        }

        atmoUpdaters.push((t) => {
          const span = centralR * 2.2;
          for (const sp of sunSpots) {
            const x = ((((sp.offset + t * sp.speed) % span) + span) % span) - centralR * 1.1;
            sp.el.setAttribute('transform', `translate(${x.toFixed(1)}, ${sp.y})`);
          }
        });
      }

      // 金星：濃硫酸雲の高速スーパーローテーション（V字弓状雲波と赤道ジェット気流の連続流動）
      if (targetId === 'venus') {
        const venusBands: SVGLineElement[] = [];
        for (const y of [-38, -18, 4, 24, 42]) {
          const bEl = document.createElementNS(svgNs, 'line');
          bEl.setAttribute('x1', String(-centralR));
          bEl.setAttribute('y1', String(y));
          bEl.setAttribute('x2', String(centralR));
          bEl.setAttribute('y2', String(y));
          bEl.setAttribute('stroke', 'rgba(254, 243, 199, 0.34)');
          bEl.setAttribute('stroke-width', '6.5');
          bEl.setAttribute('stroke-dasharray', '22 14');
          atmoClipGroupEl.appendChild(bEl);
          venusBands.push(bEl);
        }

        const chevrons: { el: SVGPathElement; baseOffset: number }[] = [];
        for (let i = 0; i < 4; i++) {
          const arcEl = document.createElementNS(svgNs, 'path');
          arcEl.setAttribute(
            'd',
            `M 0,-${(centralR * 0.68).toFixed(1)} Q -32,0 0,${(centralR * 0.68).toFixed(1)}`
          );
          arcEl.setAttribute('fill', 'none');
          arcEl.setAttribute('stroke', 'rgba(254, 249, 195, 0.56)');
          arcEl.setAttribute('stroke-width', '2.8');
          atmoClipGroupEl.appendChild(arcEl);
          chevrons.push({ el: arcEl, baseOffset: i * 44 });
        }

        atmoUpdaters.push((t) => {
          venusBands.forEach((bEl, idx) => {
            bEl.setAttribute('stroke-dashoffset', (t * (32 + idx * 5)).toFixed(1));
          });
          const span = 176;
          for (const ch of chevrons) {
            const x = -centralR * 0.9 + ((((ch.baseOffset - t * 28) % span) + span) % span);
            ch.el.setAttribute('transform', `translate(${x.toFixed(1)}, 0)`);
          }
        });
      }

      // 地球：偏西風・貿易風の白雲バンド移動・台風（サイクロン）渦の自転＆極域オーロラ発光アニメーション
      if (targetId === 'earth') {
        const northAuroraEl = document.createElementNS(svgNs, 'ellipse');
        northAuroraEl.setAttribute('cx', '0');
        northAuroraEl.setAttribute('cy', (-centralR * 0.78).toFixed(1));
        northAuroraEl.setAttribute('rx', (centralR * 0.52).toFixed(1));
        northAuroraEl.setAttribute('ry', '5.5');
        northAuroraEl.setAttribute('fill', 'none');
        northAuroraEl.setAttribute('stroke', '#34d399');
        northAuroraEl.setAttribute('stroke-width', '3.2');
        atmoClipGroupEl.appendChild(northAuroraEl);

        const southAuroraEl = document.createElementNS(svgNs, 'ellipse');
        southAuroraEl.setAttribute('cx', '0');
        southAuroraEl.setAttribute('cy', (centralR * 0.78).toFixed(1));
        southAuroraEl.setAttribute('rx', (centralR * 0.52).toFixed(1));
        southAuroraEl.setAttribute('ry', '5.5');
        southAuroraEl.setAttribute('fill', 'none');
        southAuroraEl.setAttribute('stroke', '#2dd4bf');
        southAuroraEl.setAttribute('stroke-width', '3.0');
        atmoClipGroupEl.appendChild(southAuroraEl);

        const cloudBands: { el: SVGLineElement; speed: number }[] = [];
        for (const cfg of [
          { y: -22, speed: -24, w: 4.5, dash: '18 14' },
          { y: -7, speed: 18, w: 5.2, dash: '24 16' },
          { y: 10, speed: -22, w: 4.8, dash: '20 12' },
          { y: 25, speed: -26, w: 4.2, dash: '16 14' },
        ]) {
          const cEl = document.createElementNS(svgNs, 'line');
          cEl.setAttribute('x1', String(-centralR));
          cEl.setAttribute('y1', String(cfg.y));
          cEl.setAttribute('x2', String(centralR));
          cEl.setAttribute('y2', String(cfg.y));
          cEl.setAttribute('stroke', 'rgba(255, 255, 255, 0.55)');
          cEl.setAttribute('stroke-width', String(cfg.w));
          cEl.setAttribute('stroke-linecap', 'round');
          cEl.setAttribute('stroke-dasharray', cfg.dash);
          atmoClipGroupEl.appendChild(cEl);
          cloudBands.push({ el: cEl, speed: cfg.speed });
        }

        // 台風・サイクロン渦
        const cycloneGroupEl = document.createElementNS(svgNs, 'g');
        const cycRing = document.createElementNS(svgNs, 'circle');
        cycRing.setAttribute('r', '7.5');
        cycRing.setAttribute('fill', 'none');
        cycRing.setAttribute('stroke', 'rgba(255, 255, 255, 0.82)');
        cycRing.setAttribute('stroke-width', '2.4');
        cycRing.setAttribute('stroke-dasharray', '7 4');
        cycloneGroupEl.appendChild(cycRing);
        atmoClipGroupEl.appendChild(cycloneGroupEl);

        atmoUpdaters.push((t) => {
          for (const cb of cloudBands) {
            cb.el.setAttribute('stroke-dashoffset', (t * cb.speed).toFixed(1));
          }
          const cycX = -16 + Math.sin(t * 0.7) * 14;
          const cycY = -8 + Math.cos(t * 0.5) * 4;
          cycloneGroupEl.setAttribute(
            'transform',
            `translate(${cycX.toFixed(1)}, ${cycY.toFixed(1)}) rotate(${(-t * 140) % 360})`
          );
          const auroraAlpha = 0.42 + Math.sin(t * 3.2) * 0.28;
          northAuroraEl.setAttribute('stroke-opacity', auroraAlpha.toFixed(2));
          southAuroraEl.setAttribute('stroke-opacity', (0.38 + Math.cos(t * 2.9) * 0.26).toFixed(2));
        });
      }

      // 火星：砂塵嵐（ダストストーム）渦気流・高層水氷雲の流動＆北極・南極冠の輝き
      if (targetId === 'mars') {
        const northCapEl = document.createElementNS(svgNs, 'ellipse');
        northCapEl.setAttribute('cx', '0');
        northCapEl.setAttribute('cy', (-centralR * 0.88).toFixed(1));
        northCapEl.setAttribute('rx', (centralR * 0.44).toFixed(1));
        northCapEl.setAttribute('ry', '6.5');
        northCapEl.setAttribute('fill', 'rgba(248, 250, 252, 0.78)');
        atmoClipGroupEl.appendChild(northCapEl);

        const dustStreams: { el: SVGLineElement; speed: number }[] = [];
        for (const cfg of [
          { y: -16, speed: -20, color: 'rgba(251, 191, 36, 0.46)', w: 6, dash: '22 14' },
          { y: 4, speed: -26, color: 'rgba(245, 158, 11, 0.52)', w: 7.5, dash: '26 16' },
          { y: 22, speed: -18, color: 'rgba(224, 242, 254, 0.38)', w: 4, dash: '14 18' },
        ]) {
          const dEl = document.createElementNS(svgNs, 'line');
          dEl.setAttribute('x1', String(-centralR));
          dEl.setAttribute('y1', String(cfg.y));
          dEl.setAttribute('x2', String(centralR));
          dEl.setAttribute('y2', String(cfg.y));
          dEl.setAttribute('stroke', cfg.color);
          dEl.setAttribute('stroke-width', String(cfg.w));
          dEl.setAttribute('stroke-linecap', 'round');
          dEl.setAttribute('stroke-dasharray', cfg.dash);
          atmoClipGroupEl.appendChild(dEl);
          dustStreams.push({ el: dEl, speed: cfg.speed });
        }

        const dustVortexEl = document.createElementNS(svgNs, 'ellipse');
        dustVortexEl.setAttribute('rx', '12');
        dustVortexEl.setAttribute('ry', '7.5');
        dustVortexEl.setAttribute('fill', 'rgba(251, 146, 60, 0.38)');
        dustVortexEl.setAttribute('stroke', 'rgba(254, 215, 170, 0.72)');
        dustVortexEl.setAttribute('stroke-width', '1.8');
        dustVortexEl.setAttribute('stroke-dasharray', '6 4');
        atmoClipGroupEl.appendChild(dustVortexEl);

        atmoUpdaters.push((t) => {
          for (const ds of dustStreams) {
            ds.el.setAttribute('stroke-dashoffset', (t * ds.speed).toFixed(1));
          }
          const vx = -10 + Math.sin(t * 0.85) * 16;
          dustVortexEl.setAttribute(
            'transform',
            `translate(${vx.toFixed(1)}, 10) rotate(${(t * 95) % 360})`
          );
        });
      }

      // 木星：東西交互の高速ジェット気流シアー（帯と縞の逆向き流動）＆大赤斑（Great Red Spot）の反時計回り渦回転
      if (targetId === 'jupiter') {
        const jupiterJets: { el: SVGLineElement; speed: number }[] = [];
        for (const cfg of [
          { y: -32, speed: -24, color: 'rgba(180, 83, 9, 0.52)', w: 6.5, dash: '22 10' },
          { y: -18, speed: 32, color: 'rgba(254, 243, 199, 0.56)', w: 7.5, dash: '28 12' },
          { y: -3, speed: -38, color: 'rgba(194, 65, 12, 0.62)', w: 8.0, dash: '26 11' },
          { y: 13, speed: 34, color: 'rgba(253, 230, 138, 0.54)', w: 7.5, dash: '24 12' },
          { y: 28, speed: -22, color: 'rgba(154, 52, 18, 0.50)', w: 6.5, dash: '20 12' },
        ]) {
          const jEl = document.createElementNS(svgNs, 'line');
          jEl.setAttribute('x1', String(-centralR));
          jEl.setAttribute('y1', String(cfg.y));
          jEl.setAttribute('x2', String(centralR));
          jEl.setAttribute('y2', String(cfg.y));
          jEl.setAttribute('stroke', cfg.color);
          jEl.setAttribute('stroke-width', String(cfg.w));
          jEl.setAttribute('stroke-dasharray', cfg.dash);
          atmoClipGroupEl.appendChild(jEl);
          jupiterJets.push({ el: jEl, speed: cfg.speed });
        }

        // 大赤斑（Great Red Spot）と内部反時計回り渦リング
        const grsOuterGroup = document.createElementNS(svgNs, 'g');
        grsOuterGroup.setAttribute('transform', 'translate(-14, 15)');
        const grsBody = document.createElementNS(svgNs, 'ellipse');
        grsBody.setAttribute('rx', '13.5');
        grsBody.setAttribute('ry', '8.5');
        grsBody.setAttribute('fill', '#dc2626');
        grsBody.setAttribute('stroke', '#fef08a');
        grsBody.setAttribute('stroke-width', '1.3');
        grsOuterGroup.appendChild(grsBody);

        const grsSwirl = document.createElementNS(svgNs, 'circle');
        grsSwirl.setAttribute('r', '5.5');
        grsSwirl.setAttribute('fill', 'none');
        grsSwirl.setAttribute('stroke', '#fecaca');
        grsSwirl.setAttribute('stroke-width', '1.8');
        grsSwirl.setAttribute('stroke-dasharray', '5 3.5');
        grsOuterGroup.appendChild(grsSwirl);
        atmoClipGroupEl.appendChild(grsOuterGroup);

        atmoUpdaters.push((t) => {
          for (const jj of jupiterJets) {
            jj.el.setAttribute('stroke-dashoffset', (t * jj.speed).toFixed(1));
          }
          const grsX = -14 + Math.sin(t * 0.65) * 6;
          grsOuterGroup.setAttribute('transform', `translate(${grsX.toFixed(1)}, 15)`);
          grsSwirl.setAttribute('transform', `rotate(${(-t * 130) % 360})`);
        });
      }

      // 土星：北極の六角形ジェット気流（ヘキサゴン渦）の回転＆赤道スーパーローテーション気流の移動
      if (targetId === 'saturn') {
        const saturnJets: { el: SVGLineElement; speed: number }[] = [];
        for (const cfg of [
          { y: -14, speed: -36, color: 'rgba(254, 243, 199, 0.48)', w: 6.5, dash: '26 12' },
          { y: 0, speed: -46, color: 'rgba(253, 224, 71, 0.52)', w: 8.0, dash: '30 12' },
          { y: 15, speed: -34, color: 'rgba(217, 119, 6, 0.42)', w: 6.5, dash: '24 12' },
        ]) {
          const sEl = document.createElementNS(svgNs, 'line');
          sEl.setAttribute('x1', String(-centralR));
          sEl.setAttribute('y1', String(cfg.y));
          sEl.setAttribute('x2', String(centralR));
          sEl.setAttribute('y2', String(cfg.y));
          sEl.setAttribute('stroke', cfg.color);
          sEl.setAttribute('stroke-width', String(cfg.w));
          sEl.setAttribute('stroke-dasharray', cfg.dash);
          atmoClipGroupEl.appendChild(sEl);
          saturnJets.push({ el: sEl, speed: cfg.speed });
        }

        // 北極ヘキサゴン（正六角形ジェット気流渦）
        const hexWrapper = document.createElementNS(svgNs, 'g');
        hexWrapper.setAttribute('transform', `translate(-12, ${(-centralR * 0.56).toFixed(1)}) scale(1, 0.55)`);
        const hexPoly = document.createElementNS(svgNs, 'polygon');
        const hexR = 15;
        const pts = Array.from({ length: 6 })
          .map((_, i) => {
            const a = (i * 60 * Math.PI) / 180;
            return `${(Math.cos(a) * hexR).toFixed(1)},${(Math.sin(a) * hexR).toFixed(1)}`;
          })
          .join(' ');
        hexPoly.setAttribute('points', pts);
        hexPoly.setAttribute('fill', 'rgba(180, 83, 9, 0.35)');
        hexPoly.setAttribute('stroke', '#fde047');
        hexPoly.setAttribute('stroke-width', '2.0');
        hexWrapper.appendChild(hexPoly);
        atmoClipGroupEl.appendChild(hexWrapper);

        atmoUpdaters.push((t) => {
          for (const sj of saturnJets) {
            sj.el.setAttribute('stroke-dashoffset', (t * sj.speed).toFixed(1));
          }
          hexPoly.setAttribute('transform', `rotate(${(t * 55) % 360})`);
        });
      }

      // 天王星：横倒し自転軸（97.8°）に沿った縦向きメタン雲バンド流動＆極域季節フード（Polar Hood）脈動
      if (targetId === 'uranus') {
        const uranusAtmoGroup = document.createElementNS(svgNs, 'g');
        uranusAtmoGroup.setAttribute('transform', 'rotate(76)');

        const polarHoodEl = document.createElementNS(svgNs, 'ellipse');
        polarHoodEl.setAttribute('cx', '0');
        polarHoodEl.setAttribute('cy', (-centralR * 0.72).toFixed(1));
        polarHoodEl.setAttribute('rx', (centralR * 0.64).toFixed(1));
        polarHoodEl.setAttribute('ry', '12');
        polarHoodEl.setAttribute('fill', 'rgba(224, 242, 254, 0.42)');
        uranusAtmoGroup.appendChild(polarHoodEl);

        const uranusBands: { el: SVGLineElement; speed: number }[] = [];
        for (const cfg of [
          { y: -16, speed: -22, w: 5.5 },
          { y: 2, speed: 28, w: 6.5 },
          { y: 18, speed: -20, w: 5.5 },
        ]) {
          const uEl = document.createElementNS(svgNs, 'line');
          uEl.setAttribute('x1', String(-centralR));
          uEl.setAttribute('y1', String(cfg.y));
          uEl.setAttribute('x2', String(centralR));
          uEl.setAttribute('y2', String(cfg.y));
          uEl.setAttribute('stroke', 'rgba(186, 230, 253, 0.48)');
          uEl.setAttribute('stroke-width', String(cfg.w));
          uEl.setAttribute('stroke-dasharray', '18 14');
          uranusAtmoGroup.appendChild(uEl);
          uranusBands.push({ el: uEl, speed: cfg.speed });
        }

        atmoClipGroupEl.appendChild(uranusAtmoGroup);

        atmoUpdaters.push((t) => {
          for (const ub of uranusBands) {
            ub.el.setAttribute('stroke-dashoffset', (t * ub.speed).toFixed(1));
          }
          polarHoodEl.setAttribute('fill-opacity', (0.35 + Math.sin(t * 2.4) * 0.16).toFixed(2));
        });
      }

      // 海王星：太陽系最速（秒速600m）の超音速メタン雲ジェット・大暗斑（Great Dark Spot）＆白い伴雲スクーターの高速移動
      if (targetId === 'neptune') {
        const neptuneJets: { el: SVGLineElement; speed: number }[] = [];
        for (const cfg of [
          { y: -22, speed: 52, color: 'rgba(125, 211, 252, 0.48)', w: 4.5, dash: '24 16' },
          { y: -4, speed: 68, color: 'rgba(224, 242, 254, 0.56)', w: 5.2, dash: '28 18' },
