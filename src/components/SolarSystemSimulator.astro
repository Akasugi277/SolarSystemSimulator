<script>
  import { gsap } from 'gsap';
  import type { PlanetData, SunData, ScaleZone, SCALE_ZONES_META } from '../data/solarSystem';

  /**
   * 太陽系軌道早見シミュレーター クライアント制御スクリプト
   * - 3段階表示縮尺（内惑星・外惑星・外縁天体）の動的GSAP再配分
   * - ハンバーガーメニューへのトグル集約
   * - スマートフォン・タブレット対応（ピンチズーム・スワイプパン・ボトムシート詳細パネル）
   * - 5大周期彗星（ハレー・エンケ・67P・スイフト・タットル・ジャコビニ・ツィナー）の軌道と反太陽方向の尾の描画
   */
  const rootEl = document.getElementById('simulator-root');
  if (rootEl) {
    const sunData: SunData = JSON.parse(rootEl.dataset.sun || '{}');
    const planetsData: PlanetData[] = JSON.parse(rootEl.dataset.planets || '[]');
    const zonesMeta: typeof SCALE_ZONES_META = JSON.parse(rootEl.dataset.zonesMeta || '{}');
    const moonTargetIds: string[] = JSON.parse(rootEl.dataset.moonTargets || '[]');
    const j2000Timestamp = Number(rootEl.dataset.j2000 || Date.UTC(2000, 0, 1, 12, 0, 0));

    const MS_PER_DAY = 86400000;
    const DEG_TO_RAD = Math.PI / 180;
    const RAD_TO_DEG = 180 / Math.PI;

    // 現在日時からJ2000.0までの初期経過日数を算出
    const nowTimestamp = Date.now();
    const initialElapsedDays = (nowTimestamp - j2000Timestamp) / MS_PER_DAY;

    // シミュレーターのリアクティブ状態オブジェクト
    const simState = {
      elapsedDays: initialElapsedDays,
      sliderAnchorDays: initialElapsedDays,
      visualAnimSec: 0,
      isPlaying: true,
      direction: 1,
      speedDaysPerSec: 10,
      tiltY: 1.0,
      auRatioBlend: 0.0,
      showMoons: true,
      showComets: true,
      emphasizeRings: true,
      highlightDwarfs: false,
      highlightComets: false,
      activeZone: 'inner' as ScaleZone,
      isMoonSystemView: false,
      moonViewPlanetId: 'jupiter',
      selectedBodyId: 'overview',
      highlightedMoonId: '',
      sunRadiusPx: sunData.sizeByZonePx.inner,
      mainBeltRadiusPx: zonesMeta.inner.mainBelt.radiusPx,
      mainBeltWidthPx: zonesMeta.inner.mainBelt.widthPx,
      mainBeltOpacity: zonesMeta.inner.mainBelt.opacity,
      kuiperBeltRadiusPx: zonesMeta.inner.kuiperBelt.radiusPx,
      kuiperBeltWidthPx: zonesMeta.inner.kuiperBelt.widthPx,
      kuiperBeltOpacity: zonesMeta.inner.kuiperBelt.opacity,
      cameraX: 0,
      cameraY: 0,
      cameraZoom: 1.0,
    };

    /**
     * 各天体ごとのアニメート可能な表示パラメータ
     */
    interface AnimatedBodyParams {
      autoOrbitRadiusPx: number;
      auOrbitRadiusPx: number;
      displayEcc: number;
      bodySizePx: number;
      opacity: number;
      moonVisibility: number;
      labelVisibility: number;
    }

    /**
     * 指定した縮尺ゾーンにおける表示離心率を取得するヘルパー
     */
    function getZoneDisplayEcc(planet: PlanetData, zone: ScaleZone): number {
      const custom = planet.scaleConfig.customDisplayEcc;
      if (typeof custom === 'number') return custom;
      if (custom && typeof custom === 'object') return custom[zone];
      return planet.bodyClass !== 'planet' ? planet.eccentricity * 0.42 : planet.eccentricity * 0.35;
    }

    /**
     * 指定した縮尺ゾーンにおける各天体の実距離比(AU)軌道半径を計算する
     */
    function computeZoneAuRadiusPx(planet: PlanetData, zone: ScaleZone): number {
      if (planet.id === 'sedna' || planet.bodyClass === 'comet') {
        return planet.scaleConfig.orbitRadiusPx[zone];
      }
      const maxAu = zonesMeta[zone].maxAuRef;
      const maxCanvasPx = 525;
      const sunMarginPx = sunData.sizeByZonePx[zone] + 20;
      const normalized = planet.semiMajorAxisAu / maxAu;
      return sunMarginPx + Math.pow(normalized, 0.88) * (maxCanvasPx - sunMarginPx);
    }

    // 各天体の初期アニメート状態を生成
    const bodyAnimState: Record<string, AnimatedBodyParams> = {};
    for (const p of planetsData) {
      const isPrimary = p.scaleConfig.isPrimaryInZone.inner;
      const isVisible = p.scaleConfig.isVisibleInZone.inner;
      bodyAnimState[p.id] = {
        autoOrbitRadiusPx: p.scaleConfig.orbitRadiusPx.inner,
        auOrbitRadiusPx: computeZoneAuRadiusPx(p, 'inner'),
        displayEcc: getZoneDisplayEcc(p, 'inner'),
        bodySizePx: p.scaleConfig.bodySizePx.inner,
        opacity: isVisible ? (isPrimary ? 1.0 : 0.55) : 0.0,
        moonVisibility: isPrimary ? 1.0 : 0.0,
        labelVisibility: isPrimary ? 1.0 : 0.0,
      };
    }

    // 各天体の現在計算座標キャッシュ
    const planetWorldPos: Record<
      string,
      {
        x: number;
        y: number;
        auX: number;
        auY: number;
        helioDistAu: number;
        longitudeDeg: number;
        depthScale: number;
      }
    > = {};

    // DOM要素の参照取得
    const svgEl = document.getElementById('solar-svg') as SVGSVGElement | null;
    const cameraRigEl = document.getElementById('camera-rig') as SVGGElement | null;
    const eclipticGridEl = document.getElementById('ecliptic-grid') as SVGGElement | null;
    const beltsLayerEl = document.getElementById('belts-layer') as SVGGElement | null;
    const orbitsLayerEl = document.getElementById('orbits-layer') as SVGGElement | null;
    const bodiesLayerEl = document.getElementById('bodies-layer') as SVGGElement | null;
    const gridOuterRingEl = document.getElementById('grid-outer-ring') as SVGEllipseElement | null;
    const mainBeltGroupEl = document.getElementById('main-asteroid-belt') as SVGGElement | null;
    const mainBeltHaloEl = document.getElementById('main-belt-halo') as SVGEllipseElement | null;
    const mainBeltBandEl = document.getElementById('main-belt-band') as SVGEllipseElement | null;
    const kuiperBeltGroupEl = document.getElementById('kuiper-belt') as SVGGElement | null;
    const kuiperBeltHaloEl = document.getElementById('kuiper-belt-halo') as SVGEllipseElement | null;
    const kuiperBeltBandEl = document.getElementById('kuiper-belt-band') as SVGEllipseElement | null;

    // 惑星・衛星軌道拡大専用ビューDOM
    const moonSystemStageEl = document.getElementById('moon-system-stage') as SVGGElement | null;
    const msGridGroupEl = document.getElementById('ms-grid-group') as SVGGElement | null;
    const msOrbitsGroupEl = document.getElementById('ms-orbits-group') as SVGGElement | null;
    const msCentralPlanetGroupEl = document.getElementById('ms-central-planet-group') as SVGGElement | null;
    const msMoonsNodesGroupEl = document.getElementById('ms-moons-nodes-group') as SVGGElement | null;
    const moonSystemSwitcherEl = document.getElementById('moon-system-switcher');
    const btnMoonSystemModeEl = document.getElementById('btn-moon-system-mode');
    const btnExitMoonViewEl = document.getElementById('btn-exit-moon-view');
    const btnOpenMoonViewEl = document.getElementById('btn-open-moon-view');

    // 太陽DOM
    const sunSphereEl = document.getElementById('sun-sphere') as SVGCircleElement | null;
    const sunCoronaOuterEl = document.getElementById('sun-corona-outer') as SVGCircleElement | null;
    const sunCoronaInnerEl = document.getElementById('sun-corona-inner') as SVGCircleElement | null;
    const sunLabelEl = document.getElementById('sun-label') as SVGTextElement | null;
    const ceresMiniTextureEl = document.getElementById('ceres-mini-texture') as SVGGElement | null;
    const plutoMiniTextureEl = document.getElementById('pluto-mini-texture') as SVGGElement | null;

    // HUD・UI要素
    const hudDateEl = document.getElementById('hud-current-date');
    const hudJ2000El = document.getElementById('hud-j2000-days');
    const hudSpeedEl = document.getElementById('hud-speed-indicator');
    const hudZoneNameEl = document.getElementById('hud-zone-name');
    const hudZoneRangeEl = document.getElementById('hud-zone-range');
    const dateInputEl = document.getElementById('date-input') as HTMLInputElement | null;
    const timeSliderEl = document.getElementById('time-slider') as HTMLInputElement | null;
    const scrubberOffsetEl = document.getElementById('scrubber-offset-label');

    // ハンバーガーメニューDOM
    const btnHamburger = document.getElementById('btn-hamburger');
    const menuDrawerEl = document.getElementById('hamburger-menu-drawer');
    const menuBackdropEl = document.getElementById('menu-backdrop');
    const btnCloseDrawer = document.getElementById('btn-close-drawer');

    // 詳細パネル要素
    const detailPanelEl = document.getElementById('detail-panel');
    const detailSymbolEl = document.getElementById('detail-symbol');
    const detailClassBadgeEl = document.getElementById('detail-class-badge');
    const detailZoneBadgeEl = document.getElementById('detail-zone-badge');
    const detailNameJaEl = document.getElementById('detail-name-ja');
    const detailNameEnEl = document.getElementById('detail-name-en');
    const detailCategoryEl = document.getElementById('detail-category');
    const detailLiveBoxEl = document.getElementById('detail-live-box');
    const liveLongitudeEl = document.getElementById('live-longitude');
    const liveSunDistEl = document.getElementById('live-sun-dist');
    const liveEarthDistEl = document.getElementById('live-earth-dist');
    const specSmaEl = document.getElementById('spec-sma');
    const specPeriodEl = document.getElementById('spec-period');
    const specSpeedEl = document.getElementById('spec-speed');
    const specEccEl = document.getElementById('spec-ecc');
    const specDiameterEl = document.getElementById('spec-diameter');
    const specTempEl = document.getElementById('spec-temp');
    const detailDescEl = document.getElementById('detail-description');
    const detailInteriorSectionEl = document.getElementById('detail-interior-section');
    const detailInteriorBadgeEl = document.getElementById('detail-interior-badge');
    const detailInteriorSummaryEl = document.getElementById('detail-interior-summary');
    const detailInteriorSvgEl = document.getElementById('detail-interior-svg');
    const detailInteriorLegendEl = document.getElementById('detail-interior-legend');
    const detailInteriorListEl = document.getElementById('detail-interior-list');
    const detailRingsSectionEl = document.getElementById('detail-rings-section');
    const detailRingBadgeEl = document.getElementById('detail-ring-badge');
    const detailRingSummaryEl = document.getElementById('detail-ring-summary');
    const detailRingsListEl = document.getElementById('detail-rings-list');
    const detailMoonsSectionEl = document.getElementById('detail-moons-section');
    const detailMoonsHeadingEl = document.getElementById('detail-moons-heading');
    const detailMoonBadgeEl = document.getElementById('detail-moon-badge');
    const detailMoonsListEl = document.getElementById('detail-moons-list');

    // SVG内の各天体・軌道・衛星・多重環・彗星テイルDOMキャッシュ
    interface CachedMoonDom {
      data: PlanetData['moons'][number];
      orbitEl: SVGEllipseElement | null;
      nodeEl: SVGGElement | null;
      sphereEl: SVGCircleElement | null;
      labelEl: SVGTextElement | null;
    }

    interface CachedRingBandDom {
      band: NonNullable<PlanetData['ringSystem']>['bands'][number];
      aspectRatio: number;
      backEl: SVGEllipseElement | null;
      frontEl: SVGEllipseElement | null;
    }

    interface CachedPlanetDom {
      data: PlanetData;
      orbitEl: SVGPathElement | null;
      nodeEl: SVGGElement | null;
      sphereEl: SVGElement | null;
      ringBackGroupEl: SVGGElement | null;
      ringFrontGroupEl: SVGGElement | null;
      ringBands: CachedRingBandDom[];
      selRingEl: SVGCircleElement | null;
      hitEl: SVGCircleElement | null;
      labelGroupEl: SVGGElement | null;
      cometTailGroupEl: SVGGElement | null;
      cometTailPathEl: SVGPathElement | null;
      moonsGroupEl: SVGGElement | null;
      moons: CachedMoonDom[];
    }

    const cachedPlanets: CachedPlanetDom[] = planetsData.map((planet) => ({
      data: planet,
      orbitEl: document.getElementById(`orbit-${planet.id}`) as SVGPathElement | null,
      nodeEl: document.getElementById(`node-${planet.id}`) as SVGGElement | null,
      sphereEl: document.getElementById(`sphere-${planet.id}`) as SVGElement | null,
      ringBackGroupEl: document.getElementById(`ring-back-${planet.id}`) as SVGGElement | null,
      ringFrontGroupEl: document.getElementById(`ring-front-${planet.id}`) as SVGGElement | null,
      ringBands: (planet.ringSystem?.bands || []).map((band, bIdx) => ({
        band,
        aspectRatio: planet.ringSystem?.aspectRatio || 0.36,
        backEl: document.getElementById(`ring-back-band-${planet.id}-${bIdx}`) as SVGEllipseElement | null,
        frontEl: document.getElementById(`ring-front-band-${planet.id}-${bIdx}`) as SVGEllipseElement | null,
      })),
      selRingEl: document.getElementById(`sel-ring-${planet.id}`) as SVGCircleElement | null,
      hitEl: document.getElementById(`hit-${planet.id}`) as SVGCircleElement | null,
      labelGroupEl: document.getElementById(`label-group-${planet.id}`) as SVGGElement | null,
      cometTailGroupEl: document.getElementById(`comet-tail-${planet.id}`) as SVGGElement | null,
      cometTailPathEl: document.getElementById(`comet-tail-path-${planet.id}`) as SVGPathElement | null,
      moonsGroupEl: document.getElementById(`moons-group-${planet.id}`) as SVGGElement | null,
      moons: planet.moons.map((moon) => ({
        data: moon,
        orbitEl: document.getElementById(`moon-orbit-${moon.id}`) as SVGEllipseElement | null,
        nodeEl: document.getElementById(`moon-node-${moon.id}`) as SVGGElement | null,
        sphereEl: document.getElementById(`moon-sphere-${moon.id}`) as SVGCircleElement | null,
        labelEl: document.getElementById(`moon-label-${moon.id}`) as SVGTextElement | null,
      })),
    }));

    const mainBeltParticlesDom = Array.from(document.querySelectorAll<SVGCircleElement>('.main-particle')).map(
      (el) => ({
        el,
        angle: Number(el.dataset.angle || 0),
        offset: Number(el.dataset.offset || 0),
        ecc: Number(el.dataset.ecc || 0.025),
        periodDays: Number(el.dataset.period || 1650),
        visualSpeed: Number(el.dataset.vspeed || 0.035),
        baseOpacity: Number(el.dataset.opacity || 0.25),
        shimmerSpeed: Number(el.dataset.shimmer || 1.8),
        phase: Number(el.dataset.phase || 0),
      })
    );

    const kuiperBeltParticlesDom = Array.from(document.querySelectorAll<SVGCircleElement>('.kuiper-particle')).map(
      (el) => ({
        el,
        angle: Number(el.dataset.angle || 0),
        offset: Number(el.dataset.offset || 0),
        ecc: Number(el.dataset.ecc || 0.04),
        periodDays: Number(el.dataset.period || 90000),
        visualSpeed: Number(el.dataset.vspeed || 0.02),
        baseOpacity: Number(el.dataset.opacity || 0.22),
        shimmerSpeed: Number(el.dataset.shimmer || 1.5),
        phase: Number(el.dataset.phase || 0),
      })
    );

    const gridTicks = Array.from(document.querySelectorAll<SVGGElement>('.grid-tick')).map((el) => ({
      el,
      lineEl: el.querySelector('line'),
      textEl: el.querySelector('text'),
      deg: Number(el.dataset.deg || 0),
    }));

    /**
     * 画面幅がモバイル/タブレット縦向き（ボトムシート対象）かどうかを判定する
     */
    function isMobileSheetLayout(): boolean {
      return window.innerWidth <= 768;
    }

    function normalizeDegrees(deg: number): number {
      const mod = deg % 360;
      return mod < 0 ? mod + 360 : mod;
    }

    function lerp(a: number, b: number, t: number): number {
      return a + (b - a) * t;
    }

    /**
     * ケプラー方程式 M = E - e * sin(E) をニュートン法で解く（高離心率の彗星にも対応するため8回反復）
     */
    function solveKeplerEquation(meanAnomalyRad: number, eccentricity: number): number {
      let E = eccentricity > 0.8 ? Math.PI : meanAnomalyRad;
      for (let i = 0; i < 8; i++) {
        const f = E - eccentricity * Math.sin(E) - meanAnomalyRad;
        const fPrime = 1 - eccentricity * Math.cos(E);
        E = E - f / Math.max(0.05, fPrime);
      }
      return E;
    }

    /**
     * 焦点ズレ・離心率・近日点黄経・3Dチルトを反映した軌道上の2D投影座標を算出する
     */
    function computeOrbitPointPx(
      eccentricAnomalyRad: number,
      semiMajorPx: number,
      displayEccentricity: number,
      perihelionDeg: number,
      tiltY: number
    ): { x: number; y: number; sin2D: number } {
      const semiMinorPx = semiMajorPx * Math.sqrt(Math.max(0.01, 1 - displayEccentricity * displayEccentricity));
      const localX = semiMajorPx * (Math.cos(eccentricAnomalyRad) - displayEccentricity);
      const localY = semiMinorPx * Math.sin(eccentricAnomalyRad);

      const periRad = -perihelionDeg * DEG_TO_RAD;
      const cosP = Math.cos(periRad);
      const sinP = Math.sin(periRad);

      const x2d = localX * cosP - localY * sinP;
      const y2d = localX * sinP + localY * cosP;

      return {
        x: x2d,
        y: y2d * tiltY,
        sin2D: y2d / Math.max(1, semiMajorPx),
      };
    }

    /**
     * ケプラー楕円軌道のSVG Pathデータ文字列を生成する
     */
    function buildOrbitPathD(
      semiMajorPx: number,
      displayEccentricity: number,
      perihelionDeg: number,
      tiltY: number
    ): string {
      const steps = 96;
      const parts: string[] = [];
      for (let i = 0; i <= steps; i++) {
        const E = (i / steps) * Math.PI * 2;
        const pt = computeOrbitPointPx(E, semiMajorPx, displayEccentricity, perihelionDeg, tiltY);
        parts.push(`${i === 0 ? 'M' : 'L'}${pt.x.toFixed(1)},${pt.y.toFixed(1)}`);
      }
      parts.push('Z');
      return parts.join(' ');
    }

    function formatDaysToDateString(days: number): string {
      const ms = j2000Timestamp + days * MS_PER_DAY;
      const d = new Date(ms);
      const year = d.getUTCFullYear();
      const month = String(d.getUTCMonth() + 1).padStart(2, '0');
      const day = String(d.getUTCDate()).padStart(2, '0');
      return `${year}-${month}-${day}`;
    }

    /**
     * 太陽・黄経グリッド・小惑星帯・カイパーベルトの描画を更新する
     */
    function updateSunGridAndBelts() {
      const tiltY = simState.tiltY;
      const sunR = simState.sunRadiusPx;

      if (sunSphereEl) sunSphereEl.setAttribute('r', sunR.toFixed(2));
      if (sunCoronaInnerEl) sunCoronaInnerEl.setAttribute('r', (sunR * 1.25).toFixed(2));
      if (sunCoronaOuterEl) sunCoronaOuterEl.setAttribute('r', (sunR * 1.62).toFixed(2));
      if (sunLabelEl) {
        sunLabelEl.setAttribute('y', (sunR + 13).toFixed(1));
        sunLabelEl.style.opacity = simState.activeZone === 'tno' ? '0.6' : '1';
      }

      const maxRadius = 575;
      if (gridOuterRingEl) {
        gridOuterRingEl.setAttribute('rx', maxRadius.toFixed(1));
        gridOuterRingEl.setAttribute('ry', (maxRadius * tiltY).toFixed(1));
      }
      const innerSpokeStart = Math.max(20, sunR + 12);
      for (const tick of gridTicks) {
        const rad = -tick.deg * DEG_TO_RAD;
        const cosA = Math.cos(rad);
        const sinA = Math.sin(rad);
        const x2 = cosA * maxRadius;
        const y2 = sinA * maxRadius * tiltY;
        const lx = cosA * (maxRadius + 22);
        const ly = sinA * (maxRadius + 22) * tiltY + 4;
        if (tick.lineEl) {
          tick.lineEl.setAttribute('x1', (cosA * innerSpokeStart).toFixed(1));
          tick.lineEl.setAttribute('y1', (sinA * innerSpokeStart * tiltY).toFixed(1));
          tick.lineEl.setAttribute('x2', x2.toFixed(1));
          tick.lineEl.setAttribute('y2', y2.toFixed(1));
        }
        if (tick.textEl) {
          tick.textEl.setAttribute('x', lx.toFixed(1));
          tick.textEl.setAttribute('y', ly.toFixed(1));
        }
      }

      const d = simState.elapsedDays;
      const animT = simState.visualAnimSec;
      const auBlend = simState.auRatioBlend;
      const TAU = Math.PI * 2;
      const tiltDepthFactor = 1 - tiltY;

      // 小惑星帯（メインベルト）の多層半透明バンド＆240個の透明微惑星粒子のケプラー公転・煌めき更新
      if (mainBeltGroupEl) {
        mainBeltGroupEl.style.opacity = simState.mainBeltOpacity.toFixed(2);
        mainBeltGroupEl.style.display = simState.mainBeltOpacity < 0.02 ? 'none' : 'block';
      }
      if (mainBeltBandEl && simState.mainBeltOpacity >= 0.02) {
        const ceresAuR = bodyAnimState['ceres']?.auOrbitRadiusPx ?? simState.mainBeltRadiusPx;
        const mainCenterR = lerp(simState.mainBeltRadiusPx, ceresAuR, auBlend);
        const mainWidth = simState.mainBeltWidthPx * lerp(1.0, 1.18, auBlend);

        if (mainBeltHaloEl) {
          mainBeltHaloEl.setAttribute('rx', mainCenterR.toFixed(1));
          mainBeltHaloEl.setAttribute('ry', (mainCenterR * tiltY).toFixed(1));
          mainBeltHaloEl.setAttribute('stroke-width', (mainWidth * 1.65).toFixed(1));
        }
        mainBeltBandEl.setAttribute('rx', mainCenterR.toFixed(1));
        mainBeltBandEl.setAttribute('ry', (mainCenterR * tiltY).toFixed(1));
        mainBeltBandEl.setAttribute('stroke-width', mainWidth.toFixed(1));

        for (const p of mainBeltParticlesDom) {
          // 反時計回り（順行）ケプラー公転 ＋ 実時間ドリフト
          const curAngle = p.angle - (TAU / p.periodDays) * d - p.visualSpeed * animT;
          const cosA = Math.cos(curAngle);
          const sinA = Math.sin(curAngle);
          const eccRadialWave = Math.cos(curAngle + p.phase) * p.ecc * mainWidth;
          const r = mainCenterR + p.offset * mainWidth + eccRadialWave;

          p.el.setAttribute('cx', (cosA * r).toFixed(1));
          p.el.setAttribute('cy', (sinA * r * tiltY).toFixed(1));

          // 3Dチルト時の奥行き透明度変調と微細なシンチレーション（透明感のゆらぎ）
          const shimmer = 0.78 + 0.22 * Math.sin(animT * p.shimmerSpeed + p.phase);
          const depthAlpha = 1 + sinA * tiltDepthFactor * 0.28;
          const alpha = Math.max(0.04, Math.min(0.75, p.baseOpacity * shimmer * depthAlpha));
          p.el.setAttribute('fill-opacity', alpha.toFixed(3));
        }
      }

      // エッジワース・カイパーベルトの多層半透明バンド＆320個の透明氷粒子のケプラー公転・煌めき更新
      if (kuiperBeltGroupEl) {
        kuiperBeltGroupEl.style.opacity = simState.kuiperBeltOpacity.toFixed(2);
        kuiperBeltGroupEl.style.display = simState.kuiperBeltOpacity < 0.02 ? 'none' : 'block';
      }
      if (kuiperBeltBandEl && simState.kuiperBeltOpacity >= 0.02) {
        const haumeaAuR = bodyAnimState['haumea']?.auOrbitRadiusPx ?? simState.kuiperBeltRadiusPx;
        const kuiperCenterR = lerp(simState.kuiperBeltRadiusPx, haumeaAuR, auBlend);
        const kuiperWidth = simState.kuiperBeltWidthPx * lerp(1.0, 1.12, auBlend);

        if (kuiperBeltHaloEl) {
          kuiperBeltHaloEl.setAttribute('rx', kuiperCenterR.toFixed(1));
          kuiperBeltHaloEl.setAttribute('ry', (kuiperCenterR * tiltY).toFixed(1));
          kuiperBeltHaloEl.setAttribute('stroke-width', (kuiperWidth * 1.55).toFixed(1));
        }
        kuiperBeltBandEl.setAttribute('rx', kuiperCenterR.toFixed(1));
        kuiperBeltBandEl.setAttribute('ry', (kuiperCenterR * tiltY).toFixed(1));
        kuiperBeltBandEl.setAttribute('stroke-width', kuiperWidth.toFixed(1));

        for (const p of kuiperBeltParticlesDom) {
          const curAngle = p.angle - (TAU / p.periodDays) * d - p.visualSpeed * animT;
          const cosA = Math.cos(curAngle);
          const sinA = Math.sin(curAngle);
          const eccRadialWave = Math.cos(curAngle + p.phase) * p.ecc * kuiperWidth;
          const r = kuiperCenterR + p.offset * kuiperWidth + eccRadialWave;

          p.el.setAttribute('cx', (cosA * r).toFixed(1));
          p.el.setAttribute('cy', (sinA * r * tiltY).toFixed(1));

          const shimmer = 0.76 + 0.24 * Math.sin(animT * p.shimmerSpeed + p.phase);
          const depthAlpha = 1 + sinA * tiltDepthFactor * 0.28;
          const alpha = Math.max(0.04, Math.min(0.72, p.baseOpacity * shimmer * depthAlpha));
          p.el.setAttribute('fill-opacity', alpha.toFixed(3));
        }
      }
    }

    /**
     * 全22天体（8惑星・5公認準惑星・4準惑星候補・5周期彗星）および全衛星の軌道位置を更新するメイン関数
     */
    function renderSolarSystem() {
      const d = simState.elapsedDays;
      const tiltY = simState.tiltY;
      const auBlend = simState.auRatioBlend;

      const invZoomLabelScale = 1 / Math.pow(Math.max(1, simState.cameraZoom), 0.55);

      updateSunGridAndBelts();

      for (const item of cachedPlanets) {
        const p = item.data;
        const anim = bodyAnimState[p.id];

        const isSelected = simState.selectedBodyId === p.id;
        const isComet = p.bodyClass === 'comet';

        // 彗星表示がOFFのときは選択時以外非表示
        if (isComet && !simState.showComets && !isSelected) {
          if (item.orbitEl) item.orbitEl.style.display = 'none';
          if (item.nodeEl) item.nodeEl.style.display = 'none';
          continue;
        }

        const effectiveOpacity = isSelected ? 1.0 : anim.opacity;

        if (effectiveOpacity < 0.02) {
          if (item.orbitEl) item.orbitEl.style.display = 'none';
          if (item.nodeEl) item.nodeEl.style.display = 'none';
          continue;
        }
        if (item.orbitEl) item.orbitEl.style.display = 'block';
        if (item.nodeEl) item.nodeEl.style.display = 'block';

        const displaySemiMajorPx = lerp(anim.autoOrbitRadiusPx, anim.auOrbitRadiusPx, auBlend);
        const displayEcc = anim.displayEcc;
        const isDwarfOrCandidate = p.bodyClass === 'dwarf_planet' || p.bodyClass === 'dwarf_candidate';

        // 軌道パスの更新
        if (item.orbitEl) {
          item.orbitEl.setAttribute(
            'd',
            buildOrbitPathD(displaySemiMajorPx, displayEcc, p.perihelionLongitudeDeg, tiltY)
          );
          let orbitAlpha = effectiveOpacity;
          if (simState.highlightDwarfs && !simState.highlightComets) {
            orbitAlpha = isDwarfOrCandidate ? 1.0 : effectiveOpacity * 0.18;
          } else if (simState.highlightComets && !simState.highlightDwarfs) {
            orbitAlpha = isComet ? 1.0 : effectiveOpacity * 0.18;
          } else if (simState.highlightDwarfs && simState.highlightComets) {
            orbitAlpha = isDwarfOrCandidate || isComet ? 1.0 : effectiveOpacity * 0.18;
          }
          item.orbitEl.style.opacity = orbitAlpha.toFixed(2);
        }

        // 平均近点角 M とケプラー方程式の解 E（負の公転周期＝逆行公転にも対応）
        const meanMotionDegPerDay = 360 / p.orbitalPeriodDays;
        const meanAnomalyDeg = normalizeDegrees(
          p.meanLongitudeDeg - p.perihelionLongitudeDeg + meanMotionDegPerDay * d
        );
        const meanAnomalyRad = meanAnomalyDeg * DEG_TO_RAD;
        const eccentricAnomalyRad = solveKeplerEquation(meanAnomalyRad, p.eccentricity);

        // 真近点角 ν と実際の日心距離 r (AU)
        const sinHalfE = Math.sin(eccentricAnomalyRad / 2);
        const cosHalfE = Math.cos(eccentricAnomalyRad / 2);
        const sqrtFactor = Math.sqrt((1 + p.eccentricity) / Math.max(0.001, 1 - p.eccentricity));
        const trueAnomalyRad = 2 * Math.atan2(sqrtFactor * sinHalfE, cosHalfE);
        const trueLongitudeDeg = normalizeDegrees(p.perihelionLongitudeDeg + trueAnomalyRad * RAD_TO_DEG);
        const helioDistAu = p.semiMajorAxisAu * (1 - p.eccentricity * Math.cos(eccentricAnomalyRad));

        // 軌道パス上の現在座標 (px, py)
        const dispOrbitEra = solveKeplerEquation(meanAnomalyRad, displayEcc);
        const posPx = computeOrbitPointPx(
          dispOrbitEra,
          displaySemiMajorPx,
          displayEcc,
          p.perihelionLongitudeDeg,
          tiltY
        );

        const tiltAmount = 1 - tiltY;
        const depthScale = 1 + Math.max(-0.8, Math.min(0.8, posPx.sin2D)) * tiltAmount * 0.2;

        const trueLongRad = -trueLongitudeDeg * DEG_TO_RAD;
        const auX = Math.cos(trueLongRad) * helioDistAu;
        const auY = Math.sin(trueLongRad) * helioDistAu;

        planetWorldPos[p.id] = {
          x: posPx.x,
          y: posPx.y,
          auX,
          auY,
          helioDistAu,
          longitudeDeg: trueLongitudeDeg,
          depthScale,
        };

        // 彗星の場合：太陽の反対方向（反太陽方向）へ尾を向け、太陽に近いほど尾を長く輝かせる
        if (isComet && item.cometTailGroupEl && item.cometTailPathEl) {
          const antiSunAngleDeg = Math.atan2(posPx.y, posPx.x) * RAD_TO_DEG;
          // 近日点に近いほど尾が長くなる（22px 〜 62px）
          const proximityFactor = Math.max(0.18, Math.min(1.0, 2.2 / Math.max(0.4, helioDistAu)));
          const tailLen = 18 + proximityFactor * 44;
          const tailHalfWidth = anim.bodySizePx * 0.72;
          item.cometTailPathEl.setAttribute(
            'd',
            `M 0,-${tailHalfWidth.toFixed(1)} L ${tailLen.toFixed(1)},0 L 0,${tailHalfWidth.toFixed(1)} Z`
          );
          item.cometTailGroupEl.setAttribute('transform', `rotate(${antiSunAngleDeg.toFixed(1)})`);
          item.cometTailGroupEl.style.opacity = (0.45 + proximityFactor * 0.55).toFixed(2);
        }

        // 天体球体サイズ・多重環（リング）・選択リングの動的サイズ更新
        const bodyR = anim.bodySizePx;
        if (item.sphereEl) {
          if (p.id === 'haumea') {
            item.sphereEl.setAttribute('rx', (bodyR * 1.32).toFixed(2));
            item.sphereEl.setAttribute('ry', (bodyR * 0.82).toFixed(2));
          } else {
            item.sphereEl.setAttribute('r', bodyR.toFixed(2));
            if (p.id === 'ceres' && ceresMiniTextureEl) {
              ceresMiniTextureEl.setAttribute('transform', `scale(${(bodyR / 5.8).toFixed(3)})`);
            }
            if (p.id === 'pluto' && plutoMiniTextureEl) {
              plutoMiniTextureEl.setAttribute('transform', `scale(${(bodyR / 6.4).toFixed(3)})`);
            }
          }
        }
        if (item.ringBands.length > 0) {
          // 巨大惑星（木星・土星・天王星・海王星）の環強調モードまたは選択時にサイズ・太さ・輝度をブースト
          const isGiantRinged = p.subGroup === 'outer_planet';
          const ringScaleBoost =
            isGiantRinged && simState.emphasizeRings ? (isSelected ? 1.24 : 1.15) : isSelected ? 1.12 : 1.0;
          const ringStrokeBoost =
            isGiantRinged && simState.emphasizeRings ? (isSelected ? 1.42 : 1.25) : 1.0;
          const sizeRatio = Math.max(0.55, bodyR / 10.5);

          for (const rb of item.ringBands) {
            const rx = bodyR * rb.band.radiusMultiplier * ringScaleBoost;
            const ry = rx * rb.aspectRatio;
            const sw = Math.max(0.75, rb.band.strokeWidthPx * sizeRatio * ringStrokeBoost);
            const frontOpacity = Math.min(
              1.0,
              rb.band.opacity * (isGiantRinged && simState.emphasizeRings ? 1.12 : 1.0)
            );
            const backOpacity = frontOpacity * 0.82;

            if (rb.backEl) {
              rb.backEl.setAttribute('rx', rx.toFixed(2));
              rb.backEl.setAttribute('ry', ry.toFixed(2));
              rb.backEl.setAttribute('stroke-width', sw.toFixed(2));
              rb.backEl.setAttribute('stroke-opacity', backOpacity.toFixed(2));
            }
            if (rb.frontEl) {
              rb.frontEl.setAttribute('rx', rx.toFixed(2));
              rb.frontEl.setAttribute('ry', ry.toFixed(2));
              rb.frontEl.setAttribute('stroke-width', sw.toFixed(2));
              rb.frontEl.setAttribute('stroke-opacity', frontOpacity.toFixed(2));
            }
          }
        }
        if (item.selRingEl) {
          const maxRingMult =
            p.ringSystem && p.ringSystem.bands.length > 0
              ? p.ringSystem.bands[p.ringSystem.bands.length - 1].radiusMultiplier * 1.15
              : 1.0;
          item.selRingEl.setAttribute('r', Math.max(bodyR + 5.5, bodyR * maxRingMult + 3.5).toFixed(2));
        }
        if (item.hitEl) {
          item.hitEl.setAttribute('r', Math.max(bodyR + 10, 16).toFixed(1));
        }

        // 天体ノードの配置更新
        if (item.nodeEl) {
          item.nodeEl.setAttribute(
            'transform',
            `translate(${posPx.x.toFixed(2)}, ${posPx.y.toFixed(2)}) scale(${depthScale.toFixed(3)})`
          );
          let nodeAlpha = effectiveOpacity;
          if (!isSelected) {
            if (simState.highlightDwarfs && !simState.highlightComets) {
              nodeAlpha = isDwarfOrCandidate ? 1.0 : effectiveOpacity * 0.28;
            } else if (simState.highlightComets && !simState.highlightDwarfs) {
              nodeAlpha = isComet ? 1.0 : effectiveOpacity * 0.28;
            } else if (simState.highlightDwarfs && simState.highlightComets) {
              nodeAlpha = isDwarfOrCandidate || isComet ? 1.0 : effectiveOpacity * 0.28;
            }
          }
          item.nodeEl.style.opacity = nodeAlpha.toFixed(2);
          item.nodeEl.classList.toggle('is-compact-body', anim.labelVisibility < 0.4 && !isSelected);
        }

        // 衛星システムの更新
        const showThisMoons = simState.showMoons && (anim.moonVisibility > 0.15 || isSelected);
        if (item.moonsGroupEl) {
          item.moonsGroupEl.style.display = showThisMoons ? 'block' : 'none';
          item.moonsGroupEl.style.opacity = isSelected ? '1' : anim.moonVisibility.toFixed(2);
        }

        let maxMoonVerticalReach = 0;

        if (showThisMoons && item.moons.length > 0) {
          const moonOrbitScale = isSelected ? 1.15 : lerp(0.55, 1.0, anim.moonVisibility);

          const effectiveDaysForMoons =
            simState.speedDaysPerSec > 12 && simState.isPlaying
              ? d * (6 / simState.speedDaysPerSec)
              : d;

          // 3D斜めチルト視点へのブレンド率 (2D真上=0.0 ⇔ 3D斜め=1.0)
          const view3dFactor = Math.max(0, Math.min(1, (1.0 - tiltY) / (1.0 - 0.44)));
          // 天王星は3Dビュー時に衛星軌道も環と同じ横倒し赤道面（76°傾斜・縦長楕円）へ傾ける
          const isUranus = p.id === 'uranus';
          const moonPlaneTiltDeg = isUranus ? (p.ringSystem?.tiltDeg ?? 76) * view3dFactor : 0;
          const moonPlaneTiltRad = moonPlaneTiltDeg * DEG_TO_RAD;
          const cosPlane = Math.cos(moonPlaneTiltRad);
          const sinPlane = Math.sin(moonPlaneTiltRad);
          const uranusAspect = lerp(1.0, p.ringSystem?.aspectRatio ?? 0.36, view3dFactor);

          for (const mItem of item.moons) {
            const m = mItem.data;
            const mRx = m.orbitRadiusPx * moonOrbitScale;
            const mRy = isUranus ? mRx * uranusAspect : mRx * tiltY;
            const verticalReach = Math.hypot(mRx * sinPlane, mRy * cosPlane);
            if (verticalReach > maxMoonVerticalReach) maxMoonVerticalReach = verticalReach;

            if (mItem.orbitEl) {
              mItem.orbitEl.setAttribute('rx', mRx.toFixed(2));
              mItem.orbitEl.setAttribute('ry', mRy.toFixed(2));
              if (isUranus && moonPlaneTiltDeg > 0.1) {
                mItem.orbitEl.setAttribute('transform', `rotate(${moonPlaneTiltDeg.toFixed(2)})`);
              } else {
                mItem.orbitEl.removeAttribute('transform');
              }
            }

            const moonAngleDeg = normalizeDegrees(
              m.initialAngleDeg + (360 / m.orbitalPeriodDays) * effectiveDaysForMoons
            );
            const moonRad = -moonAngleDeg * DEG_TO_RAD;
            const cosM = Math.cos(moonRad);
            const sinM = Math.sin(moonRad);
            const localMx = cosM * mRx;
            const localMy = sinM * mRy;
            const mx = isUranus ? localMx * cosPlane - localMy * sinPlane : localMx;
            const my = isUranus ? localMx * sinPlane + localMy * cosPlane : localMy;

            if (mItem.nodeEl) {
              mItem.nodeEl.setAttribute('transform', `translate(${mx.toFixed(2)}, ${my.toFixed(2)})`);
              mItem.nodeEl.classList.toggle('is-highlighted', simState.highlightedMoonId === m.id);
            }

            if (mItem.labelEl) {
              const distFromCenter = Math.hypot(mx, my) || 1;
              const dirX = mx / distFromCenter;
              const dirY = my / distFromCenter;
              const labelOffsetR = m.sizePx + 5.5;
              const lx = dirX * labelOffsetR;
              const ly = dirY * labelOffsetR + 1.5;
              mItem.labelEl.setAttribute('x', lx.toFixed(1));
              mItem.labelEl.setAttribute('y', ly.toFixed(1));
              if (dirX > 0.35) {
                mItem.labelEl.setAttribute('text-anchor', 'start');
              } else if (dirX < -0.35) {
                mItem.labelEl.setAttribute('text-anchor', 'end');
              } else {
                mItem.labelEl.setAttribute('text-anchor', 'middle');
              }
            }
          }
        }

        // 天体名ラベルの位置調整
        if (item.labelGroupEl) {
          const labelY = isSelected
            ? Math.max(bodyR + 13, maxMoonVerticalReach + 12)
            : bodyR + 13;
          item.labelGroupEl.setAttribute(
            'transform',
            `translate(0, ${labelY.toFixed(1)}) scale(${invZoomLabelScale.toFixed(3)})`
          );
        }
      }

      // 選択中の天体がある場合、カメラ位置を天体の現在座標へスムーズに追従させる（太陽系全体ビュー時のみ）
      if (!simState.isMoonSystemView) {
        if (simState.selectedBodyId !== 'overview' && simState.selectedBodyId !== 'sun') {
          const targetPos = planetWorldPos[simState.selectedBodyId];
          if (targetPos) {
            simState.cameraX += (targetPos.x - simState.cameraX) * 0.18;
            simState.cameraY += (targetPos.y - simState.cameraY) * 0.18;
          }
        } else if (simState.selectedBodyId === 'sun') {
          simState.cameraX += (0 - simState.cameraX) * 0.18;
          simState.cameraY += (0 - simState.cameraY) * 0.18;
        }
      } else {
        renderMoonSystemView();
      }

      if (cameraRigEl) {
        const z = simState.cameraZoom;
        const tx = -simState.cameraX * z;
        const ty = -simState.cameraY * z;
        cameraRigEl.setAttribute(
          'transform',
          `translate(${tx.toFixed(2)}, ${ty.toFixed(2)}) scale(${z.toFixed(4)})`
        );
      }

      // HUDの日付表示と詳細パネルのリアルタイム数値を更新
      const dateStr = formatDaysToDateString(d);
      if (hudDateEl) hudDateEl.textContent = dateStr;
      if (hudJ2000El) {
        const sign = d >= 0 ? '+' : '';
        hudJ2000El.textContent = `J2000.0 から ${sign}${d.toLocaleString('ja-JP', {
          minimumFractionDigits: 1,
          maximumFractionDigits: 1,
        })} 日`;
      }
      if (dateInputEl && document.activeElement !== dateInputEl) {
        dateInputEl.value = dateStr;
      }

      if (simState.selectedBodyId !== 'overview' && simState.selectedBodyId !== 'sun') {
        const pPos = planetWorldPos[simState.selectedBodyId];
        const earthPos = planetWorldPos['earth'];
        if (pPos && earthPos) {
          if (liveLongitudeEl) liveLongitudeEl.textContent = `${pPos.longitudeDeg.toFixed(1)}°`;
          if (liveSunDistEl) liveSunDistEl.textContent = `${pPos.helioDistAu.toFixed(2)} AU`;
          if (liveEarthDistEl) {
            if (simState.selectedBodyId === 'earth') {
              liveEarthDistEl.textContent = '0.000 AU (基準)';
            } else {
              const distFromEarth = Math.hypot(pPos.auX - earthPos.auX, pPos.auY - earthPos.auY);
              liveEarthDistEl.textContent = `${distFromEarth.toFixed(2)} AU`;
            }
          }
        }
      }
    }

    // GSAP Ticker によるメインループ制御
    let lastTickerTime = gsap.ticker.time;
    gsap.ticker.add(() => {
      const nowTime = gsap.ticker.time;
      const dt = Math.min(nowTime - lastTickerTime, 0.1);
      lastTickerTime = nowTime;

      if (simState.isPlaying) {
        const deltaDays = dt * simState.speedDaysPerSec * simState.direction;
        simState.elapsedDays += deltaDays;
        simState.sliderAnchorDays += deltaDays;
        simState.visualAnimSec += dt * simState.direction;
      }

      renderSolarSystem();
    });

    function updateSpeedHud() {
      if (!hudSpeedEl) return;
      if (!simState.isPlaying) {
        hudSpeedEl.textContent = '⏸ 一時停止中';
        hudSpeedEl.classList.add('paused');
        return;
      }
      hudSpeedEl.classList.remove('paused');
      const dirSymbol = simState.direction > 0 ? '▶' : '◀◀';
      const s = simState.speedDaysPerSec;
      let label = `${s}日 / 秒`;
      if (s < 1) label = '2.4時間 / 秒';
      else if (s === 120) label = '約4ヶ月 / 秒';
      else if (s === 1826.25) label = '5年 / 秒';
      hudSpeedEl.textContent = `${dirSymbol} ${label}`;
    }

    /**
     * ハンバーガーメニュー（ドロワー）の開閉制御
     */
    let isDrawerOpen = false;
    function setDrawerOpen(open: boolean) {
      isDrawerOpen = open;
      btnHamburger?.classList.toggle('is-open', open);
      btnHamburger?.setAttribute('aria-expanded', String(open));
      menuBackdropEl?.classList.toggle('is-visible', open);
      if (menuDrawerEl) {
        gsap.to(menuDrawerEl, {
          x: open ? 0 : 340,
          autoAlpha: open ? 1 : 0,
          duration: 0.35,
          ease: open ? 'power3.out' : 'power2.in',
        });
      }
    }

    btnHamburger?.addEventListener('click', () => {
      setDrawerOpen(!isDrawerOpen);
    });
    btnCloseDrawer?.addEventListener('click', () => {
      setDrawerOpen(false);
    });
    menuBackdropEl?.addEventListener('click', () => {
      setDrawerOpen(false);
    });

    /**
     * 詳細パネルの表示・非表示アニメーション（PCでは右スライド、スマホ・タブレットでは下部ボトムシート）
     */
    function animateDetailPanel(show: boolean) {
      if (!detailPanelEl) return;
      const mobile = isMobileSheetLayout();
      if (show) {
        gsap.to(detailPanelEl, {
          x: 0,
          y: 0,
          autoAlpha: 1,
          duration: 0.48,
          ease: 'power3.out',
        });
      } else {
        gsap.to(detailPanelEl, {
          x: mobile ? 0 : 420,
          y: mobile ? 480 : 0,
          autoAlpha: 0,
          duration: 0.38,
          ease: 'power2.in',
        });
      }
    }

