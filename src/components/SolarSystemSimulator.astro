      // ケレス専用：探査機ドーン（Dawn）擬似カラー実写に基づく地表テクスチャ（黄褐色〜灰褐色レゴリス、多数のクレーター群、
      // 青紫色のイジェクタ平原、青白く輝くオッカトル・クレーターのケレアリア白斑＆ヴィナリア白斑群、氷火山アフナ山）
      // および地下塩水（ブライン）の熱水亀裂湧出・氷火山ドーム活動・水蒸気＆塩分氷プルーム噴出の地質活動アニメーション
      if (targetId === 'ceres') {
        const beltFieldGroup = document.createElementNS(svgNs, 'g');
        const beltParticles: {
          el: SVGCircleElement;
          baseX: number;
          baseY: number;
          speedX: number;
          ampY: number;
          baseAlpha: number;
          phase: number;
        }[] = [];
        const beltColors = ['#bef264', '#d9f99d', '#fde68a', '#cbd5e1'];
        for (let i = 0; i < 44; i++) {
          const bx = (i * 73) % 960 - 480;
          const by = (i * 59) % 720 - 360;
          const isHalo = i % 5 === 0;
          const rPx = isHalo ? 2.6 + (i % 3) * 0.5 : 1.0 + (i % 3) * 0.45;
          const baseAlpha = isHalo ? 0.11 : 0.22 + (i % 4) * 0.06;
          const dot = document.createElementNS(svgNs, 'circle');
          dot.setAttribute('r', rPx.toFixed(2));
          dot.setAttribute('fill', beltColors[i % beltColors.length]);
          beltFieldGroup.appendChild(dot);
          beltParticles.push({
            el: dot,
            baseX: bx,
            baseY: by,
            speedX: 14 + (i % 5) * 4.5,
            ampY: 4 + (i % 4) * 2.5,
            baseAlpha,
            phase: (i * 0.65) % (Math.PI * 2),
          });
        }
        msGridGroupEl.appendChild(beltFieldGroup);

        // 1. 南東〜右下の明るい黄褐色高地パッチと左上側の暗色炭素質レゴリス陰影
        const warmHighland = document.createElementNS(svgNs, 'path');
        warmHighland.setAttribute(
          'd',
          'M 8,6 C 32,-6 58,2 72,22 C 68,52 40,72 4,74 C -10,56 -6,24 8,6 Z'
        );
        warmHighland.setAttribute('fill', 'rgba(229, 216, 178, 0.28)');
        atmoClipGroupEl.appendChild(warmHighland);

        const darkNorthWest = document.createElementNS(svgNs, 'path');
        darkNorthWest.setAttribute(
          'd',
          'M -76,-12 C -68,-52 -32,-74 4,-76 L -4,-18 C -30,-12 -54,-6 -76,-12 Z'
        );
        darkNorthWest.setAttribute('fill', 'rgba(28, 25, 20, 0.42)');
        atmoClipGroupEl.appendChild(darkNorthWest);

        // 2. オッカトル・クレーター周辺から中央下〜左下へ広がる青紫色イジェクタ（放出物）ブランケット平原
        const blueEjectaOuter = document.createElementNS(svgNs, 'path');
        blueEjectaOuter.setAttribute(
          'd',
          'M -42,-16 C -22,-30 6,-24 18,-4 C 28,16 24,48 4,64 C -20,68 -46,48 -52,20 C -54,2 -50,-10 -42,-16 Z'
        );
        blueEjectaOuter.setAttribute('fill', 'rgba(99, 118, 192, 0.34)');
        atmoClipGroupEl.appendChild(blueEjectaOuter);

        const blueEjectaInner = document.createElementNS(svgNs, 'ellipse');
        blueEjectaInner.setAttribute('cx', '-12');
        blueEjectaInner.setAttribute('cy', '14');
        blueEjectaInner.setAttribute('rx', '26');
        blueEjectaInner.setAttribute('ry', '30');
        blueEjectaInner.setAttribute('fill', 'rgba(147, 168, 238, 0.26)');
        blueEjectaInner.setAttribute('transform', 'rotate(-18 -12 14)');
        atmoClipGroupEl.appendChild(blueEjectaInner);

        // 3. ケレス全面を覆う大小の衝突クレーター群（ドーン実写の凹凸質感）
        for (const cr of [
          { cx: -36, cy: -38, r: 9.5 },
          { cx: -18, cy: -48, r: 6.2 },
          { cx: -48, cy: -14, r: 7.4 },
          { cx: -52, cy: 14, r: 6.0 },
          { cx: -36, cy: 36, r: 8.8 },
          { cx: -14, cy: 52, r: 10.5 },
          { cx: 14, cy: 46, r: 8.2 },
          { cx: 38, cy: 36, r: 9.0 },
          { cx: 52, cy: 8, r: 7.5 },
          { cx: 24, cy: 12, r: 8.4 },
          { cx: 16, cy: -12, r: 6.8 },
          { cx: -6, cy: -32, r: 5.4 },
          { cx: -28, cy: -22, r: 4.8 },
          { cx: -26, cy: 22, r: 4.5 },
          { cx: 4, cy: 28, r: 5.2 },
          { cx: 42, cy: -8, r: 5.8 },
        ]) {
          const cEl = document.createElementNS(svgNs, 'circle');
          cEl.setAttribute('cx', String(cr.cx));
          cEl.setAttribute('cy', String(cr.cy));
          cEl.setAttribute('r', String(cr.r));
          cEl.setAttribute('fill', 'rgba(36, 33, 26, 0.44)');
          cEl.setAttribute('stroke', 'rgba(218, 208, 178, 0.42)');
          cEl.setAttribute('stroke-width', '1.0');
          atmoClipGroupEl.appendChild(cEl);
        }

        // 4. 地下塩水（ブライン）上昇通路の地殻熱水亀裂ネットワーク（オッカトル・クレーター＆アフナ山を結ぶ断裂帯）
        const brineFractures: SVGPathElement[] = [];
        for (const fPath of [
          'M -12,-5 L -26,-16 M -12,-5 L -28,8 M -12,-5 L -4,16 M -12,-5 L 8,2',
          'M 8,2 Q 22,10 35,18 M -4,16 Q -10,32 -18,44',
        ]) {
          const fEl = document.createElementNS(svgNs, 'path');
          fEl.setAttribute('d', fPath);
          fEl.setAttribute('fill', 'none');
          fEl.setAttribute('stroke', '#38bdf8');
          fEl.setAttribute('stroke-width', '1.35');
          fEl.setAttribute('stroke-dasharray', '3 2.5');
          fEl.setAttribute('stroke-linecap', 'round');
          atmoClipGroupEl.appendChild(fEl);
          brineFractures.push(fEl);
        }

        // 5. オッカトル・クレーター（cx=-12, cy=-5, 直径92km）と青白く輝く炭酸ナトリウム塩ドーム
        // （中央の「ケレアリア白斑 Cerealia Facula」＋ 東側の「ヴィナリア白斑群 Vinalia Faculae」）
        const occatorX = -12;
        const occatorY = -5;

        // クレーター周囲の暗青黒色イジェクタ・リング
        const occatorDarkHalo = document.createElementNS(svgNs, 'circle');
        occatorDarkHalo.setAttribute('cx', String(occatorX));
        occatorDarkHalo.setAttribute('cy', String(occatorY));
        occatorDarkHalo.setAttribute('r', '16.5');
        occatorDarkHalo.setAttribute('fill', 'rgba(23, 31, 66, 0.62)');
        atmoClipGroupEl.appendChild(occatorDarkHalo);

        // オッカトル・クレーター外壁と青暗いクレーター底
        const craterRingEl = document.createElementNS(svgNs, 'circle');
        craterRingEl.setAttribute('cx', String(occatorX));
        craterRingEl.setAttribute('cy', String(occatorY));
        craterRingEl.setAttribute('r', '12.2');
        craterRingEl.setAttribute('fill', 'rgba(30, 48, 102, 0.85)');
        craterRingEl.setAttribute('stroke', 'rgba(165, 180, 252, 0.72)');
        craterRingEl.setAttribute('stroke-width', '1.4');
        atmoClipGroupEl.appendChild(craterRingEl);

        // クレーター内部から広がる地下塩水湧出・氷火山パルスリング（2重アニメーション波）
        const brinePulseRings: { el: SVGCircleElement; phase: number }[] = [];
        for (let i = 0; i < 2; i++) {
          const pRing = document.createElementNS(svgNs, 'circle');
          pRing.setAttribute('cx', String(occatorX));
          pRing.setAttribute('cy', String(occatorY));
          pRing.setAttribute('fill', 'none');
          pRing.setAttribute('stroke', '#60a5fa');
          pRing.setAttribute('stroke-width', '1.4');
          atmoClipGroupEl.appendChild(pRing);
          brinePulseRings.push({ el: pRing, phase: i * 0.5 });
        }

        // 青白い塩ドーム発光ハロー
        const cerealiaGlowEl = document.createElementNS(svgNs, 'circle');
        cerealiaGlowEl.setAttribute('cx', String(occatorX));
        cerealiaGlowEl.setAttribute('cy', String(occatorY));
        cerealiaGlowEl.setAttribute('r', '10.5');
        cerealiaGlowEl.setAttribute('fill', 'url(#ceres-occator-glow)');
        atmoClipGroupEl.appendChild(cerealiaGlowEl);

        // 中央のケレアリア白斑（Cerealia Facula）純白コア
        const brightSpotEl = document.createElementNS(svgNs, 'circle');
        brightSpotEl.setAttribute('cx', String(occatorX));
        brightSpotEl.setAttribute('cy', String(occatorY));
        brightSpotEl.setAttribute('r', '3.8');
        brightSpotEl.setAttribute('fill', '#ffffff');
        brightSpotEl.setAttribute('filter', 'url(#planet-glow)');
        atmoClipGroupEl.appendChild(brightSpotEl);

        // 東隣に並ぶヴィナリア白斑群（Vinalia Faculae）
        for (const vf of [
          { dx: 5.2, dy: -1.4, r: 1.6 },
          { dx: 6.8, dy: 1.2, r: 1.3 },
          { dx: 4.4, dy: 2.4, r: 1.1 },
        ]) {
          const vfEl = document.createElementNS(svgNs, 'circle');
          vfEl.setAttribute('cx', (occatorX + vf.dx).toFixed(1));
          vfEl.setAttribute('cy', (occatorY + vf.dy).toFixed(1));
          vfEl.setAttribute('r', String(vf.r));
          vfEl.setAttribute('fill', '#e0f2fe');
          atmoClipGroupEl.appendChild(vfEl);
        }

        // 6. 右下側の氷火山ドーム「アフナ山 (Ahuna Mons)」（高さ約4kmの塩水氷火山ドーム）
        const ahunaX = 35;
        const ahunaY = 18;
        const ahunaBaseEl = document.createElementNS(svgNs, 'polygon');
        ahunaBaseEl.setAttribute(
          'points',
          `${ahunaX - 9},${ahunaY + 6} ${ahunaX},${ahunaY - 7} ${ahunaX + 9},${ahunaY + 6}`
        );
        ahunaBaseEl.setAttribute('fill', 'rgba(148, 163, 184, 0.65)');
        ahunaBaseEl.setAttribute('stroke', '#bae6fd');
        ahunaBaseEl.setAttribute('stroke-width', '1.1');
        atmoClipGroupEl.appendChild(ahunaBaseEl);

        const ahunaVentEl = document.createElementNS(svgNs, 'circle');
        ahunaVentEl.setAttribute('cx', String(ahunaX));
        ahunaVentEl.setAttribute('cy', String(ahunaY - 4));
        ahunaVentEl.setAttribute('r', '2.5');
        ahunaVentEl.setAttribute('fill', '#e0f2fe');
        atmoClipGroupEl.appendChild(ahunaVentEl);

        // 7. ハーシェル宇宙望遠鏡が検出した希薄水蒸気外気圏ハロー ＆
        // オッカトル・クレーターとアフナ山から噴出する水蒸気・ナトリウム塩氷クリオプルーム粒子群
        const waterExosphereRing = document.createElementNS(svgNs, 'circle');
        waterExosphereRing.setAttribute('cx', '0');
        waterExosphereRing.setAttribute('cy', '0');
        waterExosphereRing.setAttribute('r', (centralR * 1.12).toFixed(1));
        waterExosphereRing.setAttribute('fill', 'none');
        waterExosphereRing.setAttribute('stroke', 'rgba(125, 211, 252, 0.34)');
        waterExosphereRing.setAttribute('stroke-width', '4.2');
        waterExosphereRing.setAttribute('stroke-dasharray', '12 8');
        msCentralPlanetGroupEl.appendChild(waterExosphereRing);

        const plumeParticles: {
          el: SVGCircleElement;
          originX: number;
          originY: number;
          phase: number;
          angleRad: number;
          maxDist: number;
        }[] = [];
        // オッカトル・クレーターからの塩水蒸気プルーム（12粒子）＋ アフナ山氷火山からの噴出プルーム（6粒子）
        for (let i = 0; i < 18; i++) {
          const isAhuna = i >= 12;
          const pDot = document.createElementNS(svgNs, 'circle');
          pDot.setAttribute('r', (1.2 + (i % 3) * 0.48).toFixed(2));
          pDot.setAttribute('fill', i % 3 === 0 ? '#ffffff' : i % 2 === 0 ? '#93c5fd' : '#67e8f9');
          msCentralPlanetGroupEl.appendChild(pDot);
          const angleDeg = isAhuna
            ? -25 + (i - 14.5) * 14
            : -145 + (i - 5.5) * 11;
          plumeParticles.push({
            el: pDot,
            originX: isAhuna ? ahunaX : occatorX,
            originY: isAhuna ? ahunaY - 4 : occatorY,
            phase: i / 18,
            angleRad: angleDeg * DEG_TO_RAD,
            maxDist: isAhuna ? 46 : 68,
          });
        }

        atmoUpdaters.push((t) => {
          // 小惑星帯の半透明背景粒子ドリフト
          for (const bp of beltParticles) {
            const x = ((((bp.baseX + t * bp.speedX + 500) % 1000) + 1000) % 1000) - 500;
            const y = bp.baseY + Math.sin(t * 1.4 + bp.phase) * bp.ampY;
            const alpha = bp.baseAlpha * (0.72 + 0.28 * Math.sin(t * 2.1 + bp.phase));
            bp.el.setAttribute('cx', x.toFixed(1));
            bp.el.setAttribute('cy', y.toFixed(1));
            bp.el.setAttribute('fill-opacity', alpha.toFixed(3));
          }
          // 地下塩水（ブライン）亀裂の熱水脈動
          const fractureAlpha = 0.28 + (Math.sin(t * 2.8) * 0.5 + 0.5) * 0.48;
          for (const fEl of brineFractures) {
            fEl.setAttribute('stroke-opacity', fractureAlpha.toFixed(2));
            fEl.setAttribute('stroke-dashoffset', (-t * 8).toFixed(1));
          }
          // オッカトル・クレーター内部の塩水湧出リング拡大波
          for (const pr of brinePulseRings) {
            const prog = (((t * 0.45 + pr.phase) % 1) + 1) % 1;
            pr.el.setAttribute('r', (2.5 + prog * 11.5).toFixed(2));
            pr.el.setAttribute('stroke-opacity', ((1 - prog) * 0.85).toFixed(2));
          }
          // ケレアリア白斑＆アフナ山火口の輝度脈動
          cerealiaGlowEl.setAttribute('r', (9.8 + Math.sin(t * 3.2) * 1.8).toFixed(1));
          ahunaVentEl.setAttribute('fill-opacity', (0.65 + Math.sin(t * 3.6) * 0.35).toFixed(2));
          // 水蒸気外気圏リングのゆっくりとした回転と脈動
          waterExosphereRing.setAttribute('stroke-dashoffset', (t * 12).toFixed(1));
          waterExosphereRing.setAttribute('stroke-opacity', (0.24 + Math.sin(t * 2.0) * 0.12).toFixed(2));
          // 氷火山・水蒸気プルーム粒子の噴出
          for (const pp of plumeParticles) {
            const prog = (((t * 0.44 + pp.phase) % 1) + 1) % 1;
            const dist = 3 + prog * pp.maxDist;
            const px = pp.originX + Math.cos(pp.angleRad) * dist;
            const py = pp.originY + Math.sin(pp.angleRad) * dist;
            pp.el.setAttribute('cx', px.toFixed(1));
            pp.el.setAttribute('cy', py.toFixed(1));
            pp.el.setAttribute('fill-opacity', ((1 - prog) * 0.78).toFixed(2));
          }
        });
      }

      // 冥王星専用：ニュー・ホライズンズ実写に基づく地表テクスチャ（左下の暗赤褐色クトゥルフ領域 ＋ 右下のハート形トンボー領域/スプートニク平原）
      // および窒素氷の多角形対流セル湧出・昇華氷河風・多層青色窒素ヘイズ層の専用アニメーション
      if (targetId === 'pluto') {
        // 1. 北半球〜左上側の黄褐色・桃白色の縞状地形とクレーター群
        const northBand1 = document.createElementNS(svgNs, 'path');
        northBand1.setAttribute('d', 'M -52,-18 Q -15,-42 12,-48 L 6,-16 Q -22,-10 -52,-2 Z');
        northBand1.setAttribute('fill', 'rgba(247, 224, 202, 0.34)');
        atmoClipGroupEl.appendChild(northBand1);

        const northBand2 = document.createElementNS(svgNs, 'path');
        northBand2.setAttribute('d', 'M -46,-34 Q -12,-50 18,-52 L 10,-28 Q -18,-24 -46,-16 Z');
        northBand2.setAttribute('fill', 'rgba(181, 120, 82, 0.36)');
        atmoClipGroupEl.appendChild(northBand2);

        // 2. 左下側の暗赤褐色ソリン地帯「クトゥルフ領域 (Cthulhu Macula)」と右下の「クルン領域 (Krun Macula)」
        const cthulhuOuter = document.createElementNS(svgNs, 'path');
        cthulhuOuter.setAttribute(
          'd',
          'M -54,0 C -38,-4 -24,2 -14,10 C -10,18 -11,29 -4,39 C -1,44 -8,52 -22,54 C -40,54 -54,36 -54,0 Z'
        );
        cthulhuOuter.setAttribute('fill', '#4a2015');
        cthulhuOuter.setAttribute('fill-opacity', '0.88');
        atmoClipGroupEl.appendChild(cthulhuOuter);

        const cthulhuCore = document.createElementNS(svgNs, 'path');
        cthulhuCore.setAttribute(
          'd',
          'M -52,12 C -38,9 -24,14 -16,22 C -12,30 -12,38 -7,45 C -18,53 -38,50 -48,36 C -52,28 -53,19 -52,12 Z'
        );
        cthulhuCore.setAttribute('fill', '#2b1009');
        cthulhuCore.setAttribute('fill-opacity', '0.92');
        atmoClipGroupEl.appendChild(cthulhuCore);

        // 右下縁の暗色ソリン地帯「クルン領域 (Krun Macula)」
        const krunMacula = document.createElementNS(svgNs, 'path');
        krunMacula.setAttribute(
          'd',
          'M 18,34 C 26,24 38,18 52,16 C 52,34 40,48 22,52 C 16,48 14,40 18,34 Z'
        );
        krunMacula.setAttribute('fill', '#3f1b11');
        krunMacula.setAttribute('fill-opacity', '0.85');
        atmoClipGroupEl.appendChild(krunMacula);

        // クトゥルフ領域境界付近の明縁クレーター（エリオット・クレーター等）
        for (const cr of [
          { cx: -21, cy: 19, r: 2.8 },
          { cx: -28, cy: 8, r: 3.4 },
          { cx: -16, cy: -8, r: 4.1 },
        ]) {
          const cRing = document.createElementNS(svgNs, 'circle');
          cRing.setAttribute('cx', String(cr.cx));
          cRing.setAttribute('cy', String(cr.cy));
          cRing.setAttribute('r', String(cr.r));
          cRing.setAttribute('fill', 'rgba(92, 43, 27, 0.55)');
          cRing.setAttribute('stroke', 'rgba(245, 216, 190, 0.62)');
          cRing.setAttribute('stroke-width', '0.9');
          atmoClipGroupEl.appendChild(cRing);
        }

        // 3. ハート形の明るい地面「トンボー領域 (Tombaugh Regio)」全体シルエット（右下〜中央下に配置）
        const heartGroupEl = document.createElementNS(svgNs, 'g');
        heartGroupEl.setAttribute('transform', 'translate(9, 13) rotate(-13)');

        // ハート形全体（西側のスプートニク平原＋東側の高地ローブ）
        const heartFullPath = document.createElementNS(svgNs, 'path');
        heartFullPath.setAttribute(
          'd',
          'M 2,-5 C -4,-19 -23,-17 -24,0 C -25,15 -12,28 2,36 C 17,27 31,13 30,-2 C 29,-15 10,-16 2,-5 Z'
        );
        heartFullPath.setAttribute('fill', 'url(#pluto-heart-grad)');
        heartFullPath.setAttribute('stroke', 'rgba(217, 173, 139, 0.65)');
        heartFullPath.setAttribute('stroke-width', '1.1');
        heartGroupEl.appendChild(heartFullPath);

        // ハート右側ローブ（東トンボー領域のやや起伏ある明色氷高地）
        const eastLobePath = document.createElementNS(svgNs, 'path');
        eastLobePath.setAttribute(
          'd',
          'M 3,-4 C 9,-14 27,-13 28,-1 C 29,11 17,22 4,31 C 5,18 4,6 3,-4 Z'
        );
        eastLobePath.setAttribute('fill', 'rgba(235, 198, 168, 0.58)');
        heartGroupEl.appendChild(eastLobePath);

        // ハート左側ローブ「スプートニク平原 (Sputnik Planitia)」（最も滑らかで明るい乳白色〜桃白色の窒素氷河盆地）
        const sputnikLobePath = document.createElementNS(svgNs, 'path');
        sputnikLobePath.setAttribute(
          'd',
          'M 2,-5 C -4,-18 -21,-15 -22,0 C -23,14 -11,26 2,34 C 6,22 6,6 2,-5 Z'
        );
        sputnikLobePath.setAttribute('fill', '#fdf2e6');
        sputnikLobePath.setAttribute('fill-opacity', '0.94');
        heartGroupEl.appendChild(sputnikLobePath);

        // スプートニク平原西縁に連なる水氷山脈（アル・イドリシ山脈 / ヒラリー山脈）の陰影
        const montesShadow = document.createElementNS(svgNs, 'path');
        montesShadow.setAttribute(
          'd',
          'M -19,-7 C -23,0 -22,12 -14,22 C -8,28 -2,32 2,35'
        );
        montesShadow.setAttribute('fill', 'none');
        montesShadow.setAttribute('stroke', 'rgba(124, 63, 38, 0.72)');
        montesShadow.setAttribute('stroke-width', '2.1');
        montesShadow.setAttribute('stroke-dasharray', '4 2.5');
        heartGroupEl.appendChild(montesShadow);

        // 4. スプートニク平原内部の「窒素氷・多角形対流セル（Polygonal Convection Cells）」ネットワークと湧出アニメーション
        const cellMeshPath = document.createElementNS(svgNs, 'path');
        cellMeshPath.setAttribute(
          'd',
          'M -16,-4 L -8,-8 L -1,-3 L -3,6 L -12,8 Z M -12,8 L -3,6 L 1,15 L -6,21 L -14,16 Z M -1,-3 L 5,2 L 1,15 M -18,4 L -12,8'
        );
        cellMeshPath.setAttribute('fill', 'none');
        cellMeshPath.setAttribute('stroke', 'rgba(209, 159, 122, 0.58)');
        cellMeshPath.setAttribute('stroke-width', '0.95');
        heartGroupEl.appendChild(cellMeshPath);

        const convectionCells: { el: SVGCircleElement; cx: number; cy: number; maxR: number; phase: number }[] = [];
        for (const [idx, cellPos] of [
          { cx: -10, cy: -1, maxR: 5.2 },
          { cx: -5, cy: 11, maxR: 5.6 },
          { cx: -13, cy: 10, maxR: 4.6 },
          { cx: -2, cy: 2, maxR: 4.8 },
          { cx: -6, cy: 20, maxR: 4.4 },
          { cx: 9, cy: 5, maxR: 5.0 },
        ].entries()) {
          const cellEl = document.createElementNS(svgNs, 'circle');
          cellEl.setAttribute('cx', String(cellPos.cx));
          cellEl.setAttribute('cy', String(cellPos.cy));
          cellEl.setAttribute('fill', 'none');
          cellEl.setAttribute('stroke', '#ffffff');
          cellEl.setAttribute('stroke-width', '1.15');
          heartGroupEl.appendChild(cellEl);
          convectionCells.push({
            el: cellEl,
            cx: cellPos.cx,
            cy: cellPos.cy,
            maxR: cellPos.maxR,
            phase: idx / 6,
          });
        }

        // 5. ハート地形（スプートニク平原）から北西・西縁へ吹き出す窒素・メタン昇華氷河風ストリーク
        const glacialWinds: { el: SVGPathElement; speed: number }[] = [];
        for (const wCfg of [
          { d: 'M -6,-2 Q -18,-8 -32,-14', speed: -18 },
          { d: 'M -8,8 Q -22,6 -36,2', speed: -22 },
          { d: 'M -4,18 Q -18,20 -31,18', speed: -16 },
          { d: 'M 8,2 Q 18,-4 28,-8', speed: 15 },
        ]) {
          const wEl = document.createElementNS(svgNs, 'path');
          wEl.setAttribute('d', wCfg.d);
          wEl.setAttribute('fill', 'none');
          wEl.setAttribute('stroke', 'rgba(224, 242, 254, 0.68)');
          wEl.setAttribute('stroke-width', '1.35');
          wEl.setAttribute('stroke-linecap', 'round');
          wEl.setAttribute('stroke-dasharray', '6 8');
          heartGroupEl.appendChild(wEl);
          glacialWinds.push({ el: wEl, speed: wCfg.speed });
        }

        atmoClipGroupEl.appendChild(heartGroupEl);

        // 6. ニュー・ホライズンズ逆光撮影で発見された「幾重にも重なる青い窒素・メタン光化学ヘイズ層」と昇華散逸粒子
        const blueHazeLayers: { el: SVGCircleElement; baseMult: number; baseAlpha: number; phase: number }[] = [];
        for (const [idx, hCfg] of [
          { mult: 1.07, alpha: 0.46, color: '#38bdf8', width: 2.6 },
          { mult: 1.15, alpha: 0.30, color: '#7dd3fc', width: 2.0 },
          { mult: 1.24, alpha: 0.18, color: '#bae6fd', width: 1.4 },
        ].entries()) {
          const hCircle = document.createElementNS(svgNs, 'circle');
          hCircle.setAttribute('cx', '0');
          hCircle.setAttribute('cy', '0');
          hCircle.setAttribute('r', (centralR * hCfg.mult).toFixed(1));
          hCircle.setAttribute('fill', 'none');
          hCircle.setAttribute('stroke', hCfg.color);
          hCircle.setAttribute('stroke-width', String(hCfg.width));
          msCentralPlanetGroupEl.appendChild(hCircle);
          blueHazeLayers.push({
            el: hCircle,
            baseMult: hCfg.mult,
            baseAlpha: hCfg.alpha,
            phase: idx * 1.1,
          });
        }

        // ハート地形から外気圏へ昇華・流出する半透明の窒素・メタン分子粒子
        const n2EscapeParticles: { el: SVGCircleElement; angleRad: number; phase: number }[] = [];
        for (let i = 0; i < 14; i++) {
          const pDot = document.createElementNS(svgNs, 'circle');
          pDot.setAttribute('r', (1.2 + (i % 3) * 0.45).toFixed(2));
          pDot.setAttribute('fill', i % 2 === 0 ? '#bae6fd' : '#fef3c7');
          msCentralPlanetGroupEl.appendChild(pDot);
          n2EscapeParticles.push({
            el: pDot,
            angleRad: (-25 + i * 24) * DEG_TO_RAD,
            phase: i / 14,
          });
        }

        atmoUpdaters.push((t) => {
          // スプートニク平原の多角形窒素氷セルの対流湧出アニメーション
          for (const cell of convectionCells) {
            const prog = (((t * 0.34 + cell.phase) % 1) + 1) % 1;
            const curR = 0.8 + prog * cell.maxR;
            const alpha = Math.sin(prog * Math.PI) * 0.72;
            cell.el.setAttribute('r', curR.toFixed(2));
            cell.el.setAttribute('stroke-opacity', alpha.toFixed(2));
          }
          // 昇華氷河風の流動
          for (const gw of glacialWinds) {
            gw.el.setAttribute('stroke-dashoffset', (t * gw.speed).toFixed(1));
          }
          // ハート全体の微細な氷河アルベド脈動
          sputnikLobePath.setAttribute('fill-opacity', (0.88 + Math.sin(t * 2.0) * 0.08).toFixed(2));
          // 多層青色大気ヘイズの脈動
          for (const hl of blueHazeLayers) {
            const rMult = hl.baseMult + Math.sin(t * 1.8 + hl.phase) * 0.022;
            const alpha = hl.baseAlpha * (0.78 + Math.sin(t * 2.3 + hl.phase) * 0.22);
            hl.el.setAttribute('r', (centralR * rMult).toFixed(1));
            hl.el.setAttribute('stroke-opacity', alpha.toFixed(2));
          }
          // 窒素・メタン昇華粒子の外気圏流出
          for (const ep of n2EscapeParticles) {
            const prog = (((t * 0.32 + ep.phase) % 1) + 1) % 1;
            const r = centralR * (1.01 + prog * 0.38);
            ep.el.setAttribute('cx', (Math.cos(ep.angleRad) * r).toFixed(1));
            ep.el.setAttribute('cy', (Math.sin(ep.angleRad) * r).toFixed(1));
            ep.el.setAttribute('fill-opacity', ((1 - prog) * 0.68).toFixed(2));
          }
        });
      }

      // 冥王星・ハウメア・マケマケ・エリス（カイパーベルト/散乱円盤の公認準惑星）：
      // エッジワース・カイパーベルトの半透明メタン・窒素氷微粒子群の浮遊＆希薄氷ヘイズ脈動
      if (targetId === 'pluto' || targetId === 'haumea' || targetId === 'makemake' || targetId === 'eris') {
        const kuiperFieldGroup = document.createElementNS(svgNs, 'g');
        const kuiperFieldParticles: {
          el: SVGCircleElement;
          baseX: number;
          baseY: number;
          speedX: number;
          ampY: number;
          baseAlpha: number;
          phase: number;
        }[] = [];
        const kbColors = ['#d8b4fe', '#c4b5fd', '#a5f3fc', '#93c5fd', '#e0e7ff', '#f0abfc'];
        for (let i = 0; i < 52; i++) {
          const bx = (((i * 83) % 980) - 490);
          const by = (((i * 67) % 740) - 370);
          const isFrost = i % 5 === 0;
          const rPx = isFrost ? 2.8 + (i % 3) * 0.55 : 1.05 + (i % 3) * 0.48;
          const baseAlpha = isFrost ? 0.095 : 0.2 + (i % 4) * 0.065;
          const dot = document.createElementNS(svgNs, 'circle');
          dot.setAttribute('r', rPx.toFixed(2));
          dot.setAttribute('fill', kbColors[i % kbColors.length]);
          kuiperFieldGroup.appendChild(dot);
          kuiperFieldParticles.push({
            el: dot,
            baseX: bx,
            baseY: by,
            speedX: 9.5 + (i % 5) * 3.2,
            ampY: 5 + (i % 4) * 2.8,
            baseAlpha,
            phase: (i * 0.72) % (Math.PI * 2),
          });
        }
        msGridGroupEl.appendChild(kuiperFieldGroup);

        // 中心準惑星の半透明窒素・メタン氷ヘイズオーラ
        const frostHazeEl = document.createElementNS(svgNs, 'circle');
        frostHazeEl.setAttribute('cx', '0');
        frostHazeEl.setAttribute('cy', '0');
        frostHazeEl.setAttribute('r', (centralR * 1.15).toFixed(1));
        frostHazeEl.setAttribute('fill', 'none');
        frostHazeEl.setAttribute(
          'stroke',
          targetId === 'pluto'
            ? 'rgba(125, 211, 252, 0.38)'
            : targetId === 'makemake'
              ? 'rgba(253, 186, 116, 0.32)'
              : 'rgba(224, 231, 255, 0.36)'
        );
        frostHazeEl.setAttribute('stroke-width', '5.5');
        msCentralPlanetGroupEl.appendChild(frostHazeEl);

        // ハウメア・マケマケ・エリスそれぞれの地表特徴と氷結晶・昇華活動アニメーション
        if (targetId === 'haumea') {
          const haumeaSurfaceGroup = document.createElementNS(svgNs, 'g');
          haumeaSurfaceGroup.setAttribute('transform', 'rotate(-18)');
          const darkRedSpotEl = document.createElementNS(svgNs, 'ellipse');
          darkRedSpotEl.setAttribute('rx', '14');
          darkRedSpotEl.setAttribute('ry', '9');
          darkRedSpotEl.setAttribute('fill', 'rgba(153, 27, 27, 0.65)');
          darkRedSpotEl.setAttribute('stroke', 'rgba(252, 165, 165, 0.45)');
          darkRedSpotEl.setAttribute('stroke-width', '1.1');
          haumeaSurfaceGroup.appendChild(darkRedSpotEl);

          const iceGlints: SVGCircleElement[] = [];
          for (const gPos of [
            { x: -24, y: -6 },
            { x: 18, y: 8 },
            { x: -6, y: 14 },
          ]) {
            const gEl = document.createElementNS(svgNs, 'circle');
            gEl.setAttribute('cx', String(gPos.x));
            gEl.setAttribute('cy', String(gPos.y));
            gEl.setAttribute('r', '2.4');
            gEl.setAttribute('fill', '#ffffff');
            haumeaSurfaceGroup.appendChild(gEl);
            iceGlints.push(gEl);
          }
          msCentralPlanetGroupEl.appendChild(haumeaSurfaceGroup);

          atmoUpdaters.push((t) => {
            // 3.9時間周期の超高速自転による暗赤色斑の移動
            const spotX = Math.sin(t * 2.6) * 26;
            const spotY = Math.cos(t * 2.6) * 6 + 4;
            darkRedSpotEl.setAttribute('cx', spotX.toFixed(1));
            darkRedSpotEl.setAttribute('cy', spotY.toFixed(1));
            iceGlints.forEach((gEl, idx) => {
              gEl.setAttribute('fill-opacity', (0.35 + 0.65 * Math.abs(Math.sin(t * 3.4 + idx * 1.2))).toFixed(2));
            });
          });
        } else if (targetId === 'makemake') {
          const tholinBand = document.createElementNS(svgNs, 'path');
          tholinBand.setAttribute('d', 'M -52,6 Q -10,22 52,4 L 52,24 Q -10,38 -52,22 Z');
          tholinBand.setAttribute('fill', 'rgba(154, 52, 18, 0.48)');
          atmoClipGroupEl.appendChild(tholinBand);

          const ch4FrostPatch = document.createElementNS(svgNs, 'ellipse');
          ch4FrostPatch.setAttribute('cx', '-14');
          ch4FrostPatch.setAttribute('cy', '-12');
          ch4FrostPatch.setAttribute('rx', '16');
          ch4FrostPatch.setAttribute('ry', '10');
          ch4FrostPatch.setAttribute('fill', 'rgba(255, 237, 213, 0.55)');
          atmoClipGroupEl.appendChild(ch4FrostPatch);

          atmoUpdaters.push((t) => {
            const xShift = Math.sin(t * 1.1) * 10;
            ch4FrostPatch.setAttribute('cx', (-14 + xShift).toFixed(1));
            ch4FrostPatch.setAttribute('fill-opacity', (0.42 + Math.sin(t * 2.2) * 0.18).toFixed(2));
          });
        } else if (targetId === 'eris') {
          const erisGlintGroup = document.createElementNS(svgNs, 'g');
          const glintEls: SVGCircleElement[] = [];
          for (const [idx, pos] of [
            { x: -16, y: -12, r: 3.2 },
            { x: -6, y: 16, r: 2.8 },
            { x: 14, y: 12, r: 2.5 },
            { x: -24, y: 8, r: 2.2 },
          ].entries()) {
            const gEl = document.createElementNS(svgNs, 'circle');
            gEl.setAttribute('cx', String(pos.x));
            gEl.setAttribute('cy', String(pos.y));
            gEl.setAttribute('r', String(pos.r));
            gEl.setAttribute('fill', idx % 2 === 0 ? '#ffffff' : '#e0f2fe');
            erisGlintGroup.appendChild(gEl);
            glintEls.push(gEl);
          }
          atmoClipGroupEl.appendChild(erisGlintGroup);

          atmoUpdaters.push((t) => {
            glintEls.forEach((el, idx) => {
              el.setAttribute('fill-opacity', (0.3 + 0.7 * Math.abs(Math.sin(t * 2.8 + idx * 1.3))).toFixed(2));
            });
          });
        }

        atmoUpdaters.push((t) => {
          for (const kp of kuiperFieldParticles) {
            const x = ((((kp.baseX + t * kp.speedX + 500) % 1000) + 1000) % 1000) - 500;
            const y = kp.baseY + Math.sin(t * 1.15 + kp.phase) * kp.ampY;
            const alpha = kp.baseAlpha * (0.7 + 0.3 * Math.sin(t * 1.85 + kp.phase));
            kp.el.setAttribute('cx', x.toFixed(1));
            kp.el.setAttribute('cy', y.toFixed(1));
            kp.el.setAttribute('fill-opacity', alpha.toFixed(3));
          }
          frostHazeEl.setAttribute('r', (centralR * (1.13 + Math.sin(t * 1.9) * 0.04)).toFixed(1));
          frostHazeEl.setAttribute('stroke-opacity', (0.28 + Math.sin(t * 2.2) * 0.12).toFixed(2));
        });
      }

      // 右上90°内部・マントル断面カット図のオーバーレイ（interiorStructureを持つ天体すべてで描画）
      if (interior && interior.layers && interior.layers.length > 0) {
        const cutawayGroupEl = document.createElementNS(svgNs, 'g');
        cutawayGroupEl.setAttribute('clip-path', 'url(#ms-cutaway-clip)');
        for (let idx = 0; idx < interior.layers.length; idx++) {
          const layer = interior.layers[idx];
          const layerR = Math.max(4, layer.outerRadiusRatio * centralR);
          const cEl = document.createElementNS(svgNs, 'circle');
          cEl.setAttribute('cx', '0');
          cEl.setAttribute('cy', '0');
          cEl.setAttribute('r', layerR.toFixed(1));
          cEl.setAttribute('fill', layer.color);
          cEl.setAttribute('fill-opacity', idx === interior.layers.length - 1 ? '0.96' : '0.88');
          cEl.setAttribute('stroke', 'rgba(4, 7, 17, 0.82)');
          cEl.setAttribute('stroke-width', '1.2');
          cutawayGroupEl.appendChild(cEl);
        }
        msCentralPlanetGroupEl.appendChild(cutawayGroupEl);

        // 断面境界ライン（+X軸・-Y軸）
        const cutLineV = document.createElementNS(svgNs, 'line');
        cutLineV.setAttribute('x1', '0');
        cutLineV.setAttribute('y1', '0');
        cutLineV.setAttribute('x2', '0');
        cutLineV.setAttribute('y2', (-centralR).toFixed(1));
        cutLineV.setAttribute('stroke', 'rgba(255, 255, 255, 0.65)');
        cutLineV.setAttribute('stroke-width', '1.2');
        cutLineV.setAttribute('stroke-dasharray', '3 2');
        msCentralPlanetGroupEl.appendChild(cutLineV);

        const cutLineH = document.createElementNS(svgNs, 'line');
        cutLineH.setAttribute('x1', '0');
        cutLineH.setAttribute('y1', '0');
        cutLineH.setAttribute('x2', centralR.toFixed(1));
        cutLineH.setAttribute('y2', '0');
        cutLineH.setAttribute('stroke', 'rgba(255, 255, 255, 0.65)');
        cutLineH.setAttribute('stroke-width', '1.2');
        cutLineH.setAttribute('stroke-dasharray', '3 2');
        msCentralPlanetGroupEl.appendChild(cutLineH);

        // 自然衛星を持たない4天体（太陽・水星・金星・ケレス）では断面層の引き出しラベルも中央右上に表示
        if (!hasNaturalMoons) {
          interior.layers.forEach((layer, idx) => {
            const midRatio =
              idx < interior.layers.length - 1
                ? (layer.outerRadiusRatio + interior.layers[idx + 1].outerRadiusRatio) * 0.5
                : layer.outerRadiusRatio * 0.5;
            const angleRad = -(18 + idx * 19) * DEG_TO_RAD;
            const sx = Math.cos(angleRad) * (centralR * midRatio);
            const sy = Math.sin(angleRad) * (centralR * midRatio);
            const ex = centralR + 18;
            const ey = -centralR + 12 + idx * 17;

            const leaderEl = document.createElementNS(svgNs, 'polyline');
            leaderEl.setAttribute(
              'points',
              `${sx.toFixed(1)},${sy.toFixed(1)} ${(centralR + 8).toFixed(1)},${ey.toFixed(1)} ${ex.toFixed(1)},${ey.toFixed(1)}`
            );
            leaderEl.setAttribute('fill', 'none');
            leaderEl.setAttribute('stroke', layer.color);
            leaderEl.setAttribute('stroke-width', '1.1');
            leaderEl.setAttribute('stroke-opacity', '0.85');
            msCentralPlanetGroupEl.appendChild(leaderEl);

            const lTextEl = document.createElementNS(svgNs, 'text');
            lTextEl.setAttribute('x', (ex + 4).toFixed(1));
            lTextEl.setAttribute('y', (ey + 3).toFixed(1));
            lTextEl.setAttribute('fill', layer.color);
            lTextEl.setAttribute('class', 'ms-cutaway-label');
            const shortLayerName = layer.name.split(' (')[0];
            lTextEl.textContent = `${shortLayerName} (${Math.round(layer.outerRadiusRatio * 100)}%R)`;
            msCentralPlanetGroupEl.appendChild(lTextEl);
          });
        }
      }

      // 環の手前側（y >= 0 のみクリップして球体の手前に重ねる）＋ 輪の粒子（リングパーティクル）3D公転アニメーション
      if (planet && planet.hasRings && planet.ringSystem && backRingGroupEl) {
        const clipWrapperEl = document.createElementNS(svgNs, 'g');
        clipWrapperEl.setAttribute('clip-path', 'url(#ms-ring-front-clip)');
        frontRingGroupEl = document.createElementNS(svgNs, 'g');
        frontRingGroupEl.setAttribute('transform', `rotate(${ringTiltDeg})`);
        frontRingGroupEl.setAttribute('filter', 'url(#ring-glow)');
        clipWrapperEl.appendChild(frontRingGroupEl);
        msCentralPlanetGroupEl.appendChild(clipWrapperEl);

        for (const band of planet.ringSystem.bands) {
          const backEl = document.createElementNS(svgNs, 'ellipse');
          backEl.setAttribute('cx', '0');
          backEl.setAttribute('cy', '0');
          backEl.setAttribute('fill', 'none');
          backEl.setAttribute('stroke', band.color);
          if (band.dashArray) backEl.setAttribute('stroke-dasharray', band.dashArray);

          const frontEl = document.createElementNS(svgNs, 'ellipse');
          frontEl.setAttribute('cx', '0');
          frontEl.setAttribute('cy', '0');
          frontEl.setAttribute('fill', 'none');
          frontEl.setAttribute('stroke', band.color);
          if (band.dashArray) frontEl.setAttribute('stroke-dasharray', band.dashArray);

          backRingGroupEl.appendChild(backEl);
          frontRingGroupEl.appendChild(frontEl);
          ringBands.push({
            band,
            aspectRatio: ringAspect,
            backEl,
            frontEl,
          });
        }

        // 環（リング）内の無数の氷・ダスト粒子のケプラー差動公転を生成
        const particleCount =
          targetId === 'saturn'
            ? 68
            : targetId === 'neptune'
              ? 44
              : targetId === 'uranus'
                ? 38
                : targetId === 'jupiter'
                  ? 30
                  : 22;

        const bands = planet.ringSystem.bands;
        for (let i = 0; i < particleCount; i++) {
          const band = bands[i % bands.length];
          const radialJitter = (((i * 37) % 100) / 100 - 0.5) * 0.14;
          const rMult = Math.max(1.25, band.radiusMultiplier + radialJitter);

          // 海王星のアダムズ環（最外バンド）では5つのアーク（リベルテ・エガリテ・フラテルニテ等）に粒子を密集配置
          let baseAngleDeg = (i * 137.508) % 360;
          if (targetId === 'neptune' && band === bands[bands.length - 1] && i % 3 !== 0) {
            const arcCenters = [25, 42, 54, 72, 205];
            const center = arcCenters[i % arcCenters.length];
            baseAngleDeg = center + (((i * 19) % 16) - 8);
          }

          // ケプラー第3法則に基づく角速度（内側の環粒子ほど速く公転）
          const keplerAngularSpeed = (1.15 / Math.pow(rMult, 1.5)) * (targetId === 'uranus' ? -1 : 1);
          const pRadiusPx =
            targetId === 'saturn'
              ? 1.15 + (i % 3) * 0.55
              : targetId === 'uranus' && band === bands[bands.length - 1]
                ? 1.8
                : 1.2 + (i % 2) * 0.5;
          const baseAlpha = Math.min(0.98, Math.max(0.45, band.opacity * 1.15));

          const backDotEl = document.createElementNS(svgNs, 'circle');
          backDotEl.setAttribute('r', pRadiusPx.toFixed(2));
          backDotEl.setAttribute('fill', band.color);
          backRingGroupEl.appendChild(backDotEl);

          const frontDotEl = document.createElementNS(svgNs, 'circle');
          frontDotEl.setAttribute('r', pRadiusPx.toFixed(2));
          frontDotEl.setAttribute('fill', band.color);
          frontRingGroupEl.appendChild(frontDotEl);

          ringParticles.push({
            radiusMultiplier: rMult,
            aspectRatio: ringAspect,
            baseAngleRad: baseAngleDeg * DEG_TO_RAD,
            angularSpeedRadPerSec: keplerAngularSpeed,
            baseOpacity: baseAlpha,
            backDotEl,
            frontDotEl,
          });
        }
      }

      // 中心天体ラベル＆専用アニメーション解説タグ
      const centralLabelY = planet?.hasRings ? centralR + 50 : centralR + 24;
      const centralTitleEl = document.createElementNS(svgNs, 'text');
      centralTitleEl.setAttribute('x', '0');
      centralTitleEl.setAttribute('y', String(centralLabelY));
      centralTitleEl.setAttribute('text-anchor', 'middle');
      centralTitleEl.setAttribute('class', 'ms-central-title');
      centralTitleEl.textContent = `${bodySymbol} ${bodyNameJa} (${bodyNameEn})`;
      msCentralPlanetGroupEl.appendChild(centralTitleEl);

      const centralSubEl = document.createElementNS(svgNs, 'text');
      centralSubEl.setAttribute('x', '0');
      centralSubEl.setAttribute('y', String(centralLabelY + 15));
      centralSubEl.setAttribute('text-anchor', 'middle');
      centralSubEl.setAttribute('class', 'ms-central-sub');
      centralSubEl.textContent = isSun
        ? `直径 ${bodyDiameterKm.toLocaleString()} km (地球の109倍) / 内部4層断面・太陽コロナ圏`
        : hasNaturalMoons
          ? `直径 ${bodyDiameterKm.toLocaleString()} km / 主要衛星 ${planet!.moons.length}個`
          : `直径 ${bodyDiameterKm.toLocaleString()} km / 自然衛星 0個（内部断面・近傍重力圏表示）`;
      msCentralPlanetGroupEl.appendChild(centralSubEl);

      const dedicatedAnimText = DEDICATED_ANIM_LABELS[targetId];
      if (dedicatedAnimText) {
        const animTagEl = document.createElementNS(svgNs, 'text');
        animTagEl.setAttribute('x', '0');
        animTagEl.setAttribute('y', String(centralLabelY + 30));
        animTagEl.setAttribute('text-anchor', 'middle');
        animTagEl.setAttribute('class', 'ms-central-anim-tag');
        animTagEl.textContent = dedicatedAnimText;
        msCentralPlanetGroupEl.appendChild(animTagEl);
      }

      // 3. 各衛星の拡大軌道（または太陽・水星・金星・ケレスの近傍基準リング）とノードを構築
      const orbitItems = hasNaturalMoons
        ? planet!.moons.map((m) => ({
            id: m.id,
            nameJa: m.nameJa,
            nameEn: m.nameEn,
            distanceKm: m.distanceKm,
            ratioLabel: `${(m.distanceKm / Math.max(1, bodyDiameterKm / 2)).toFixed(1)} Rₚ`,
            orbitalPeriodDays: m.orbitalPeriodDays,
            initialAngleDeg: m.initialAngleDeg,
            sizePx: m.sizePx,
            color: m.color,
            metaText: `直径 ${m.diameterKm.toLocaleString()} km ・ 周期 ${Math.abs(m.orbitalPeriodDays)}日${
              m.orbitalPeriodDays < 0 ? ' [逆行]' : ''
            }`,
            tagPrefix: `${m.nameJa}軌道`,
          }))
        : (NO_MOON_NEAR_ZONES[targetId] || []).map((z) => ({
            id: z.id,
            nameJa: z.nameJa,
            nameEn: z.nameEn,
            distanceKm: z.distanceKm,
            ratioLabel: z.ratioLabel,
            orbitalPeriodDays: z.orbitalPeriodDays,
            initialAngleDeg: z.initialAngleDeg,
            sizePx: z.sizePx,
            color: z.color,
            metaText: `半径 ${z.distanceKm.toLocaleString()} km (${z.ratioLabel}) ・ ${z.badgeLabel}`,
            tagPrefix: z.nameJa,
          }));

      const totalItems = orbitItems.length;
      const minOrbitPx = planet?.hasRings ? 195 : hasNaturalMoons ? 175 : 210;
      const maxOrbitPx = 468;
      const minDistKm = Math.min(...orbitItems.map((item) => item.distanceKm), 1);
      const maxDistKm = Math.max(...orbitItems.map((item) => item.distanceKm), 1);

      const moonsCache: MoonSystemStageCache['moons'] = [];

      orbitItems.forEach((m, idx) => {
        const autoRadiusPx =
          totalItems === 1
            ? 305
            : minOrbitPx + (idx / Math.max(1, totalItems - 1)) * (maxOrbitPx - minOrbitPx);

        let realRadiusPx = 305;
        if (totalItems > 1) {
          const norm =
            (Math.pow(m.distanceKm, 0.58) - Math.pow(minDistKm, 0.58)) /
            Math.max(0.001, Math.pow(maxDistKm, 0.58) - Math.pow(minDistKm, 0.58));
          realRadiusPx = minOrbitPx + norm * (maxOrbitPx - minOrbitPx);
        }

        const expandedSizePx = hasNaturalMoons
          ? Math.max(7.0, Math.min(17.5, m.sizePx * 3.1))
          : Math.max(6.5, Math.min(11.5, m.sizePx * 2.4));

        const orbitEl = document.createElementNS(svgNs, 'ellipse');
        orbitEl.setAttribute('cx', '0');
        orbitEl.setAttribute('cy', '0');
        orbitEl.setAttribute('stroke', m.color);
        orbitEl.setAttribute('class', 'ms-moon-orbit');
        msOrbitsGroupEl.appendChild(orbitEl);

        const orbitTagEl = document.createElementNS(svgNs, 'text');
        orbitTagEl.setAttribute('x', '0');
        orbitTagEl.setAttribute('text-anchor', 'middle');
        orbitTagEl.setAttribute('fill', m.color);
        orbitTagEl.setAttribute('class', 'ms-orbit-tag');
        orbitTagEl.textContent = `${m.tagPrefix}: ${m.distanceKm.toLocaleString()} km (${m.ratioLabel})`;
        msOrbitsGroupEl.appendChild(orbitTagEl);

        const nodeEl = document.createElementNS(svgNs, 'g');
        nodeEl.setAttribute('class', 'ms-moon-node');
        nodeEl.dataset.moonId = m.id;
        nodeEl.setAttribute('tabindex', '0');
        nodeEl.setAttribute('role', 'button');
        nodeEl.setAttribute('aria-label', `${m.nameJa} (${m.nameEn})`);

        const mHaloEl = document.createElementNS(svgNs, 'circle');
        mHaloEl.setAttribute('r', (expandedSizePx * 1.65).toFixed(1));
        mHaloEl.setAttribute('fill', m.color);
        mHaloEl.setAttribute('fill-opacity', '0.22');
        nodeEl.appendChild(mHaloEl);

        const selRingEl = document.createElementNS(svgNs, 'circle');
        selRingEl.setAttribute('r', (expandedSizePx + 6.5).toFixed(1));
        selRingEl.setAttribute('class', 'ms-moon-sel-ring');
        nodeEl.appendChild(selRingEl);

        const mSphereEl = document.createElementNS(svgNs, 'circle');
        mSphereEl.setAttribute('r', expandedSizePx.toFixed(1));
        mSphereEl.setAttribute('fill', m.color);
        mSphereEl.setAttribute('filter', 'url(#planet-glow)');
        mSphereEl.setAttribute('class', 'ms-moon-sphere');
        nodeEl.appendChild(mSphereEl);

        const hitEl = document.createElementNS(svgNs, 'circle');
        hitEl.setAttribute('r', (expandedSizePx + 15).toFixed(1));
        hitEl.setAttribute('fill', 'transparent');
        hitEl.setAttribute('class', 'ms-moon-hit');
        nodeEl.appendChild(hitEl);

        const isRetro = m.orbitalPeriodDays < 0;

        const titleEl = document.createElementNS(svgNs, 'text');
        titleEl.setAttribute('x', '0');
        titleEl.setAttribute('y', (-(expandedSizePx + 16)).toFixed(1));
        titleEl.setAttribute('text-anchor', 'middle');
        titleEl.setAttribute('class', 'ms-moon-title');
        titleEl.textContent = `${isRetro ? '↻ ' : '↺ '}${m.nameJa} (${m.nameEn})`;
        nodeEl.appendChild(titleEl);

        const metaEl = document.createElementNS(svgNs, 'text');
        metaEl.setAttribute('x', '0');
        metaEl.setAttribute('y', (-(expandedSizePx + 3.5)).toFixed(1));
        metaEl.setAttribute('text-anchor', 'middle');
        metaEl.setAttribute('class', 'ms-moon-meta');
        metaEl.textContent = m.metaText;
        nodeEl.appendChild(metaEl);

        nodeEl.addEventListener('click', (e) => {
          e.stopPropagation();
          simState.highlightedMoonId = simState.highlightedMoonId === m.id ? '' : m.id;
          if (detailMoonsListEl) {
            detailMoonsListEl.querySelectorAll<HTMLElement>('[data-moon-card-id]').forEach((card) => {
              const active = card.dataset.moonCardId === simState.highlightedMoonId;
              card.classList.toggle('active', active);
              if (active) {
                card.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
              }
            });
          }
        });

        msMoonsNodesGroupEl.appendChild(nodeEl);

        moonsCache.push({
          id: m.id,
          nameJa: m.nameJa,
          nameEn: m.nameEn,
          orbitalPeriodDays: m.orbitalPeriodDays,
          initialAngleDeg: m.initialAngleDeg,
          autoRadiusPx,
          realRadiusPx,
          expandedSizePx,
          orbitEl,
          orbitTagEl,
          nodeEl,
        });
      });

      activeMoonStageCache = {
        targetId,
        planet,
        centralRadiusPx: centralR,
        outerGridRingEl,
        gridSpokes,
        ringBands,
        ringParticles,
        atmoUpdaters,
        moons: moonsCache,
      };
    }

    /**
     * 天体・衛星軌道拡大専用ビューの毎フレーム描画更新
     */
    function renderMoonSystemView() {
      if (!activeMoonStageCache) return;
      const cache = activeMoonStageCache;
      const p = cache.planet;
      const d = simState.elapsedDays;
      const animT = simState.visualAnimSec;
      const tiltY = simState.tiltY;
      const auBlend = simState.auRatioBlend;

      // 1. 背景グリッドの3Dチルト更新
      const maxGridR = 525;
      if (cache.outerGridRingEl) {
        cache.outerGridRingEl.setAttribute('rx', String(maxGridR));
        cache.outerGridRingEl.setAttribute('ry', (maxGridR * tiltY).toFixed(1));
      }
      const innerStart = cache.centralRadiusPx + 32;
      for (const sp of cache.gridSpokes) {
        const rad = -sp.deg * DEG_TO_RAD;
        const cosA = Math.cos(rad);
        const sinA = Math.sin(rad);
        sp.lineEl.setAttribute('x1', (cosA * innerStart).toFixed(1));
        sp.lineEl.setAttribute('y1', (sinA * innerStart * tiltY).toFixed(1));
        sp.lineEl.setAttribute('x2', (cosA * maxGridR).toFixed(1));
        sp.lineEl.setAttribute('y2', (sinA * maxGridR * tiltY).toFixed(1));
        sp.textEl.setAttribute('x', (cosA * (maxGridR + 22)).toFixed(1));
        sp.textEl.setAttribute('y', (sinA * (maxGridR + 22) * tiltY + 4).toFixed(1));
      }

      // 1.5 太陽＋8惑星の専用大気・磁気圏・コロナアニメーション更新
      if (cache.atmoUpdaters.length > 0) {
        for (const updateAtmo of cache.atmoUpdaters) {
          updateAtmo(animT);
        }
      }

      // 2. 中心惑星の多重環（3D立体交差）と公転リング粒子群の更新
      if (cache.ringBands.length > 0) {
        const ringScaleBoost = simState.emphasizeRings ? 1.12 : 1.0;
        const ringStrokeBoost = simState.emphasizeRings ? 1.28 : 1.0;
        const sizeRatio = cache.centralRadiusPx / 12.5;
        for (const rb of cache.ringBands) {
          const rx = cache.centralRadiusPx * rb.band.radiusMultiplier * ringScaleBoost;
          const ry = rx * rb.aspectRatio;
          const sw = Math.max(1.2, rb.band.strokeWidthPx * sizeRatio * ringStrokeBoost);
          const frontAlpha = Math.min(1.0, rb.band.opacity * (simState.emphasizeRings ? 1.12 : 1.0));
          const backAlpha = frontAlpha * 0.82;

          rb.backEl.setAttribute('rx', rx.toFixed(1));
          rb.backEl.setAttribute('ry', ry.toFixed(1));
          rb.backEl.setAttribute('stroke-width', sw.toFixed(2));
          rb.backEl.setAttribute('stroke-opacity', backAlpha.toFixed(2));

          rb.frontEl.setAttribute('rx', rx.toFixed(1));
          rb.frontEl.setAttribute('ry', ry.toFixed(1));
          rb.frontEl.setAttribute('stroke-width', sw.toFixed(2));
          rb.frontEl.setAttribute('stroke-opacity', frontAlpha.toFixed(2));
        }
      }

      if (cache.ringParticles.length > 0) {
        const ringScaleBoost = simState.emphasizeRings ? 1.12 : 1.0;
        cache.ringParticles.forEach((rp, idx) => {
          const angle = rp.baseAngleRad + rp.angularSpeedRadPerSec * animT;
          const rx = cache.centralRadiusPx * rp.radiusMultiplier * ringScaleBoost;
          const ry = rx * rp.aspectRatio;
          const px = (Math.cos(angle) * rx).toFixed(1);
          const py = (Math.sin(angle) * ry).toFixed(1);
          const shimmer = Math.min(1.0, rp.baseOpacity * (0.82 + Math.sin(animT * 3.2 + idx) * 0.18));

          rp.backDotEl.setAttribute('cx', px);
          rp.backDotEl.setAttribute('cy', py);
          rp.backDotEl.setAttribute('fill-opacity', (shimmer * 0.78).toFixed(2));

          rp.frontDotEl.setAttribute('cx', px);
          rp.frontDotEl.setAttribute('cy', py);
          rp.frontDotEl.setAttribute('fill-opacity', shimmer.toFixed(2));
        });
      }

      // 3. 衛星軌道・近傍重力圏リング・天王星の3D横倒し（76°傾斜）・ノード座標の更新
      const effectiveDaysForMoons =
        simState.speedDaysPerSec > 12 && simState.isPlaying
          ? d * (3.5 / simState.speedDaysPerSec)
          : d;

      const view3dFactor = Math.max(0, Math.min(1, (1.0 - tiltY) / (1.0 - 0.44)));
      const isUranus = cache.targetId === 'uranus';
      const moonPlaneTiltDeg = isUranus ? (p?.ringSystem?.tiltDeg ?? 76) * view3dFactor : 0;
      const moonPlaneTiltRad = moonPlaneTiltDeg * DEG_TO_RAD;
      const cosPlane = Math.cos(moonPlaneTiltRad);
      const sinPlane = Math.sin(moonPlaneTiltRad);
      const uranusAspect = lerp(1.0, p?.ringSystem?.aspectRatio ?? 0.36, view3dFactor);

      for (const mItem of cache.moons) {
        const mRx = lerp(mItem.autoRadiusPx, mItem.realRadiusPx, auBlend);
        const mRy = isUranus ? mRx * uranusAspect : mRx * tiltY;
        const isHighlighted = simState.highlightedMoonId === mItem.id;

        mItem.orbitEl.setAttribute('rx', mRx.toFixed(1));
        mItem.orbitEl.setAttribute('ry', mRy.toFixed(1));
        mItem.orbitEl.classList.toggle('is-highlighted', isHighlighted);

        if (isUranus && moonPlaneTiltDeg > 0.1) {
          mItem.orbitEl.setAttribute('transform', `rotate(${moonPlaneTiltDeg.toFixed(2)})`);
        } else {
          mItem.orbitEl.removeAttribute('transform');
        }

        // 軌道距離タグの位置（軌道上端または右斜め上）
        const tagAngleRad = -65 * DEG_TO_RAD;
        const localTagX = Math.cos(tagAngleRad) * mRx;
        const localTagY = Math.sin(tagAngleRad) * mRy;
        const tagX = isUranus ? localTagX * cosPlane - localTagY * sinPlane : localTagX;
        const tagY = isUranus ? localTagX * sinPlane + localTagY * cosPlane : localTagY;
        mItem.orbitTagEl.setAttribute('x', tagX.toFixed(1));
        mItem.orbitTagEl.setAttribute('y', (tagY - 5).toFixed(1));

        // 衛星・近傍基準マーカーの現在公転角（負の公転周期＝逆行公転にも対応）
        const moonAngleDeg = normalizeDegrees(
          mItem.initialAngleDeg + (360 / mItem.orbitalPeriodDays) * effectiveDaysForMoons
        );
        const moonRad = -moonAngleDeg * DEG_TO_RAD;
        const localMx = Math.cos(moonRad) * mRx;
        const localMy = Math.sin(moonRad) * mRy;
        const mx = isUranus ? localMx * cosPlane - localMy * sinPlane : localMx;
        const my = isUranus ? localMx * sinPlane + localMy * cosPlane : localMy;

        const sin2D = Math.sin(moonRad);
        const depthScale = 1 + sin2D * (1 - tiltY) * 0.18;

        mItem.nodeEl.setAttribute(
          'transform',
          `translate(${mx.toFixed(2)}, ${my.toFixed(2)}) scale(${depthScale.toFixed(3)})`
        );
        mItem.nodeEl.classList.toggle('is-highlighted', isHighlighted);
      }
    }

    /**
     * 詳細パネル内の「専用拡大ビューで表示」ボタンの表示・文言を同期する
     */
    function syncOpenMoonViewButton(targetId: string) {
      if (!btnOpenMoonViewEl) return;
      const isTarget = moonTargetIds.includes(targetId);
      if (!isTarget) {
        btnOpenMoonViewEl.style.display = 'none';
        return;
      }
      const isSun = targetId === 'sun';
      const planet = isSun ? null : planetsData.find((p) => p.id === targetId);
      const bodyNameJa = isSun ? sunData.nameJa : (planet?.nameJa ?? '');
      const hasMoons = !isSun && !!planet && planet.moons.length > 0;

      btnOpenMoonViewEl.style.display = 'flex';
      if (simState.isMoonSystemView && simState.moonViewPlanetId === targetId) {
        btnOpenMoonViewEl.textContent = '← 太陽系全体ビュー（3段階縮尺）へ戻る';
        btnOpenMoonViewEl.classList.add('is-active-view');
      } else {
        btnOpenMoonViewEl.textContent = hasMoons
          ? `🔍 ${bodyNameJa}と衛星軌道の専用拡大ビューを開く`
          : `🔍 ${bodyNameJa}の内部断面・近傍圏 専用拡大ビューを開く`;
        btnOpenMoonViewEl.classList.remove('is-active-view');
      }
    }

    /**
     * 対象14天体（太陽・水星・金星・地球・火星・ケレス・木星・土星・天王星・海王星・冥王星・ハウメア・マケマケ・エリス）の
     * 天体・衛星軌道拡大専用ビューを開く
     */
    function openMoonSystemView(targetBodyId?: string) {
      const resolvedId =
        targetBodyId && moonTargetIds.includes(targetBodyId)
          ? targetBodyId
          : moonTargetIds.includes(simState.selectedBodyId)
            ? simState.selectedBodyId
            : simState.moonViewPlanetId || 'jupiter';

      const isSun = resolvedId === 'sun';
      const planet = isSun ? null : planetsData.find((p) => p.id === resolvedId) || null;
      if (!isSun && !planet) return;

      simState.isMoonSystemView = true;
      simState.moonViewPlanetId = resolvedId;
      simState.selectedBodyId = resolvedId;
      simState.highlightedMoonId = '';

      rootEl.classList.add('is-moon-system-view', 'has-selection');

      if (eclipticGridEl) eclipticGridEl.style.display = 'none';
      if (beltsLayerEl) beltsLayerEl.style.display = 'none';
      if (orbitsLayerEl) orbitsLayerEl.style.display = 'none';
      if (bodiesLayerEl) bodiesLayerEl.style.display = 'none';
      if (moonSystemStageEl) moonSystemStageEl.style.display = 'block';
      if (moonSystemSwitcherEl) moonSystemSwitcherEl.style.display = 'flex';

      document.querySelectorAll<HTMLButtonElement>('.zone-btn').forEach((btn) => {
        btn.classList.remove('active');
      });
      btnMoonSystemModeEl?.classList.add('active');

      document.querySelectorAll<HTMLButtonElement>('.moon-target-pill').forEach((pill) => {
        const active = pill.dataset.moonTargetId === resolvedId;
        pill.classList.toggle('active', active);
        if (active) {
          pill.scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
        }
      });

      document.querySelectorAll<HTMLButtonElement>('.nav-pill').forEach((btn) => {
        const active = btn.dataset.targetId === resolvedId;
        btn.classList.toggle('active', active);
        if (active) {
          btn.scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
        }
      });

      const bodyNameJa = isSun ? sunData.nameJa : planet!.nameJa;
      if (hudZoneNameEl) {
        hudZoneNameEl.textContent = `4. 拡大専用ビュー (${bodyNameJa})`;
      }
      if (hudZoneRangeEl) {
        if (isSun) {
          hudZoneRangeEl.textContent = '中心恒星: 太陽 / 内部4層断面・コロナ臨界面・探査機最接近圏';
        } else if (planet!.moons.length > 0) {
          const maxMoonKm = Math.max(...planet!.moons.map((m) => m.distanceKm), 0);
          hudZoneRangeEl.textContent = `中心天体: ${planet!.nameJa} / 主要衛星 ${planet!.moons.length}個 (最大軌道半径 ${maxMoonKm.toLocaleString()} km)`;
        } else {
          hudZoneRangeEl.textContent = `中心天体: ${planet!.nameJa} / 自然衛星 0個 (内部断面・ロッシュ限界・ヒル球・探査軌道表示)`;
        }
      }

      buildMoonSystemStageDom(resolvedId);
      if (isSun) {
        populateSunDetail();
      } else if (planet) {
        populatePlanetDetail(planet);
      }
      syncOpenMoonViewButton(resolvedId);

      gsap.to(simState, {
        cameraX: 0,
        cameraY: 0,
        cameraZoom: 1.0,
        duration: 0.75,
        ease: 'power3.out',
      });

      animateDetailPanel(true);
    }

    /**
     * 天体・衛星軌道拡大専用ビューを閉じて太陽系全体ビューへ戻る
     */
    function closeMoonSystemView(options?: { keepPlanetSelected?: boolean }) {
      if (!simState.isMoonSystemView) return;
      simState.isMoonSystemView = false;
      rootEl.classList.remove('is-moon-system-view');

      if (eclipticGridEl) eclipticGridEl.style.display = 'block';
      if (beltsLayerEl) beltsLayerEl.style.display = 'block';
      if (orbitsLayerEl) orbitsLayerEl.style.display = 'block';
      if (bodiesLayerEl) bodiesLayerEl.style.display = 'block';
      if (moonSystemStageEl) moonSystemStageEl.style.display = 'none';
      if (moonSystemSwitcherEl) moonSystemSwitcherEl.style.display = 'none';

      btnMoonSystemModeEl?.classList.remove('active');

      const currentBodyId = simState.moonViewPlanetId;
      if (currentBodyId === 'sun') {
        if (options?.keepPlanetSelected) {
          switchScaleZone(simState.activeZone, { keepSelection: true });
          selectCelestialBody('sun');
        } else {
          switchScaleZone(simState.activeZone, { keepSelection: false });
        }
        return;
      }

      const planet = planetsData.find((p) => p.id === currentBodyId);
      if (options?.keepPlanetSelected && planet) {
        switchScaleZone(planet.homeZone, { keepSelection: true });
        selectCelestialBody(planet.id);
      } else {
        switchScaleZone(planet?.homeZone || simState.activeZone, { keepSelection: false });
      }
    }

    /**
     * 3つの表示縮尺（'inner': 内惑星 / 'outer': 外惑星 / 'tno': 外縁天体）を切り替え、
     * 各天体の軌道長半径・球体サイズ・表示離心率・ベルト半径をGSAPで滑らかに自動調整する
     */
    function switchScaleZone(zone: ScaleZone, options?: { keepSelection?: boolean }) {
      if (simState.isMoonSystemView) {
        simState.isMoonSystemView = false;
        rootEl.classList.remove('is-moon-system-view');
        if (eclipticGridEl) eclipticGridEl.style.display = 'block';
        if (beltsLayerEl) beltsLayerEl.style.display = 'block';
        if (orbitsLayerEl) orbitsLayerEl.style.display = 'block';
        if (bodiesLayerEl) bodiesLayerEl.style.display = 'block';
        if (moonSystemStageEl) moonSystemStageEl.style.display = 'none';
        if (moonSystemSwitcherEl) moonSystemSwitcherEl.style.display = 'none';
        btnMoonSystemModeEl?.classList.remove('active');
      }

      simState.activeZone = zone;
      const meta = zonesMeta[zone];

      document.querySelectorAll<HTMLButtonElement>('.zone-btn').forEach((btn) => {
        btn.classList.toggle('active', btn.dataset.scaleZone === zone);
      });

      document.querySelectorAll<HTMLButtonElement>('.nav-pill[data-home-zone]').forEach((pill) => {
        const home = pill.dataset.homeZone;
        const pid = pill.dataset.targetId;
        const bClass = pill.dataset.bodyClass;
        const isPrimaryInThisZone =
          home === zone ||
          bClass === 'comet' ||
          (zone === 'inner' && pid === 'jupiter') ||
          (zone === 'outer' && (pid === 'ceres' || pid === 'pluto')) ||
          (zone === 'tno' && pid === 'neptune');
        pill.classList.toggle('is-secondary-zone-pill', !isPrimaryInThisZone);
      });

      if (hudZoneNameEl) hudZoneNameEl.textContent = meta.labelJa;
      if (hudZoneRangeEl) hudZoneRangeEl.textContent = meta.rangeAuText;

      gsap.to(simState, {
        sunRadiusPx: sunData.sizeByZonePx[zone],
        mainBeltRadiusPx: meta.mainBelt.radiusPx,
        mainBeltWidthPx: meta.mainBelt.widthPx,
        mainBeltOpacity: meta.mainBelt.opacity,
        kuiperBeltRadiusPx: meta.kuiperBelt.radiusPx,
        kuiperBeltWidthPx: meta.kuiperBelt.widthPx,
        kuiperBeltOpacity: meta.kuiperBelt.opacity,
        duration: 0.95,
        ease: 'expo.out',
      });

      for (const p of planetsData) {
        const isPrimary = p.scaleConfig.isPrimaryInZone[zone];
        const isVisible = p.scaleConfig.isVisibleInZone[zone];
        const targetAutoR = p.scaleConfig.orbitRadiusPx[zone];
        const targetAuR = computeZoneAuRadiusPx(p, zone);
        const targetEcc = getZoneDisplayEcc(p, zone);
        const targetBodySize = p.scaleConfig.bodySizePx[zone];
        const targetOpacity = isVisible ? (isPrimary ? 1.0 : 0.42) : 0.0;

        gsap.to(bodyAnimState[p.id], {
          autoOrbitRadiusPx: targetAutoR,
          auOrbitRadiusPx: targetAuR,
          displayEcc: targetEcc,
          bodySizePx: targetBodySize,
          opacity: targetOpacity,
          moonVisibility: isPrimary ? 1.0 : 0.0,
          labelVisibility: isPrimary ? 1.0 : 0.0,
          duration: 0.95,
          ease: 'expo.out',
        });
      }

      if (!options?.keepSelection) {
        simState.selectedBodyId = 'overview';
        simState.highlightedMoonId = '';
        rootEl.classList.remove('has-selection');

        document.querySelectorAll<HTMLButtonElement>('.nav-pill').forEach((btn) => {
          btn.classList.toggle('active', btn.dataset.targetId === 'overview');
        });
        document.querySelectorAll<SVGGElement>('.celestial-node').forEach((node) => {
          node.classList.remove('is-selected');
        });

        gsap.to(simState, {
          cameraX: 0,
          cameraY: 0,
          cameraZoom: 1.0,
          duration: 0.95,
          ease: 'expo.out',
        });

        animateDetailPanel(false);
      }
    }

    /**
     * 天体（太陽・惑星・準惑星・準惑星候補・彗星・または縮尺全体）を選択してフォーカスする
     */
    function selectCelestialBody(targetId: string) {
      // 専用拡大ビュー中に対象10天体がクリックされた場合はそのまま専用拡大ビュー内で天体を切り替える
      if (simState.isMoonSystemView) {
        if (moonTargetIds.includes(targetId)) {
          openMoonSystemView(targetId);
          return;
        }
        // 太陽や対象外天体（水星・金星・ケレス・彗星など）や全体表示が選ばれた場合は専用ビューを解除
        closeMoonSystemView({ keepPlanetSelected: false });
      }

      simState.selectedBodyId = targetId;
      simState.highlightedMoonId = '';

      document.querySelectorAll<HTMLButtonElement>('.nav-pill').forEach((btn) => {
        const isTarget = btn.dataset.targetId === targetId;
        btn.classList.toggle('active', isTarget);
        if (isTarget) {
          btn.scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
        }
      });

      document.querySelectorAll<SVGGElement>('.celestial-node').forEach((node) => {
        node.classList.toggle('is-selected', node.dataset.bodyId === targetId);
      });

      if (targetId === 'overview') {
        switchScaleZone(simState.activeZone, { keepSelection: false });
        return;
      }

      rootEl.classList.add('has-selection');

      if (targetId === 'sun') {
        populateSunDetail();
        gsap.to(simState, {
          cameraX: 0,
          cameraY: 0,
          cameraZoom: 2.2,
          duration: 1.0,
          ease: 'power3.out',
        });
      } else {
        const planet = planetsData.find((p) => p.id === targetId);
        if (planet) {
          if (planet.bodyClass === 'comet' && !simState.showComets) {
            simState.showComets = true;
            updateCometsToggleUi();
          }
          if (!planet.scaleConfig.isPrimaryInZone[simState.activeZone]) {
            switchScaleZone(planet.homeZone, { keepSelection: true });
          }
          populatePlanetDetail(planet);
          const targetZoom = planet.moons.length > 0 ? 2.6 : 2.35;
          gsap.to(simState, {
            cameraZoom: targetZoom,
            duration: 1.05,
            ease: 'power3.out',
          });
        }
      }

      animateDetailPanel(true);
    }

    /**
     * 詳細パネルに内部・マントル断面構造（同心円断面SVGと各層の解説リスト）を描画する
     */
    function renderInteriorStructureSection(interior?: PlanetData['interiorStructure']) {
      if (!detailInteriorSectionEl) return;
      if (!interior || !interior.layers || interior.layers.length === 0) {
        detailInteriorSectionEl.style.display = 'none';
        return;
      }

      detailInteriorSectionEl.style.display = 'block';
      if (detailInteriorBadgeEl) {
        detailInteriorBadgeEl.textContent = `${interior.layers.length}層構造`;
      }
      if (detailInteriorSummaryEl) {
        detailInteriorSummaryEl.textContent = interior.summary;
      }

      // 外層（outerRadiusRatio 大）から中心核（outerRadiusRatio 小）の順に同心円断面SVGを描画
      if (detailInteriorSvgEl) {
        const maxR = 38;
        const circlesHtml = interior.layers
          .map((layer, idx) => {
            const r = Math.max(4, layer.outerRadiusRatio * maxR);
            const isCore = idx === interior.layers.length - 1;
            return `
              <circle
                cx="0"
                cy="0"
                r="${r.toFixed(1)}"
                fill="${layer.color}"
                fill-opacity="${isCore ? '0.96' : '0.82'}"
                stroke="rgba(4, 7, 17, 0.78)"
                stroke-width="1.1"
              />
            `;
          })
          .join('');

        // 右上1/4に断面カットラインを入れて内部層構造を強調
        detailInteriorSvgEl.innerHTML = `
          ${circlesHtml}
          <line x1="0" y1="0" x2="0" y2="-39" stroke="rgba(255,255,255,0.45)" stroke-width="0.9" stroke-dasharray="2 1.5" />
          <line x1="0" y1="0" x2="39" y2="0" stroke="rgba(255,255,255,0.45)" stroke-width="0.9" stroke-dasharray="2 1.5" />
        `;
      }

      // 断面図横のコンパクトな層比率バー
      if (detailInteriorLegendEl) {
        detailInteriorLegendEl.innerHTML = interior.layers
          .map((layer, idx) => {
            const pct = Math.round(layer.outerRadiusRatio * 100);
            const shortName = layer.name.split(' (')[0];
            return `
              <div class="interior-legend-item">
                <span class="interior-legend-dot" style="background:${layer.color};"></span>
                <span class="interior-legend-name">${idx + 1}. ${shortName}</span>
                <span class="interior-legend-pct">〜${pct}%R</span>
              </div>
            `;
          })
          .join('');
      }

      // 各層の詳細解説カード
      if (detailInteriorListEl) {
        detailInteriorListEl.innerHTML = interior.layers
          .map((layer) => {
            const pct = Math.round(layer.outerRadiusRatio * 100);
            const isMantle = layer.name.includes('マントル') || layer.name.includes('対流層') || layer.name.includes('放射層');
            return `
              <div class="interior-layer-card ${isMantle ? 'is-mantle-layer' : ''}">
                <div class="interior-layer-header">
                  <span class="interior-layer-title">
                    <span class="interior-layer-swatch" style="background:${layer.color};"></span>
                    ${layer.name}
                  </span>
                  <span class="interior-layer-ratio">半径比 ${pct}%</span>
                </div>
                <p class="interior-layer-detail">${layer.detail}</p>
              </div>
            `;
          })
          .join('');
      }
    }

    /**
     * 詳細パネルに太陽のデータをセットする
     */
    function populateSunDetail() {
      if (detailSymbolEl) {
        detailSymbolEl.textContent = sunData.symbol;
        detailSymbolEl.style.color = '#fbbf24';
      }
      if (detailClassBadgeEl) {
        detailClassBadgeEl.textContent = '恒星';
        detailClassBadgeEl.className = 'detail-class-badge badge-star';
      }
      if (detailZoneBadgeEl) {
        detailZoneBadgeEl.textContent = '全縮尺の中心';
      }
      if (detailNameJaEl) detailNameJaEl.textContent = sunData.nameJa;
      if (detailNameEnEl) detailNameEnEl.textContent = sunData.nameEn;
      if (detailCategoryEl) detailCategoryEl.textContent = sunData.category;
      if (detailLiveBoxEl) detailLiveBoxEl.style.display = 'none';

      if (specSmaEl) specSmaEl.textContent = '0.000 AU (太陽系中心)';
      if (specPeriodEl) specPeriodEl.textContent = '銀河系中心を約2.2億年で公転';
      if (specSpeedEl) specSpeedEl.textContent = '約220 km/s (銀河系内)';
      if (specEccEl) specEccEl.textContent = '―';
      if (specDiameterEl) specDiameterEl.textContent = `${sunData.diameterKm.toLocaleString()} km (地球の約109倍)`;
      if (specTempEl) specTempEl.textContent = `自転 ${sunData.rotationPeriodDays}日 / ${sunData.temperatureInfo}`;
      if (detailDescEl) detailDescEl.textContent = sunData.description;
      renderInteriorStructureSection(sunData.interiorStructure);
      if (detailRingsSectionEl) detailRingsSectionEl.style.display = 'none';

      if (detailMoonsSectionEl) detailMoonsSectionEl.style.display = 'block';
      if (detailMoonsHeadingEl) {
        detailMoonsHeadingEl.textContent = simState.isMoonSystemView
          ? '太陽近傍コロナ・探査機最接近圏 ＆ 収録22天体'
          : '収録されている全22天体 (タップで移動)';
      }
      if (detailMoonBadgeEl) {
        detailMoonBadgeEl.textContent = simState.isMoonSystemView
          ? '近傍3基準圏 ＋ 全22天体'
          : '8惑星・9準惑星系・5彗星';
      }
      syncOpenMoonViewButton('sun');
      if (detailMoonsListEl) {
        const sunZonesHtml = (NO_MOON_NEAR_ZONES.sun || [])
          .map(
            (z) => `
              <div class="moon-card" data-moon-card-id="${z.id}">
                <div class="moon-card-header">
                  <span class="moon-card-name">
                    <span class="moon-dot" style="background:${z.color}"></span>
                    ${z.nameJa} <small>(${z.nameEn})</small>
                  </span>
                  <span class="moon-card-period">${z.badgeLabel}</span>
                </div>
                <div class="moon-card-meta">
                  太陽中心からの距離: 約${z.distanceKm.toLocaleString()} km (${z.ratioLabel})
                </div>
                <p class="moon-card-desc">${z.description}</p>
              </div>
            `
          )
          .join('');

        const planetsListHtml = planetsData
          .map((p) => {
            let badgeText = '[惑星]';
            if (p.bodyClass === 'dwarf_planet') {
              badgeText = p.subGroup === 'asteroid_dwarf' ? '[公認準惑星]' : '[公認準惑星・冥王星型]';
            } else if (p.bodyClass === 'dwarf_candidate') {
              badgeText = '[準惑星候補・外縁]';
            } else if (p.bodyClass === 'comet') {
              badgeText = '[周期彗星]';
            }
            const absYears = (Math.abs(p.orbitalPeriodDays) / 365.256).toFixed(1);
            return `
              <div class="moon-card" data-jump-planet="${p.id}">
                <div class="moon-card-header">
                  <span class="moon-card-name" style="color:${p.color}">${p.symbol} ${p.nameJa} <small>${badgeText}</small></span>
                  <span class="moon-card-period">${p.semiMajorAxisAu} AU</span>
                </div>
                <div class="moon-card-meta">公転周期: 約${absYears}年${p.orbitalPeriodDays < 0 ? ' (逆行)' : ''}</div>
              </div>
            `;
          })
          .join('');

        detailMoonsListEl.innerHTML = sunZonesHtml + planetsListHtml;

        detailMoonsListEl.querySelectorAll<HTMLElement>('[data-moon-card-id]').forEach((card) => {
          const zoneId = card.dataset.moonCardId || '';
          card.addEventListener('mouseenter', () => {
            simState.highlightedMoonId = zoneId;
            card.classList.add('active');
          });
          card.addEventListener('mouseleave', () => {
            simState.highlightedMoonId = '';
            card.classList.remove('active');
          });
          card.addEventListener('click', () => {
            simState.highlightedMoonId = simState.highlightedMoonId === zoneId ? '' : zoneId;
            detailMoonsListEl
              .querySelectorAll<HTMLElement>('[data-moon-card-id]')
              .forEach((c) => c.classList.toggle('active', c.dataset.moonCardId === simState.highlightedMoonId));
          });
        });

        detailMoonsListEl.querySelectorAll<HTMLElement>('[data-jump-planet]').forEach((card) => {
          card.addEventListener('click', () => {
            const pid = card.dataset.jumpPlanet;
            if (pid) selectCelestialBody(pid);
          });
        });
      }
    }

    /**
     * 詳細パネルに選択した惑星・準惑星・準惑星候補・彗星とその衛星データをセットする
     */
    function populatePlanetDetail(planet: PlanetData) {
      if (detailSymbolEl) {
        detailSymbolEl.textContent = planet.symbol;
        detailSymbolEl.style.color = planet.color;
      }

      if (detailClassBadgeEl) {
        if (planet.bodyClass === 'dwarf_planet') {
          detailClassBadgeEl.textContent =
            planet.subGroup === 'asteroid_dwarf' ? 'IAU公認 準惑星（小惑星）' : 'IAU公認 準惑星（冥王星型）';
          detailClassBadgeEl.className = 'detail-class-badge badge-dwarf';
        } else if (planet.bodyClass === 'dwarf_candidate') {
          detailClassBadgeEl.textContent = '準惑星候補（大型外縁天体）';
          detailClassBadgeEl.className = 'detail-class-badge badge-candidate';
        } else if (planet.bodyClass === 'comet') {
          detailClassBadgeEl.textContent = '周期彗星 (Periodic Comet)';
          detailClassBadgeEl.className = 'detail-class-badge badge-comet';
        } else {
          detailClassBadgeEl.textContent = '惑星 (Planet)';
          detailClassBadgeEl.className = 'detail-class-badge badge-planet';
        }
      }

      if (detailZoneBadgeEl) {
        const zoneMap: Record<ScaleZone, string> = {
          inner: '1. 内惑星縮尺',
          outer: '2. 外惑星縮尺',
          tno: '3. 外縁天体縮尺',
        };
        detailZoneBadgeEl.textContent = zoneMap[planet.homeZone];
      }

      if (detailNameJaEl) detailNameJaEl.textContent = planet.nameJa;
      if (detailNameEnEl) detailNameEnEl.textContent = planet.nameEn;
      if (detailCategoryEl) detailCategoryEl.textContent = planet.category;
      if (detailLiveBoxEl) detailLiveBoxEl.style.display = 'block';

      const periAu = (planet.semiMajorAxisAu * (1 - planet.eccentricity)).toFixed(2);
      const apheAu = (planet.semiMajorAxisAu * (1 + planet.eccentricity)).toFixed(2);
      const absDays = Math.abs(planet.orbitalPeriodDays);
      const years = (absDays / 365.256).toFixed(2);
      const isRetroOrbit = planet.orbitalPeriodDays < 0;

      if (specSmaEl) specSmaEl.textContent = `${planet.semiMajorAxisAu} AU (${periAu}〜${apheAu} AU)`;
      if (specPeriodEl) {
        specPeriodEl.textContent = `${absDays.toLocaleString()} 日 (約${years} 年${isRetroOrbit ? '・逆行公転' : ''})`;
      }
      if (specSpeedEl) {
        specSpeedEl.textContent =
          planet.bodyClass === 'comet'
            ? `最大 約${planet.orbitalSpeedKms} km/s (近日点)`
            : `${planet.orbitalSpeedKms} km/s`;
      }
      if (specEccEl) specEccEl.textContent = `${planet.eccentricity} / 傾斜 ${planet.inclinationDeg}°`;
      if (specDiameterEl) {
        specDiameterEl.textContent =
          planet.bodyClass === 'comet'
            ? `彗星核 約 ${planet.diameterKm} km`
            : `約 ${planet.diameterKm.toLocaleString()} km`;
      }

      const rotAbs = Math.abs(planet.rotationPeriodHours);
      const rotText = rotAbs >= 48 ? `${(rotAbs / 24).toFixed(1)}日` : `${rotAbs.toFixed(1)}時間`;
      const retroText = planet.rotationPeriodHours < 0 ? ' (逆行)' : '';
      if (specTempEl) specTempEl.textContent = `${rotText}${retroText} / ${planet.temperatureInfo}`;
      if (detailDescEl) detailDescEl.textContent = planet.description;

      // 太陽・8惑星・ケレス・冥王星・エリスの内部・マントル構造を描画
      renderInteriorStructureSection(planet.interiorStructure);

      // 環（リング）を持つ天体の場合、多重環の構造リストを表示
      if (detailRingsSectionEl) {
        if (planet.hasRings && planet.ringSystem) {
          detailRingsSectionEl.style.display = 'block';
          if (detailRingBadgeEl) {
            detailRingBadgeEl.textContent = `${planet.ringSystem.bands.length}層バンド`;
          }
          if (detailRingSummaryEl) {
            detailRingSummaryEl.textContent = planet.ringSystem.labelJa;
          }
          if (detailRingsListEl) {
            detailRingsListEl.innerHTML = planet.ringSystem.bands
              .map(
                (b) => `
                  <div class="ring-band-item">
                    <span class="ring-band-swatch" style="background:${b.color}; opacity:${b.opacity};"></span>
                    <span class="ring-band-name">${b.name}</span>
                    <span class="ring-band-meta">${b.dashArray ? 'アーク / 希薄帯' : '連続環'}</span>
                  </div>
                `
              )
              .join('');
          }
        } else {
          detailRingsSectionEl.style.display = 'none';
        }
      }

      const nearZones = NO_MOON_NEAR_ZONES[planet.id] || [];
      if (detailMoonsSectionEl) detailMoonsSectionEl.style.display = 'block';
      if (detailMoonsHeadingEl) {
        detailMoonsHeadingEl.textContent =
          planet.moons.length > 0
            ? '実装されている主要衛星'
            : nearZones.length > 0
              ? '近傍重力圏・探査軌道（自然衛星 0個）'
              : '実装されている主要衛星';
      }
      if (detailMoonBadgeEl) {
        detailMoonBadgeEl.textContent =
          planet.moons.length > 0
            ? `${planet.moons.length}個`
            : nearZones.length > 0
              ? '自然衛星 0個 / 3基準圏'
              : '0個';
      }
      syncOpenMoonViewButton(planet.id);

      if (detailMoonsListEl) {
        if (planet.moons.length === 0) {
          const baseMsgHtml = `<div class="no-moons-msg">${
            planet.bodyClass === 'comet'
              ? '彗星は太陽接近時に氷が昇華してコマと反太陽方向の尾（テイル）を形成します。'
              : `${planet.nameJa}には既知の自然衛星が確認されていません。`
          }</div>`;

          const nearZonesHtml = nearZones
            .map(
              (z) => `
                <div class="moon-card" data-moon-card-id="${z.id}">
                  <div class="moon-card-header">
                    <span class="moon-card-name">
                      <span class="moon-dot" style="background:${z.color}"></span>
                      ${z.nameJa} <small>(${z.nameEn})</small>
                    </span>
                    <span class="moon-card-period ${z.orbitalPeriodDays < 0 ? 'retro-badge' : ''}">
                      ${z.badgeLabel}
                    </span>
                  </div>
                  <div class="moon-card-meta">
                    基準半径: 約${z.distanceKm.toLocaleString()} km (${z.ratioLabel})
                  </div>
                  <p class="moon-card-desc">${z.description}</p>
                </div>
              `
            )
            .join('');

          detailMoonsListEl.innerHTML = baseMsgHtml + nearZonesHtml;

          detailMoonsListEl.querySelectorAll<HTMLElement>('[data-moon-card-id]').forEach((card) => {
            const zoneId = card.dataset.moonCardId || '';
            card.addEventListener('mouseenter', () => {
              simState.highlightedMoonId = zoneId;
              card.classList.add('active');
            });
            card.addEventListener('mouseleave', () => {
              simState.highlightedMoonId = '';
              card.classList.remove('active');
            });
            card.addEventListener('click', () => {
              simState.highlightedMoonId = simState.highlightedMoonId === zoneId ? '' : zoneId;
              detailMoonsListEl
                .querySelectorAll<HTMLElement>('[data-moon-card-id]')
                .forEach((c) => c.classList.toggle('active', c.dataset.moonCardId === simState.highlightedMoonId));
            });
          });
        } else {
          detailMoonsListEl.innerHTML = planet.moons
            .map((m) => {
              const isRetro = m.orbitalPeriodDays < 0;
              const absPeriod = Math.abs(m.orbitalPeriodDays);
              return `
                <div class="moon-card" data-moon-card-id="${m.id}">
                  <div class="moon-card-header">
                    <span class="moon-card-name">
                      <span class="moon-dot" style="background:${m.color}"></span>
                      ${m.nameJa} <small>(${m.nameEn})</small>
                    </span>
                    <span class="moon-card-period ${isRetro ? 'retro-badge' : ''}">
                      ${isRetro ? '逆行 ' : ''}周期 ${absPeriod}日
                    </span>
                  </div>
                  <div class="moon-card-meta">
                    軌道半径: ${m.distanceKm.toLocaleString()} km / 直径: 約${m.diameterKm.toLocaleString()} km
                  </div>
                  <p class="moon-card-desc">${m.description}</p>
                </div>
              `;
            })
            .join('');

          detailMoonsListEl.querySelectorAll<HTMLElement>('[data-moon-card-id]').forEach((card) => {
            const moonId = card.dataset.moonCardId || '';
            card.addEventListener('mouseenter', () => {
              simState.highlightedMoonId = moonId;
              card.classList.add('active');
            });
            card.addEventListener('mouseleave', () => {
              simState.highlightedMoonId = '';
              card.classList.remove('active');
            });
            card.addEventListener('click', () => {
              simState.highlightedMoonId = simState.highlightedMoonId === moonId ? '' : moonId;
              detailMoonsListEl
                .querySelectorAll<HTMLElement>('[data-moon-card-id]')
                .forEach((c) => c.classList.toggle('active', c.dataset.moonCardId === simState.highlightedMoonId));
            });
          });
        }
      }
    }

    // --- イベントリスナーの登録 ---

    // 1. 3つの表示縮尺（内惑星・外惑星・外縁天体）切り替えボタン ＋ 4. 衛星系拡大専用ビューボタン
    document.querySelectorAll<HTMLButtonElement>('.zone-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const zone = (btn.dataset.scaleZone || 'inner') as ScaleZone;
        switchScaleZone(zone, { keepSelection: false });
      });
    });

    btnMoonSystemModeEl?.addEventListener('click', () => {
      if (simState.isMoonSystemView) {
        closeMoonSystemView({ keepPlanetSelected: true });
      } else {
        openMoonSystemView();
      }
    });

    btnExitMoonViewEl?.addEventListener('click', () => {
      closeMoonSystemView({ keepPlanetSelected: true });
    });

    btnOpenMoonViewEl?.addEventListener('click', () => {
      if (simState.isMoonSystemView) {
        closeMoonSystemView({ keepPlanetSelected: true });
      } else if (moonTargetIds.includes(simState.selectedBodyId)) {
        openMoonSystemView(simState.selectedBodyId);
      }
    });

    document.querySelectorAll<HTMLButtonElement>('.moon-target-pill').forEach((pill) => {
      pill.addEventListener('click', () => {
        const targetId = pill.dataset.moonTargetId;
        if (targetId) {
          openMoonSystemView(targetId);
        }
      });
    });

    // 2. ハンバーガーメニュー内の各トグル制御
    const btnEmphasizeRings = document.getElementById('btn-emphasize-rings');
    const badgeEmphasizeRings = document.getElementById('badge-emphasize-rings');
    btnEmphasizeRings?.addEventListener('click', () => {
      simState.emphasizeRings = !simState.emphasizeRings;
      btnEmphasizeRings.classList.toggle('active', simState.emphasizeRings);
      if (badgeEmphasizeRings) badgeEmphasizeRings.textContent = simState.emphasizeRings ? 'ON' : 'OFF';
    });

    const btnHighlightDwarfs = document.getElementById('btn-highlight-dwarfs');
    const badgeHighlightDwarfs = document.getElementById('badge-highlight-dwarfs');
    btnHighlightDwarfs?.addEventListener('click', () => {
      simState.highlightDwarfs = !simState.highlightDwarfs;
      btnHighlightDwarfs.classList.toggle('active', simState.highlightDwarfs);
      if (badgeHighlightDwarfs) badgeHighlightDwarfs.textContent = simState.highlightDwarfs ? 'ON' : 'OFF';
    });

    const btnHighlightComets = document.getElementById('btn-highlight-comets');
    const badgeHighlightComets = document.getElementById('badge-highlight-comets');
    btnHighlightComets?.addEventListener('click', () => {
      simState.highlightComets = !simState.highlightComets;
      btnHighlightComets.classList.toggle('active', simState.highlightComets);
      if (badgeHighlightComets) badgeHighlightComets.textContent = simState.highlightComets ? 'ON' : 'OFF';
    });

    const btnToggleMoons = document.getElementById('btn-toggle-moons');
    const badgeToggleMoons = document.getElementById('badge-toggle-moons');
    btnToggleMoons?.addEventListener('click', () => {
      simState.showMoons = !simState.showMoons;
      btnToggleMoons.classList.toggle('active', simState.showMoons);
      if (badgeToggleMoons) badgeToggleMoons.textContent = simState.showMoons ? 'ON' : 'OFF';
    });

    const btnToggleComets = document.getElementById('btn-toggle-comets');
    const badgeToggleComets = document.getElementById('badge-toggle-comets');
    function updateCometsToggleUi() {
      btnToggleComets?.classList.toggle('active', simState.showComets);
      if (badgeToggleComets) badgeToggleComets.textContent = simState.showComets ? 'ON' : 'OFF';
    }
    btnToggleComets?.addEventListener('click', () => {
      simState.showComets = !simState.showComets;
      updateCometsToggleUi();
    });

    // 2D真上視点 ⇔ 3D斜めチルト視点
    const btnView2d = document.getElementById('btn-view-2d');
    const btnView3d = document.getElementById('btn-view-3d');
    btnView2d?.addEventListener('click', () => {
      btnView2d.classList.add('active');
      btnView3d?.classList.remove('active');
      gsap.to(simState, {
        tiltY: 1.0,
        duration: 0.85,
        ease: 'power3.inOut',
      });
    });
    btnView3d?.addEventListener('click', () => {
      btnView3d.classList.add('active');
      btnView2d?.classList.remove('active');
      gsap.to(simState, {
        tiltY: 0.44,
        duration: 0.85,
        ease: 'power3.inOut',
      });
    });

    // 自動間隔調整 ⇔ 実距離比(AU)
    const btnScaleEqual = document.getElementById('btn-scale-equal');
    const btnScaleReal = document.getElementById('btn-scale-real');
    btnScaleEqual?.addEventListener('click', () => {
      btnScaleEqual.classList.add('active');
      btnScaleReal?.classList.remove('active');
      gsap.to(simState, {
        auRatioBlend: 0.0,
        duration: 0.85,
        ease: 'expo.out',
      });
    });
    btnScaleReal?.addEventListener('click', () => {
      btnScaleReal.classList.add('active');
      btnScaleEqual?.classList.remove('active');
      gsap.to(simState, {
        auRatioBlend: 1.0,
        duration: 0.85,
        ease: 'expo.out',
      });
    });

    // 3. クイック選択バーのボタンクリック
    document.querySelectorAll<HTMLButtonElement>('.nav-pill').forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetId = btn.dataset.targetId || 'overview';
        selectCelestialBody(targetId);
      });
    });

    // 4. SVG内の太陽・各天体ノードのクリック
    document.querySelectorAll<SVGGElement>('.celestial-node').forEach((node) => {
      node.addEventListener('click', (e) => {
        e.stopPropagation();
        const bodyId = node.dataset.bodyId;
        if (bodyId) selectCelestialBody(bodyId);
      });
      node.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          const bodyId = node.dataset.bodyId;
          if (bodyId) selectCelestialBody(bodyId);
        }
      });
    });

    // 5. 詳細パネルの閉じるボタン・縮尺基準リセットボタン
    document.getElementById('btn-close-detail')?.addEventListener('click', () => {
      if (simState.isMoonSystemView) {
        closeMoonSystemView({ keepPlanetSelected: false });
      } else {
        selectCelestialBody('overview');
      }
    });
    document.getElementById('btn-reset-camera')?.addEventListener('click', () => {
      if (simState.isMoonSystemView) {
        gsap.to(simState, {
          cameraX: 0,
          cameraY: 0,
          cameraZoom: 1.0,
          duration: 0.65,
          ease: 'power3.out',
        });
      } else {
        switchScaleZone(simState.activeZone, { keepSelection: false });
      }
    });

    // 6. 再生 / 一時停止 / 順転 / 逆転 / 倍速変更
    const btnPlayPause = document.getElementById('btn-play-pause');
    const btnReverse = document.getElementById('btn-reverse');
    const btnForward = document.getElementById('btn-forward');

    function setPlayingState(playing: boolean) {
      simState.isPlaying = playing;
      if (btnPlayPause) {
        btnPlayPause.textContent = playing ? '⏸ 一時停止' : '▶ 再生';
        btnPlayPause.classList.toggle('is-paused', !playing);
      }
      updateSpeedHud();
    }

    btnPlayPause?.addEventListener('click', () => {
      setPlayingState(!simState.isPlaying);
    });

    btnReverse?.addEventListener('click', () => {
      simState.direction = -1;
      btnReverse.classList.add('active');
      btnForward?.classList.remove('active');
      if (!simState.isPlaying) setPlayingState(true);
      updateSpeedHud();
    });

    btnForward?.addEventListener('click', () => {
      simState.direction = 1;
      btnForward.classList.add('active');
      btnReverse?.classList.remove('active');
      if (!simState.isPlaying) setPlayingState(true);
      updateSpeedHud();
    });

    document.querySelectorAll<HTMLButtonElement>('.speed-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const spd = Number(btn.dataset.speed || 10);
        simState.speedDaysPerSec = spd;
        document.querySelectorAll('.speed-btn').forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        updateSpeedHud();
      });
    });

    // 7. タイムスライダー（早見スクラブ操作）
    timeSliderEl?.addEventListener('input', () => {
      const offsetDays = Number(timeSliderEl.value || 0);
      simState.elapsedDays = simState.sliderAnchorDays + offsetDays;
      if (scrubberOffsetEl) {
        const sign = offsetDays >= 0 ? '+' : '';
        scrubberOffsetEl.textContent = `基準日 ${sign}${Math.round(offsetDays)}日`;
      }
    });

    timeSliderEl?.addEventListener('change', () => {
      simState.sliderAnchorDays = simState.elapsedDays;
      gsap.to(timeSliderEl, {
        value: 0,
        duration: 0.35,
        ease: 'power2.out',
        onComplete: () => {
          if (scrubberOffsetEl) scrubberOffsetEl.textContent = '基準日 +0日';
        },
      });
    });

    // 8. 日付ピッカー・「今日」ボタン
    dateInputEl?.addEventListener('change', () => {
      if (!dateInputEl.value) return;
      const targetTime = Date.parse(`${dateInputEl.value}T12:00:00Z`);
      if (Number.isNaN(targetTime)) return;
      const targetDays = (targetTime - j2000Timestamp) / MS_PER_DAY;
      simState.sliderAnchorDays = targetDays;
      gsap.to(simState, {
        elapsedDays: targetDays,
        duration: 0.95,
        ease: 'power3.out',
      });
    });

    document.getElementById('btn-today')?.addEventListener('click', () => {
      const todayDays = (Date.now() - j2000Timestamp) / MS_PER_DAY;
      simState.sliderAnchorDays = todayDays;
      gsap.to(simState, {
        elapsedDays: todayDays,
        duration: 0.9,
        ease: 'power3.out',
      });
    });

    // 9. ズームボタン・マウスホイール・マルチタッチ（ピンチズーム＆スワイプパン）操作
    document.getElementById('btn-zoom-in')?.addEventListener('click', () => {
      gsap.to(simState, {
        cameraZoom: Math.min(simState.cameraZoom * 1.35, 8.0),
        duration: 0.4,
        ease: 'power2.out',
      });
    });
    document.getElementById('btn-zoom-out')?.addEventListener('click', () => {
      gsap.to(simState, {
        cameraZoom: Math.max(simState.cameraZoom / 1.35, 0.38),
        duration: 0.4,
        ease: 'power2.out',
      });
    });

    const viewportEl = document.getElementById('viewport-container');
    viewportEl?.addEventListener(
      'wheel',
      (e) => {
        e.preventDefault();
        const factor = e.deltaY < 0 ? 1.14 : 0.88;
        const nextZoom = Math.min(Math.max(simState.cameraZoom * factor, 0.38), 8.5);
        gsap.to(simState, {
          cameraZoom: nextZoom,
          duration: 0.25,
          ease: 'power2.out',
        });
      },
      { passive: false }
    );

    // マルチポインタ（1本指パン ＆ 2本指ピンチズーム）管理
    const activePointers = new Map<number, { x: number; y: number }>();
    let isDragging = false;
    let dragStartX = 0;
    let dragStartY = 0;
    let cameraStartX = 0;
    let cameraStartY = 0;
    let initialPinchDist = 0;
    let initialPinchZoom = 1.0;

    function getPinchDistance(): number {
      const pts = Array.from(activePointers.values());
      if (pts.length < 2) return 0;
      return Math.hypot(pts[0].x - pts[1].x, pts[0].y - pts[1].y);
    }

    svgEl?.addEventListener('pointerdown', (e) => {
      const target = e.target as Element;
      if (target.closest('.celestial-node, .ms-moon-node')) return;

      activePointers.set(e.pointerId, { x: e.clientX, y: e.clientY });
      svgEl.setPointerCapture(e.pointerId);

      if (activePointers.size === 1) {
        isDragging = true;
        dragStartX = e.clientX;
        dragStartY = e.clientY;
        cameraStartX = simState.cameraX;
        cameraStartY = simState.cameraY;
        svgEl.style.cursor = 'grabbing';
      } else if (activePointers.size === 2) {
        // 2本指タッチ開始：ピンチズームモードへ移行
        isDragging = false;
        initialPinchDist = getPinchDistance();
        initialPinchZoom = simState.cameraZoom;
      }
    });

    svgEl?.addEventListener('pointermove', (e) => {
      if (!activePointers.has(e.pointerId) || !svgEl) return;
      activePointers.set(e.pointerId, { x: e.clientX, y: e.clientY });

      if (activePointers.size === 2 && initialPinchDist > 10) {
        const currentDist = getPinchDistance();
        const scaleRatio = currentDist / initialPinchDist;
        simState.cameraZoom = Math.min(Math.max(initialPinchZoom * scaleRatio, 0.38), 8.5);
        return;
      }

      if (isDragging && activePointers.size === 1) {
        const rect = svgEl.getBoundingClientRect();
        const svgScale = 1280 / Math.min(rect.width, rect.height);
        const dx = ((e.clientX - dragStartX) * svgScale) / simState.cameraZoom;
        const dy = ((e.clientY - dragStartY) * svgScale) / simState.cameraZoom;

        if (
          !simState.isMoonSystemView &&
          simState.selectedBodyId !== 'overview' &&
          Math.hypot(e.clientX - dragStartX, e.clientY - dragStartY) > 12
        ) {
          simState.selectedBodyId = 'overview';
          document.querySelectorAll<HTMLButtonElement>('.nav-pill').forEach((btn) => {
            btn.classList.toggle('active', btn.dataset.targetId === 'overview');
          });
        }

        simState.cameraX = cameraStartX - dx;
        simState.cameraY = cameraStartY - dy;
      }
    });

    function handlePointerUpOrCancel(e: PointerEvent) {
      activePointers.delete(e.pointerId);
      if (activePointers.size < 2) {
        initialPinchDist = 0;
      }
      if (activePointers.size === 0 && svgEl) {
        isDragging = false;
        svgEl.style.cursor = 'grab';
      }
    }

    svgEl?.addEventListener('pointerup', handlePointerUpOrCancel);
    svgEl?.addEventListener('pointercancel', handlePointerUpOrCancel);

    // キーボードショートカット
    window.addEventListener('keydown', (e) => {
      if (e.target instanceof HTMLInputElement) return;
      if (e.code === 'Space') {
        e.preventDefault();
        setPlayingState(!simState.isPlaying);
      } else if (e.code === 'Escape') {
        if (isDrawerOpen) {
          setDrawerOpen(false);
        } else {
          selectCelestialBody('overview');
        }
      } else if (e.key === '1') {
        switchScaleZone('inner');
      } else if (e.key === '2') {
        switchScaleZone('outer');
      } else if (e.key === '3') {
        switchScaleZone('tno');
      } else if (e.key === '4') {
        openMoonSystemView();
      }
    });

    // 初期状態の設定
    if (menuDrawerEl) {
      gsap.set(menuDrawerEl, { x: 340, autoAlpha: 0 });
    }
    if (detailPanelEl) {
      const mobile = isMobileSheetLayout();
      gsap.set(detailPanelEl, { x: mobile ? 0 : 420, y: mobile ? 480 : 0, autoAlpha: 0 });
    }
    switchScaleZone('inner', { keepSelection: false });
    updateSpeedHud();

    // --- 背景星空キャンバスの描画 ---
    const canvas = document.getElementById('starfield-canvas') as HTMLCanvasElement | null;
    if (canvas) {
      const ctx = canvas.getContext('2d');
      const stars: { x: number; y: number; r: number; alpha: number; color: string }[] = [];

      function initStars() {
        if (!canvas || !ctx) return;
        canvas.width = window.innerWidth;
        canvas.height = window.innerHeight;
        stars.length = 0;
        const count = Math.floor((canvas.width * canvas.height) / 3800);
        const palette = ['#ffffff', '#e0f2fe', '#fef3c7', '#cbd5e1'];
        for (let i = 0; i < count; i++) {
          stars.push({
            x: Math.random() * canvas.width,
            y: Math.random() * canvas.height,
            r: Math.random() * 1.35 + 0.25,
            alpha: Math.random() * 0.75 + 0.15,
            color: palette[Math.floor(Math.random() * palette.length)],
          });
        }
        drawStars();
      }

      function drawStars() {
        if (!canvas || !ctx) return;
        ctx.clearRect(0, 0, canvas.width, canvas.height);

        const grad = ctx.createRadialGradient(
          canvas.width * 0.5,
          canvas.height * 0.5,
          20,
          canvas.width * 0.5,
          canvas.height * 0.5,
          Math.max(canvas.width, canvas.height) * 0.7
        );
        grad.addColorStop(0, 'rgba(15, 25, 55, 0.55)');
        grad.addColorStop(0.5, 'rgba(6, 11, 26, 0.85)');
        grad.addColorStop(1, 'rgba(3, 5, 14, 1)');
        ctx.fillStyle = grad;
        ctx.fillRect(0, 0, canvas.width, canvas.height);

        for (const s of stars) {
          ctx.globalAlpha = s.alpha;
          ctx.fillStyle = s.color;
          ctx.beginPath();
          ctx.arc(s.x, s.y, s.r, 0, Math.PI * 2);
          ctx.fill();
        }
        ctx.globalAlpha = 1;
      }

      initStars();
      window.addEventListener('resize', () => {
        initStars();
        // 画面回転・リサイズ時に非表示状態の詳細パネル待機座標を更新
        if (detailPanelEl && simState.selectedBodyId === 'overview') {
          const mobile = isMobileSheetLayout();
          gsap.set(detailPanelEl, { x: mobile ? 0 : 420, y: mobile ? 480 : 0, autoAlpha: 0 });
        }
      });
    }
  }
</script>

