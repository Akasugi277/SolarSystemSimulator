    /**
     * 探査機・彗星の多面体シンボルを描画するためのSVGヘルパー
     * - 彗星: 正六面体（等角投影の立方体）
     * - 探査機: 正四面体
     */
    const SVG_NS = 'http://www.w3.org/2000/svg';

    function shadeColor(hex: string, factor: number): string {
      const m = /^#?([0-9a-f]{6})$/i.exec(hex);
      if (!m) return hex;
      const n = parseInt(m[1], 16);
      const r = Math.min(255, Math.round(((n >> 16) & 255) * factor));
      const g = Math.min(255, Math.round(((n >> 8) & 255) * factor));
      const b = Math.min(255, Math.round((n & 255) * factor));
      return `rgb(${r}, ${g}, ${b})`;
    }

    /**
     * 外接円の半径1の正六面体（立方体）を3面シェーディングで描画した子要素を group に追加する
     */
    function appendCubeShape(group: SVGElement, color: string) {
      const k = 0.866;
      const pts = {
        top: '0,-1',
        ur: `${k},-0.5`,
        lr: `${k},0.5`,
        bottom: '0,1',
        ll: `-${k},0.5`,
        ul: `-${k},-0.5`,
        c: '0,0',
      };
      const faces: [string, string][] = [
        [`${pts.top} ${pts.ur} ${pts.c} ${pts.ul}`, shadeColor(color, 1.18)],
        [`${pts.ul} ${pts.c} ${pts.bottom} ${pts.ll}`, shadeColor(color, 0.78)],
        [`${pts.c} ${pts.ur} ${pts.lr} ${pts.bottom}`, shadeColor(color, 0.55)],
      ];
      for (const [points, fill] of faces) {
        const poly = document.createElementNS(SVG_NS, 'polygon');
        poly.setAttribute('points', points);
        poly.setAttribute('fill', fill);
        poly.setAttribute('stroke', 'rgba(4, 7, 17, 0.75)');
        poly.setAttribute('stroke-width', '0.12');
        poly.setAttribute('stroke-linejoin', 'round');
        group.appendChild(poly);
      }
    }

    /**
     * 外接円の半径1の正四面体（探査機）を3面シェーディングで描画した子要素を group に追加する
     * （外周の三角形＋手前側頂点から3頂点への稜線で立体感を出す）
     */
    function appendTetrahedronShape(group: SVGElement, color: string) {
      const A = '0,-1';
      const B = '-0.94,0.62';
      const C = '0.94,0.62';
      const D = '0.1,0.18';
      const faces: [string, string][] = [
        [`${A} ${B} ${D}`, shadeColor(color, 1.15)],
        [`${A} ${D} ${C}`, shadeColor(color, 0.8)],
        [`${B} ${C} ${D}`, shadeColor(color, 0.55)],
      ];
      for (const [points, fill] of faces) {
        const poly = document.createElementNS(SVG_NS, 'polygon');
        poly.setAttribute('points', points);
        poly.setAttribute('fill', fill);
        poly.setAttribute('stroke', 'rgba(4, 7, 17, 0.8)');
        poly.setAttribute('stroke-width', '0.1');
        poly.setAttribute('stroke-linejoin', 'round');
        group.appendChild(poly);
      }
    }

    function normalizeDegrees(deg: number): number {
      const mod = deg % 360;
      return mod < 0 ? mod + 360 : mod;
    }

    function lerp(a: number, b: number, t: number): number {
      return a + (b - a) * t;
    }

    /**
     * ケプラー方程式 M = E - e * sin(E) をニュートン法で解く（高離心率の彗星にも対応するため8回反復）
     */
    function solveKeplerEquation(meanAnomalyRad: number, eccentricity: number): number {
      let E = eccentricity > 0.8 ? Math.PI : meanAnomalyRad;
      for (let i = 0; i < 8; i++) {
        const f = E - eccentricity * Math.sin(E) - meanAnomalyRad;
        const fPrime = 1 - eccentricity * Math.cos(E);
        E = E - f / Math.max(0.05, fPrime);
      }
      return E;
    }

    /**
     * 離心率・近日点黄経・軌道傾斜角・昇交点黄経・3Dチルト・強調倍率を反映した
     * 3D黄道直交座標系および画面2D投影座標を算出する
     */
    function computeOrbitPointPx(
      eccentricAnomalyRad: number,
      semiMajorPx: number,
      displayEccentricity: number,
      perihelionDeg: number,
      inclinationDeg: number,
      ascendingNodeDeg: number,
      tiltY: number,
      inclinationBoost: number = 1.0
    ): { x: number; y: number; eclipticY: number; zPx: number; sin2D: number } {
      const semiMinorPx = semiMajorPx * Math.sqrt(Math.max(0.01, 1 - displayEccentricity * displayEccentricity));
      const localX = semiMajorPx * (Math.cos(eccentricAnomalyRad) - displayEccentricity);
      const localY = semiMinorPx * Math.sin(eccentricAnomalyRad);

      // 3D斜めチルト視点へのブレンド率 (2D真上=0.0 ⇔ 3D斜め=1.0)
      const view3dFactor = Math.max(0, Math.min(1, (1.0 - tiltY) / (1.0 - 0.44)));

      // 軌道傾斜角（3D視点時にスムーズに立ち上がり、設定倍率で強調）
      const effectiveIncDeg = inclinationDeg * view3dFactor * inclinationBoost;
      const effectiveIncRad = effectiveIncDeg * DEG_TO_RAD;
      const cosI = Math.cos(effectiveIncRad);
      const sinI = Math.sin(effectiveIncRad);

      const omegaDeg = perihelionDeg - ascendingNodeDeg;
      const omegaRad = omegaDeg * DEG_TO_RAD;
      const nodeRad = ascendingNodeDeg * DEG_TO_RAD;

      const cosW = Math.cos(omegaRad);
      const sinW = Math.sin(omegaRad);
      const cosN = Math.cos(nodeRad);
      const sinN = Math.sin(nodeRad);

      // 1. 軌道面内での近日点引数（ω）回転
      const xOrb = localX * cosW - localY * sinW;
      const yOrb = localX * sinW + localY * cosW;

      // 2. 黄道座標系直交座標 (X: 春分点方向, Y_math: 黄経90°方向, Z_math: 黄道北極方向)
      const X = xOrb * cosN - yOrb * cosI * sinN;
      const Y_math = xOrb * sinN + yOrb * cosI * cosN;
      const Z_math = yOrb * sinI;

      // 3. SVG画面系への射影（SVGでは下向きが+Yなので Y_2d = -Y_math）
      const y2d = -Y_math;
      const eclipticY = y2d * tiltY;

      // 4. 3D斜め視点（カメラが手前上空から見下ろすピッチ傾斜）
      // 黄道面より上 (+Z) は画面上側 (-y)、黄道面より下 (-Z) は画面下側 (+y) へ投影
      const sinCameraPitch = Math.sqrt(Math.max(0, 1 - tiltY * tiltY));
      const screenY = eclipticY - Z_math * sinCameraPitch;

      return {
        x: X,
        y: screenY,
        eclipticY,
        zPx: Z_math,
        sin2D: -Y_math / Math.max(1, semiMajorPx),
      };
    }

    /**
     * 3D空間におけるケプラー楕円軌道のSVG Pathデータ文字列を生成する
     */
    function buildOrbitPathD(
      semiMajorPx: number,
      displayEccentricity: number,
      perihelionDeg: number,
      inclinationDeg: number,
      ascendingNodeDeg: number,
      tiltY: number,
      inclinationBoost: number = 1.0
    ): string {
      const steps = 96;
      const parts: string[] = [];
      for (let i = 0; i <= steps; i++) {
        const E = (i / steps) * Math.PI * 2;
        const pt = computeOrbitPointPx(
          E,
          semiMajorPx,
          displayEccentricity,
          perihelionDeg,
          inclinationDeg,
          ascendingNodeDeg,
          tiltY,
          inclinationBoost
        );
        parts.push(`${i === 0 ? 'M' : 'L'}${pt.x.toFixed(1)},${pt.y.toFixed(1)}`);
      }
      parts.push('Z');
      return parts.join(' ');
    }

    function formatDaysToDateString(days: number): string {
      const ms = j2000Timestamp + days * MS_PER_DAY;
      const d = new Date(ms);
      const year = d.getUTCFullYear();
      const month = String(d.getUTCMonth() + 1).padStart(2, '0');
      const day = String(d.getUTCDate()).padStart(2, '0');
      return `${year}-${month}-${day}`;
    }

    /**
     * 太陽・黄経グリッド・小惑星帯・カイパーベルトの描画を更新する
     * （各レイヤーのパラメータが変化していないフレームではDOMの属性書き換えを省略し、負荷を抑える）
     */
    let lastSunGridKey = '';
    let lastMainBeltKey = '';
    let lastKuiperBeltKey = '';

    function updateSunGridAndBelts() {
      const tiltY = simState.tiltY;
      const sunR = simState.sunRadiusPx;

      const sunGridKey = `${sunR.toFixed(2)}|${tiltY.toFixed(3)}|${simState.activeZone}`;
      if (sunGridKey !== lastSunGridKey) {
        lastSunGridKey = sunGridKey;
        if (sunSphereEl) sunSphereEl.setAttribute('r', sunR.toFixed(2));
        if (sunCoronaInnerEl) sunCoronaInnerEl.setAttribute('r', (sunR * 1.25).toFixed(2));
        if (sunCoronaOuterEl) sunCoronaOuterEl.setAttribute('r', (sunR * 1.62).toFixed(2));
        if (sunCoronaRaysEl) sunCoronaRaysEl.setAttribute('transform', `scale(${(sunR / 22).toFixed(3)})`);
        if (sunSurfaceTextureEl) sunSurfaceTextureEl.setAttribute('transform', `scale(${(sunR / 22).toFixed(3)})`);
        if (sunLabelEl) {
          sunLabelEl.setAttribute('y', (sunR + 13).toFixed(1));
          sunLabelEl.style.opacity = simState.activeZone === 'tno' ? '0.6' : '1';
        }

        const maxRadius = 575;
        if (eclipticBaseDiskEl) {
          eclipticBaseDiskEl.setAttribute('rx', maxRadius.toFixed(1));
          eclipticBaseDiskEl.setAttribute('ry', (maxRadius * tiltY).toFixed(1));
        }
        if (gridOuterRingEl) {
          gridOuterRingEl.setAttribute('rx', maxRadius.toFixed(1));
          gridOuterRingEl.setAttribute('ry', (maxRadius * tiltY).toFixed(1));
        }
        const innerSpokeStart = Math.max(20, sunR + 12);
        for (const tick of gridTicks) {
          const rad = -tick.deg * DEG_TO_RAD;
          const cosA = Math.cos(rad);
          const sinA = Math.sin(rad);
          const x2 = cosA * maxRadius;
          const y2 = sinA * maxRadius * tiltY;
          const lx = cosA * (maxRadius + 22);
          const ly = sinA * (maxRadius + 22) * tiltY + 4;
          if (tick.lineEl) {
            tick.lineEl.setAttribute('x1', (cosA * innerSpokeStart).toFixed(1));
            tick.lineEl.setAttribute('y1', (sinA * innerSpokeStart * tiltY).toFixed(1));
            tick.lineEl.setAttribute('x2', x2.toFixed(1));
            tick.lineEl.setAttribute('y2', y2.toFixed(1));
          }
          if (tick.textEl) {
            tick.textEl.setAttribute('x', lx.toFixed(1));
            tick.textEl.setAttribute('y', ly.toFixed(1));
          }
        }
      }

      const d = simState.elapsedDays;
      const animT = simState.visualAnimSec;
      const auBlend = simState.auRatioBlend;
      const TAU = Math.PI * 2;
      const tiltDepthFactor = 1 - tiltY;

      // 小惑星帯（メインベルト）の多層半透明バンド＆240個の透明微惑星粒子のケプラー公転・煌めき更新
      if (mainBeltGroupEl) {
        mainBeltGroupEl.style.opacity = simState.mainBeltOpacity.toFixed(2);
        mainBeltGroupEl.style.display = simState.mainBeltOpacity < 0.02 ? 'none' : 'block';
      }
      if (mainBeltBandEl && simState.mainBeltOpacity >= 0.02) {
        const ceresAuR = bodyAnimState['ceres']?.auOrbitRadiusPx ?? simState.mainBeltRadiusPx;
        const mainCenterR = lerp(simState.mainBeltRadiusPx, ceresAuR, auBlend);
        const mainWidth = simState.mainBeltWidthPx * lerp(1.0, 1.18, auBlend);
        const mainBeltKey = `${mainCenterR.toFixed(1)}|${mainWidth.toFixed(1)}|${tiltY.toFixed(3)}|${d.toFixed(2)}|${animT.toFixed(2)}`;
        if (mainBeltKey !== lastMainBeltKey) {
          lastMainBeltKey = mainBeltKey;
          if (mainBeltHaloEl) {
            mainBeltHaloEl.setAttribute('rx', mainCenterR.toFixed(1));
            mainBeltHaloEl.setAttribute('ry', (mainCenterR * tiltY).toFixed(1));
            mainBeltHaloEl.setAttribute('stroke-width', (mainWidth * 1.65).toFixed(1));
          }
          mainBeltBandEl.setAttribute('rx', mainCenterR.toFixed(1));
          mainBeltBandEl.setAttribute('ry', (mainCenterR * tiltY).toFixed(1));
          mainBeltBandEl.setAttribute('stroke-width', mainWidth.toFixed(1));

          for (const p of mainBeltParticlesDom) {
            // 反時計回り（順行）ケプラー公転 ＋ 実時間ドリフト
            const curAngle = p.angle - (TAU / p.periodDays) * d - p.visualSpeed * animT;
            const cosA = Math.cos(curAngle);
            const sinA = Math.sin(curAngle);
            const eccRadialWave = Math.cos(curAngle + p.phase) * p.ecc * mainWidth;
            const r = mainCenterR + p.offset * mainWidth + eccRadialWave;

            p.el.setAttribute('cx', (cosA * r).toFixed(1));
            p.el.setAttribute('cy', (sinA * r * tiltY).toFixed(1));

            // 3Dチルト時の奥行き透明度変調と微細なシンチレーション（透明感のゆらぎ）
            const shimmer = 0.78 + 0.22 * Math.sin(animT * p.shimmerSpeed + p.phase);
            const depthAlpha = 1 + sinA * tiltDepthFactor * 0.28;
            const alpha = Math.max(0.04, Math.min(0.75, p.baseOpacity * shimmer * depthAlpha));
            p.el.setAttribute('fill-opacity', alpha.toFixed(3));
          }
        }
      }

      // エッジワース・カイパーベルトの多層半透明バンド＆320個の透明氷粒子のケプラー公転・煌めき更新
      if (kuiperBeltGroupEl) {
        kuiperBeltGroupEl.style.opacity = simState.kuiperBeltOpacity.toFixed(2);
        kuiperBeltGroupEl.style.display = simState.kuiperBeltOpacity < 0.02 ? 'none' : 'block';
      }
      if (kuiperBeltBandEl && simState.kuiperBeltOpacity >= 0.02) {
        const haumeaAuR = bodyAnimState['haumea']?.auOrbitRadiusPx ?? simState.kuiperBeltRadiusPx;
        const kuiperCenterR = lerp(simState.kuiperBeltRadiusPx, haumeaAuR, auBlend);
        const kuiperWidth = simState.kuiperBeltWidthPx * lerp(1.0, 1.12, auBlend);
        const kuiperBeltKey = `${kuiperCenterR.toFixed(1)}|${kuiperWidth.toFixed(1)}|${tiltY.toFixed(3)}|${d.toFixed(2)}|${animT.toFixed(2)}`;
        if (kuiperBeltKey !== lastKuiperBeltKey) {
          lastKuiperBeltKey = kuiperBeltKey;
          if (kuiperBeltHaloEl) {
            kuiperBeltHaloEl.setAttribute('rx', kuiperCenterR.toFixed(1));
            kuiperBeltHaloEl.setAttribute('ry', (kuiperCenterR * tiltY).toFixed(1));
            kuiperBeltHaloEl.setAttribute('stroke-width', (kuiperWidth * 1.55).toFixed(1));
          }
          kuiperBeltBandEl.setAttribute('rx', kuiperCenterR.toFixed(1));
          kuiperBeltBandEl.setAttribute('ry', (kuiperCenterR * tiltY).toFixed(1));
          kuiperBeltBandEl.setAttribute('stroke-width', kuiperWidth.toFixed(1));

          for (const p of kuiperBeltParticlesDom) {
            const curAngle = p.angle - (TAU / p.periodDays) * d - p.visualSpeed * animT;
            const cosA = Math.cos(curAngle);
            const sinA = Math.sin(curAngle);
            const eccRadialWave = Math.cos(curAngle + p.phase) * p.ecc * kuiperWidth;
            const r = kuiperCenterR + p.offset * kuiperWidth + eccRadialWave;

            p.el.setAttribute('cx', (cosA * r).toFixed(1));
            p.el.setAttribute('cy', (sinA * r * tiltY).toFixed(1));

            const shimmer = 0.76 + 0.24 * Math.sin(animT * p.shimmerSpeed + p.phase);
            const depthAlpha = 1 + sinA * tiltDepthFactor * 0.28;
            const alpha = Math.max(0.04, Math.min(0.72, p.baseOpacity * shimmer * depthAlpha));
            p.el.setAttribute('fill-opacity', alpha.toFixed(3));
          }
        }
      }
    }

    /**
     * 全27天体（8惑星・5公認準惑星・9準惑星候補・5周期彗星）および全衛星の軌道位置を更新するメイン関数
     */
    function renderSolarSystem() {
      const d = simState.elapsedDays;
      const tiltY = simState.tiltY;
      const auBlend = simState.auRatioBlend;

      const invZoomLabelScale = 1 / Math.pow(Math.max(1, simState.cameraZoom), 0.55);

      // 衛星公転用の時間を差分積算（高速再生時は速度に反比例して減速し、速度変更・一時停止・日付ジャンプでも位置が連続する）
      const clockDelta = simState.elapsedDays - simState.lastClockElapsedDays;
      simState.lastClockElapsedDays = simState.elapsedDays;
      const spd = simState.speedDaysPerSec;
      simState.moonTimeDays += clockDelta * (spd > 12 ? 6 / spd : 1);
      simState.msMoonTimeDays += clockDelta * (spd > 12 ? 3.5 / spd : 1);

      // 拡大専用ビュー中は黄経グリッド・小惑星帯・カイパーベルトが非表示なので更新を省略する
      if (!simState.isMoonSystemView) {
        updateSunGridAndBelts();
      }

      for (const item of cachedPlanets) {
        const p = item.data;
        const anim = bodyAnimState[p.id];

        const isSelected = simState.selectedBodyId === p.id;
        const isComet = p.bodyClass === 'comet';

        // 彗星表示がOFFのときは選択時以外非表示
        if (isComet && !simState.showComets && !isSelected) {
          if (item.orbitEl) item.orbitEl.style.display = 'none';
          if (item.nodeEl) item.nodeEl.style.display = 'none';
          continue;
        }

        const effectiveOpacity = isSelected ? 1.0 : anim.opacity;

        if (effectiveOpacity < 0.02) {
          if (item.orbitEl) item.orbitEl.style.display = 'none';
          if (item.nodeEl) item.nodeEl.style.display = 'none';
          continue;
        }
        if (item.orbitEl) item.orbitEl.style.display = 'block';
        if (item.nodeEl) item.nodeEl.style.display = 'block';

        const displaySemiMajorPx = lerp(anim.autoOrbitRadiusPx, anim.auOrbitRadiusPx, auBlend);
        const displayEcc = anim.displayEcc;
        const isDwarfOrCandidate = p.bodyClass === 'dwarf_planet' || p.bodyClass === 'dwarf_candidate';

        // 軌道パスの更新（軌道形状のパラメータが変化したときだけパスを再生成する）
        if (item.orbitEl) {
          const orbitKey = `${displaySemiMajorPx.toFixed(1)}|${displayEcc.toFixed(4)}|${tiltY.toFixed(3)}|${p.inclinationDeg}|${simState.inclinationBoost}`;
          if (orbitKey !== item.lastOrbitKey) {
            item.lastOrbitKey = orbitKey;
            item.orbitEl.setAttribute(
              'd',
              buildOrbitPathD(
                displaySemiMajorPx,
                displayEcc,
                p.perihelionLongitudeDeg,
                p.inclinationDeg,
                p.ascendingNodeLongitudeDeg,
                tiltY,
                simState.inclinationBoost
              )
            );
          }
          let orbitAlpha = effectiveOpacity;
          if (simState.highlightDwarfs && !simState.highlightComets) {
            orbitAlpha = isDwarfOrCandidate ? 1.0 : effectiveOpacity * 0.18;
          } else if (simState.highlightComets && !simState.highlightDwarfs) {
            orbitAlpha = isComet ? 1.0 : effectiveOpacity * 0.18;
          } else if (simState.highlightDwarfs && simState.highlightComets) {
            orbitAlpha = isDwarfOrCandidate || isComet ? 1.0 : effectiveOpacity * 0.18;
          }
          item.orbitEl.style.opacity = orbitAlpha.toFixed(2);
        }

        // 平均近点角 M とケプラー方程式の解 E（負の公転周期＝逆行公転にも対応）
        const meanMotionDegPerDay = 360 / p.orbitalPeriodDays;
        const meanAnomalyDeg = normalizeDegrees(
          p.meanLongitudeDeg - p.perihelionLongitudeDeg + meanMotionDegPerDay * d
        );
        const meanAnomalyRad = meanAnomalyDeg * DEG_TO_RAD;
        const eccentricAnomalyRad = solveKeplerEquation(meanAnomalyRad, p.eccentricity);

        // 真近点角 ν と実際の日心距離 r (AU)
        const sinHalfE = Math.sin(eccentricAnomalyRad / 2);
        const cosHalfE = Math.cos(eccentricAnomalyRad / 2);
        const sqrtFactor = Math.sqrt((1 + p.eccentricity) / Math.max(0.001, 1 - p.eccentricity));
        const trueAnomalyRad = 2 * Math.atan2(sqrtFactor * sinHalfE, cosHalfE);
        const trueLongitudeDeg = normalizeDegrees(p.perihelionLongitudeDeg + trueAnomalyRad * RAD_TO_DEG);
        const helioDistAu = p.semiMajorAxisAu * (1 - p.eccentricity * Math.cos(eccentricAnomalyRad));

        // 軌道パス上の現在座標 (px, py, eclipticY, zPx)
        const dispOrbitEra = solveKeplerEquation(meanAnomalyRad, displayEcc);
        const posPx = computeOrbitPointPx(
          dispOrbitEra,
          displaySemiMajorPx,
          displayEcc,
          p.perihelionLongitudeDeg,
          p.inclinationDeg,
          p.ascendingNodeLongitudeDeg,
          tiltY,
          simState.inclinationBoost
        );

        const tiltAmount = 1 - tiltY;
        const depthScale = 1 + Math.max(-0.8, Math.min(0.8, posPx.sin2D)) * tiltAmount * 0.2;

        // 天文学的な黄道直交座標（AU）
        const omegaRad = (p.perihelionLongitudeDeg - p.ascendingNodeLongitudeDeg) * DEG_TO_RAD;
        const nodeRad = p.ascendingNodeLongitudeDeg * DEG_TO_RAD;
        const incRad = p.inclinationDeg * DEG_TO_RAD;
        const xOrbAu = helioDistAu * Math.cos(trueAnomalyRad + omegaRad);
        const yOrbAu = helioDistAu * Math.sin(trueAnomalyRad + omegaRad);
        const auX = xOrbAu * Math.cos(nodeRad) - yOrbAu * Math.cos(incRad) * Math.sin(nodeRad);
        const auY = xOrbAu * Math.sin(nodeRad) + yOrbAu * Math.cos(incRad) * Math.cos(nodeRad);
        const auZ = yOrbAu * Math.sin(incRad);

        planetWorldPos[p.id] = {
          x: posPx.x,
          y: posPx.y,
          eclipticY: posPx.eclipticY,
          zPx: posPx.zPx,
          zAu: auZ,
          auX,
          auY,
          helioDistAu,
          longitudeDeg: trueLongitudeDeg,
          depthScale,
        };

        // 彗星の場合：太陽の反対方向（反太陽方向）へ尾を向け、太陽に近いほど尾を長く輝かせる
        if (isComet && item.cometTailGroupEl && item.cometTailPathEl) {
          const antiSunAngleDeg = Math.atan2(posPx.y, posPx.x) * RAD_TO_DEG;
          // 近日点に近いほど尾が長くなる（22px 〜 62px）
          const proximityFactor = Math.max(0.18, Math.min(1.0, 2.2 / Math.max(0.4, helioDistAu)));
          const tailLen = 18 + proximityFactor * 44;
          const tailHalfWidth = anim.bodySizePx * 0.72;
          item.cometTailPathEl.setAttribute(
            'd',
            `M 0,-${tailHalfWidth.toFixed(1)} L ${tailLen.toFixed(1)},0 L 0,${tailHalfWidth.toFixed(1)} Z`
          );
          item.cometTailGroupEl.setAttribute('transform', `rotate(${antiSunAngleDeg.toFixed(1)})`);
          item.cometTailGroupEl.style.opacity = (0.45 + proximityFactor * 0.55).toFixed(2);
        }

        // 天体球体サイズ・多重環（リング）・選択リングの動的サイズ更新
        const bodyR = anim.bodySizePx;
        if (item.sphereEl) {
          if (isComet) {
            // 彗星核は正六面体（単位サイズの立方体グループを bodyR 倍に拡大）
            item.sphereEl.setAttribute('transform', `scale(${bodyR.toFixed(2)})`);
          } else if (p.id === 'haumea') {
            item.sphereEl.setAttribute('rx', (bodyR * 1.32).toFixed(2));
            item.sphereEl.setAttribute('ry', (bodyR * 0.82).toFixed(2));
          } else {
            item.sphereEl.setAttribute('r', bodyR.toFixed(2));
            if (item.textureGroupEl) {
              item.textureGroupEl.setAttribute('transform', `scale(${(bodyR / 10).toFixed(3)})`);
            }
            if (p.id === 'ceres' && ceresMiniTextureEl) {
              ceresMiniTextureEl.setAttribute('transform', `scale(${(bodyR / 5.8).toFixed(3)})`);
            }
            if (p.id === 'pluto' && plutoMiniTextureEl) {
              plutoMiniTextureEl.setAttribute('transform', `scale(${(bodyR / 6.4).toFixed(3)})`);
            }
          }
        }
        if (item.ringBands.length > 0) {
          // 巨大惑星（木星・土星・天王星・海王星）の環強調モードまたは選択時にサイズ・太さ・輝度をブースト
          const isGiantRinged = p.subGroup === 'outer_planet';
          const ringScaleBoost =
            isGiantRinged && simState.emphasizeRings ? (isSelected ? 1.24 : 1.15) : isSelected ? 1.12 : 1.0;
          const ringStrokeBoost =
            isGiantRinged && simState.emphasizeRings ? (isSelected ? 1.42 : 1.25) : 1.0;
          const sizeRatio = Math.max(0.55, bodyR / 10.5);

          for (const rb of item.ringBands) {
            const rx = bodyR * rb.band.radiusMultiplier * ringScaleBoost;
            const ry = rx * rb.aspectRatio;
            const sw = Math.max(0.75, rb.band.strokeWidthPx * sizeRatio * ringStrokeBoost);
            const frontOpacity = Math.min(
              1.0,
              rb.band.opacity * (isGiantRinged && simState.emphasizeRings ? 1.12 : 1.0)
            );
            const backOpacity = frontOpacity * 0.82;

            if (rb.backEl) {
              rb.backEl.setAttribute('rx', rx.toFixed(2));
              rb.backEl.setAttribute('ry', ry.toFixed(2));
              rb.backEl.setAttribute('stroke-width', sw.toFixed(2));
              rb.backEl.setAttribute('stroke-opacity', backOpacity.toFixed(2));
            }
            if (rb.frontEl) {
              rb.frontEl.setAttribute('rx', rx.toFixed(2));
              rb.frontEl.setAttribute('ry', ry.toFixed(2));
              rb.frontEl.setAttribute('stroke-width', sw.toFixed(2));
              rb.frontEl.setAttribute('stroke-opacity', frontOpacity.toFixed(2));
            }
          }
        }
        if (item.selRingEl) {
          const maxRingMult =
            p.ringSystem && p.ringSystem.bands.length > 0
              ? p.ringSystem.bands[p.ringSystem.bands.length - 1].radiusMultiplier * 1.15
              : 1.0;
          item.selRingEl.setAttribute('r', Math.max(bodyR + 5.5, bodyR * maxRingMult + 3.5).toFixed(2));
        }
        if (item.hitEl) {
          item.hitEl.setAttribute('r', Math.max(bodyR + 10, 16).toFixed(1));
        }

        // 天体ノードの配置更新
        if (item.nodeEl) {
          item.nodeEl.setAttribute(
            'transform',
            `translate(${posPx.x.toFixed(2)}, ${posPx.y.toFixed(2)}) scale(${depthScale.toFixed(3)})`
          );
          let nodeAlpha = effectiveOpacity;
          if (!isSelected) {
            if (simState.highlightDwarfs && !simState.highlightComets) {
              nodeAlpha = isDwarfOrCandidate ? 1.0 : effectiveOpacity * 0.28;
            } else if (simState.highlightComets && !simState.highlightDwarfs) {
              nodeAlpha = isComet ? 1.0 : effectiveOpacity * 0.28;
            } else if (simState.highlightDwarfs && simState.highlightComets) {
              nodeAlpha = isDwarfOrCandidate || isComet ? 1.0 : effectiveOpacity * 0.28;
            }
          }
          item.nodeEl.style.opacity = nodeAlpha.toFixed(2);
          item.nodeEl.classList.toggle('is-compact-body', anim.labelVisibility < 0.4 && !isSelected);
        }

        // 3D高度ドロップライン（垂直ステム線）と黄道面フットプリントの更新
        const view3dFactor = Math.max(0, Math.min(1, (1.0 - tiltY) / (1.0 - 0.44)));
        const isGuideActive =
          simState.showInclinationGuides &&
          !simState.isMoonSystemView &&
          effectiveOpacity >= 0.05 &&
          view3dFactor > 0.08 &&
          Math.abs(posPx.y - posPx.eclipticY) > 1.2;

        let showIncGuide = false;
        let isIncMuted = false;

        if (isGuideActive) {
          if (simState.incGuideMode === 'all') {
            // 全天体一括モード
            showIncGuide = true;
            isIncMuted = !isSelected;
          } else {
            // 選択天体スマート表示モード（推奨）
            if (simState.selectedBodyId !== 'overview') {
              // 特定天体を選択中は、その天体のみを鮮明に強調
              showIncGuide = isSelected;
              isIncMuted = false;
            } else {
              // 縮尺全体（未選択）時は、現在のアクティブ縮尺ゾーンで可視の天体をすっきりと控えめに表示
              showIncGuide = effectiveOpacity >= 0.35;
              isIncMuted = true;
            }
          }
        }

        if (item.incGuideGroupEl) {
          if (showIncGuide) {
            item.incGuideGroupEl.style.display = 'block';
            const isAbove = posPx.zPx > 0;
            const stemColor = isAbove ? '#38bdf8' : '#fb923c';
            const stemAlpha = isSelected
              ? 0.95
              : isIncMuted
                ? Math.min(0.35, 0.3 * view3dFactor)
                : lerp(0.35, 0.75, view3dFactor);

            if (item.incStemEl) {
              item.incStemEl.setAttribute('x1', posPx.x.toFixed(1));
              item.incStemEl.setAttribute('y1', posPx.y.toFixed(1));
              item.incStemEl.setAttribute('x2', posPx.x.toFixed(1));
              item.incStemEl.setAttribute('y2', posPx.eclipticY.toFixed(1));
              item.incStemEl.setAttribute('stroke', stemColor);
              item.incStemEl.setAttribute('stroke-opacity', stemAlpha.toFixed(2));
              item.incStemEl.setAttribute('stroke-width', isSelected ? '1.8' : isIncMuted ? '0.75' : '1.0');
              item.incStemEl.setAttribute('stroke-dasharray', isSelected ? 'none' : isIncMuted ? '2 2' : '3 2');
            }

            if (item.incFootprintEl) {
              item.incFootprintEl.setAttribute('cx', posPx.x.toFixed(1));
              item.incFootprintEl.setAttribute('cy', posPx.eclipticY.toFixed(1));
              const fpRx = Math.max(2.0, anim.bodySizePx * 0.45);
              item.incFootprintEl.setAttribute('rx', fpRx.toFixed(1));
              item.incFootprintEl.setAttribute('ry', (fpRx * tiltY).toFixed(1));
              item.incFootprintEl.setAttribute('fill', stemColor);
              item.incFootprintEl.setAttribute('fill-opacity', (stemAlpha * (isSelected ? 0.45 : 0.25)).toFixed(2));
              item.incFootprintEl.setAttribute('stroke', stemColor);
              item.incFootprintEl.setAttribute('stroke-opacity', stemAlpha.toFixed(2));
            }
          } else {
            item.incGuideGroupEl.style.display = 'none';
          }
        }

        // 衛星システムの更新
        const showThisMoons = simState.showMoons && (anim.moonVisibility > 0.15 || isSelected);
        if (item.moonsGroupEl) {
          item.moonsGroupEl.style.display = showThisMoons ? 'block' : 'none';
          item.moonsGroupEl.style.opacity = isSelected ? '1' : anim.moonVisibility.toFixed(2);
        }

        let maxMoonVerticalReach = 0;

        if (showThisMoons && item.moons.length > 0) {
          const moonOrbitScale = isSelected ? 1.15 : lerp(0.55, 1.0, anim.moonVisibility);

          const effectiveDaysForMoons = simState.moonTimeDays;

          // 3D斜めチルト視点へのブレンド率 (2D真上=0.0 ⇔ 3D斜め=1.0)
          const view3dFactor = Math.max(0, Math.min(1, (1.0 - tiltY) / (1.0 - 0.44)));
          // 天王星は3Dビュー時に衛星軌道も環と同じ横倒し赤道面（76°傾斜・縦長楕円）へ傾ける
          const isUranus = p.id === 'uranus';
          const moonPlaneTiltDeg = isUranus ? (p.ringSystem?.tiltDeg ?? 76) * view3dFactor : 0;
          const moonPlaneTiltRad = moonPlaneTiltDeg * DEG_TO_RAD;
          const cosPlane = Math.cos(moonPlaneTiltRad);
          const sinPlane = Math.sin(moonPlaneTiltRad);
          const uranusAspect = lerp(1.0, p.ringSystem?.aspectRatio ?? 0.36, view3dFactor);

          for (const mItem of item.moons) {
            const m = mItem.data;
            const mRx = m.orbitRadiusPx * moonOrbitScale;
            const mRy = isUranus ? mRx * uranusAspect : mRx * tiltY;
            const verticalReach = Math.hypot(mRx * sinPlane, mRy * cosPlane);
            if (verticalReach > maxMoonVerticalReach) maxMoonVerticalReach = verticalReach;

            if (mItem.orbitEl) {
              mItem.orbitEl.setAttribute('rx', mRx.toFixed(2));
              mItem.orbitEl.setAttribute('ry', mRy.toFixed(2));
              if (isUranus && moonPlaneTiltDeg > 0.1) {
                mItem.orbitEl.setAttribute('transform', `rotate(${moonPlaneTiltDeg.toFixed(2)})`);
              } else {
                mItem.orbitEl.removeAttribute('transform');
              }
            }

            const moonAngleDeg = normalizeDegrees(
              m.initialAngleDeg + (360 / m.orbitalPeriodDays) * effectiveDaysForMoons
            );
            const moonRad = -moonAngleDeg * DEG_TO_RAD;
            const cosM = Math.cos(moonRad);
            const sinM = Math.sin(moonRad);
            const localMx = cosM * mRx;
            const localMy = sinM * mRy;
            const mx = isUranus ? localMx * cosPlane - localMy * sinPlane : localMx;
            const my = isUranus ? localMx * sinPlane + localMy * cosPlane : localMy;

            if (mItem.nodeEl) {
              mItem.nodeEl.setAttribute('transform', `translate(${mx.toFixed(2)}, ${my.toFixed(2)})`);
              mItem.nodeEl.classList.toggle('is-highlighted', simState.highlightedMoonId === m.id);
            }

            if (mItem.labelEl) {
              const distFromCenter = Math.hypot(mx, my) || 1;
              const dirX = mx / distFromCenter;
              const dirY = my / distFromCenter;
              const labelOffsetR = m.sizePx + 5.5;
              const lx = dirX * labelOffsetR;
              const ly = dirY * labelOffsetR + 1.5;
              mItem.labelEl.setAttribute('x', lx.toFixed(1));
              mItem.labelEl.setAttribute('y', ly.toFixed(1));
              if (dirX > 0.35) {
                mItem.labelEl.setAttribute('text-anchor', 'start');
              } else if (dirX < -0.35) {
                mItem.labelEl.setAttribute('text-anchor', 'end');
              } else {
                mItem.labelEl.setAttribute('text-anchor', 'middle');
              }
            }
          }
        }

        // 天体名ラベルの位置調整
        if (item.labelGroupEl) {
          const labelY = isSelected
            ? Math.max(bodyR + 13, maxMoonVerticalReach + 12)
            : bodyR + 13;
          item.labelGroupEl.setAttribute(
            'transform',
            `translate(0, ${labelY.toFixed(1)}) scale(${invZoomLabelScale.toFixed(3)})`
          );
        }
      }

      // 選択天体の黄道面交点線 (Line of Nodes) と高度バッジの更新
      const selPlanet = cachedPlanets.find((cp) => cp.data.id === simState.selectedBodyId);
      const view3dFactor = Math.max(0, Math.min(1, (1.0 - tiltY) / (1.0 - 0.44)));
      const shouldShowNodesAxis =
        simState.showInclinationGuides &&
        !simState.isMoonSystemView &&
        selPlanet &&
        view3dFactor > 0.08 &&
        selPlanet.data.inclinationDeg > 0.1;

      if (selNodesAxisGroupEl) {
        if (shouldShowNodesAxis && selPlanet) {
          selNodesAxisGroupEl.style.display = 'block';
          const p = selPlanet.data;
          const anim = bodyAnimState[p.id];
          const displaySemiMajorPx = lerp(anim.autoOrbitRadiusPx, anim.auOrbitRadiusPx, auBlend);
          // 交点線の長さ（軌道長半径の約1.25倍）
          const axisR = displaySemiMajorPx * 1.25;
          const nodeRad = p.ascendingNodeLongitudeDeg * DEG_TO_RAD;
          // 黄道面上の交点線方向（昇交点方向角 nodeRad、画面系では y_flat = -sin(nodeRad)）
          const cosN = Math.cos(nodeRad);
          const sinN = Math.sin(nodeRad);
          const xAsc = axisR * cosN;
          const yAsc = -axisR * sinN * tiltY;
          const xDesc = -axisR * cosN;
          const yDesc = axisR * sinN * tiltY;

          if (selNodesAxisLineEl) {
            selNodesAxisLineEl.setAttribute('x1', xDesc.toFixed(1));
            selNodesAxisLineEl.setAttribute('y1', yDesc.toFixed(1));
            selNodesAxisLineEl.setAttribute('x2', xAsc.toFixed(1));
            selNodesAxisLineEl.setAttribute('y2', yAsc.toFixed(1));
          }
          if (selNodeAscMarkerEl) {
            selNodeAscMarkerEl.setAttribute('transform', `translate(${xAsc.toFixed(1)}, ${yAsc.toFixed(1)})`);
          }
          if (selNodeDescMarkerEl) {
            selNodeDescMarkerEl.setAttribute('transform', `translate(${xDesc.toFixed(1)}, ${yDesc.toFixed(1)})`);
          }

          // 高度情報バッジの更新
          if (selElevationBadgeGroupEl && selElevationBadgeTextEl) {
            const pos = planetWorldPos[p.id];
            if (pos && Math.abs(pos.y - pos.eclipticY) > 3) {
              selElevationBadgeGroupEl.style.display = 'block';
              const badgeX = pos.x + 10;
              const badgeY = (pos.y + pos.eclipticY) / 2 - 11;
              selElevationBadgeGroupEl.setAttribute('transform', `translate(${badgeX.toFixed(1)}, ${badgeY.toFixed(1)})`);
              const zSign = pos.zAu >= 0 ? '+' : '';
              selElevationBadgeTextEl.textContent = `Z: ${zSign}${pos.zAu.toFixed(2)} AU | 傾斜 ${p.inclinationDeg}°`;
            } else {
              selElevationBadgeGroupEl.style.display = 'none';
            }
          }
        } else {
          selNodesAxisGroupEl.style.display = 'none';
          if (selElevationBadgeGroupEl) selElevationBadgeGroupEl.style.display = 'none';
        }
      }

      // 選択中の天体がある場合、カメラ位置を天体の現在座標へスムーズに追従させる（太陽系全体ビュー時のみ）
      // 追従係数はフレームレートに依存しないよう、1フレーム(60fps)あたり0.18相当を経過時間で補正する
      if (!simState.isMoonSystemView) {
        const followK = 1 - Math.pow(1 - 0.18, Math.min(0.1, simState.frameDt) * 60);
        if (simState.selectedBodyId !== 'overview' && simState.selectedBodyId !== 'sun') {
          const targetPos = planetWorldPos[simState.selectedBodyId];
          if (targetPos) {
            simState.cameraX += (targetPos.x - simState.cameraX) * followK;
            simState.cameraY += (targetPos.y - simState.cameraY) * followK;
          }
        } else if (simState.selectedBodyId === 'sun') {
          simState.cameraX += (0 - simState.cameraX) * followK;
          simState.cameraY += (0 - simState.cameraY) * followK;
        }
      } else {
        renderMoonSystemView();
      }

      if (cameraRigEl) {
        const z = simState.cameraZoom;
        const tx = -simState.cameraX * z;
        const ty = -simState.cameraY * z;
        cameraRigEl.setAttribute(
          'transform',
          `translate(${tx.toFixed(2)}, ${ty.toFixed(2)}) scale(${z.toFixed(4)})`
        );
      }

      // HUDの日付表示と詳細パネルのリアルタイム数値を更新
      const dateStr = formatDaysToDateString(d);
      setTextIfChanged(hudDateEl, dateStr);
      if (hudJ2000El) {
        const sign = d >= 0 ? '+' : '';
        setTextIfChanged(
          hudJ2000El,
          `J2000.0 から ${sign}${d.toLocaleString('ja-JP', {
            minimumFractionDigits: 1,
            maximumFractionDigits: 1,
          })} 日`
        );
      }
      if (dateInputEl && document.activeElement !== dateInputEl && dateInputEl.value !== dateStr) {
        dateInputEl.value = dateStr;
      }

      if (simState.selectedBodyId !== 'overview' && simState.selectedBodyId !== 'sun') {
        const pPos = planetWorldPos[simState.selectedBodyId];
        const earthPos = planetWorldPos['earth'];
        if (pPos && earthPos) {
          setTextIfChanged(liveLongitudeEl, `${pPos.longitudeDeg.toFixed(1)}°`);
          setTextIfChanged(liveSunDistEl, `${pPos.helioDistAu.toFixed(2)} AU`);
          if (liveEarthDistEl) {
            if (simState.selectedBodyId === 'earth') {
              setTextIfChanged(liveEarthDistEl, '0.000 AU (基準)');
            } else {
              const distFromEarth = Math.hypot(pPos.auX - earthPos.auX, pPos.auY - earthPos.auY);
              setTextIfChanged(liveEarthDistEl, `${distFromEarth.toFixed(2)} AU`);
            }
          }
          if (liveZDistEl) {
            const zAu = pPos.zAu ?? 0;
            const zSign = zAu > 0.005 ? '+' : '';
            const dirLabel = Math.abs(zAu) < 0.01 ? '黄道面上' : zAu > 0 ? '北側 (上)' : '南側 (下)';
            setTextIfChanged(liveZDistEl, `${zSign}${zAu.toFixed(2)} AU (${dirLabel})`);
          }
        }
      }
    }

    // GSAP Ticker によるメインループ制御
    // 日付ジャンプ中のトゥイーン（再生による加算とトゥイーンが競合しないよう、ジャンプ中は再生加算を止める）
    let dateJumpTween: gsap.core.Tween | null = null;

    /**
     * 指定したJ2000起点日数へ滑らかにジャンプし、指定日にぴったり着地させる
     */
    function jumpToDay(targetDays: number, duration: number) {
      simState.sliderAnchorDays = targetDays;
      dateJumpTween?.kill();
      dateJumpTween = gsap.to(simState, {
        elapsedDays: targetDays,
        duration,
        ease: 'power3.out',
        overwrite: 'auto',
        onComplete: () => {
          dateJumpTween = null;
        },
      });
    }

    let lastTickerTime = gsap.ticker.time;
    gsap.ticker.add(() => {
      const nowTime = gsap.ticker.time;
      // タブが非表示（バックグラウンド）の間は計算とDOM更新を休止してCPU/GPU負荷を抑える
      if (document.hidden) {
        lastTickerTime = nowTime;
        return;
      }
      const dt = Math.min(nowTime - lastTickerTime, 0.1);
      lastTickerTime = nowTime;
      simState.frameDt = dt > 0 ? dt : 1 / 60;

      if (simState.isPlaying) {
        simState.visualAnimSec += dt * simState.direction;
        // 日付ジャンプのトゥイーン中は経過日数の再生加算を止め、指定日にぴったり着地させる
        if (!dateJumpTween) {
          const deltaDays = dt * simState.speedDaysPerSec * simState.direction;
          simState.elapsedDays += deltaDays;
          simState.sliderAnchorDays += deltaDays;
        }
      }

      renderSolarSystem();
    });

    function updateSpeedHud() {
      if (!hudSpeedEl) return;
      if (!simState.isPlaying) {
        hudSpeedEl.textContent = '⏸ 一時停止中';
        hudSpeedEl.classList.add('paused');
        return;
      }
      hudSpeedEl.classList.remove('paused');
      const dirSymbol = simState.direction > 0 ? '▶' : '◀◀';
      const s = simState.speedDaysPerSec;
      let label = `${s}日 / 秒`;
      if (s < 1) label = '2.4時間 / 秒';
      else if (s === 120) label = '約4ヶ月 / 秒';
      else if (s === 1826.25) label = '5年 / 秒';
      hudSpeedEl.textContent = `${dirSymbol} ${label}`;
    }

    /**
     * ハンバーガーメニュー（ドロワー）の開閉制御
     */
    let isDrawerOpen = false;
    function setDrawerOpen(open: boolean) {
      isDrawerOpen = open;
      btnHamburger?.classList.toggle('is-open', open);
      btnHamburger?.setAttribute('aria-expanded', String(open));
      menuBackdropEl?.classList.toggle('is-visible', open);
      if (menuDrawerEl) {
        gsap.to(menuDrawerEl, {
          x: open ? 0 : 340,
          autoAlpha: open ? 1 : 0,
          duration: 0.35,
          ease: open ? 'power3.out' : 'power2.in',
        });
      }
    }

    btnHamburger?.addEventListener('click', () => {
      setDrawerOpen(!isDrawerOpen);
    });
    btnCloseDrawer?.addEventListener('click', () => {
      setDrawerOpen(false);
    });
    menuBackdropEl?.addEventListener('click', () => {
      setDrawerOpen(false);
    });

    /**
     * 詳細パネルの表示・非表示アニメーション（PCでは右スライド、スマホ・タブレットでは下部ボトムシート）
     */
    function animateDetailPanel(show: boolean) {
      if (!detailPanelEl) return;
      const mobile = isMobileSheetLayout();
      if (show) {
        gsap.to(detailPanelEl, {
          x: 0,
          y: 0,
          autoAlpha: 1,
          duration: 0.48,
          ease: 'power3.out',
        });
      } else {
        gsap.to(detailPanelEl, {
          x: mobile ? 0 : 420,
          y: mobile ? 480 : 0,
          autoAlpha: 0,
          duration: 0.38,
          ease: 'power2.in',
        });
      }
    }

