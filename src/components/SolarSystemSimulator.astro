    backdrop-filter: blur(18px);
    border-left: 1px solid rgba(56, 189, 248, 0.3);
    z-index: 50;
    display: flex;
    flex-direction: column;
    box-shadow: -16px 0 40px rgba(0, 0, 0, 0.65);
  }

  .drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.95rem 1.1rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .drawer-header h3 {
    font-size: 0.9rem;
    font-weight: 700;
    color: #f8fafc;
  }

  .btn-close-drawer {
    width: 30px;
    height: 30px;
    border-radius: 7px;
    border: 1px solid var(--border-subtle);
    background: rgba(30, 41, 59, 0.6);
    color: #cbd5e1;
    cursor: pointer;
    display: grid;
    place-items: center;
  }

  .drawer-body {
    padding: 1rem 1.1rem;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
  }

  .drawer-section {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .drawer-label {
    font-size: 0.72rem;
    font-weight: 700;
    color: #38bdf8;
    letter-spacing: 0.04em;
  }

  .toggle-group {
    display: inline-flex;
    background: rgba(15, 23, 42, 0.85);
    border: 1px solid var(--border-subtle);
    border-radius: 8px;
    padding: 3px;
  }

  .toggle-group.full-width {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }

  .toggle-btn {
    border: none;
    background: transparent;
    color: var(--text-muted);
    font-size: 0.74rem;
    font-weight: 600;
    padding: 0.42rem 0.55rem;
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .toggle-btn.active {
    background: rgba(56, 189, 248, 0.22);
    color: #38bdf8;
  }

  .drawer-switch-list {
    display: flex;
    flex-direction: column;
    gap: 0.42rem;
  }

  .drawer-switch-btn {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 0.55rem 0.75rem;
    border-radius: 9px;
    border: 1px solid var(--border-subtle);
    background: rgba(15, 23, 42, 0.75);
    color: #cbd5e1;
    font-size: 0.76rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .drawer-switch-btn.active {
    border-color: rgba(56, 189, 248, 0.55);
    background: rgba(56, 189, 248, 0.16);
    color: #f8fafc;
  }

  .switch-state {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    padding: 0.1rem 0.45rem;
    border-radius: 999px;
    background: rgba(148, 163, 184, 0.2);
    color: #94a3b8;
  }

  .drawer-switch-btn.active .switch-state {
    background: rgba(52, 211, 153, 0.22);
    color: #34d399;
  }

  .drawer-legend-box {
    background: rgba(15, 23, 42, 0.65);
    border: 1px solid var(--border-subtle);
    border-radius: 9px;
    padding: 0.65rem 0.8rem;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    font-size: 0.72rem;
    color: #cbd5e1;
  }

  .legend-row {
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }

  .legend-line {
    width: 24px;
    height: 0;
    display: inline-block;
    flex-shrink: 0;
  }

  .legend-line.solid-line {
    border-top: 2px solid #38bdf8;
  }

  .legend-line.dashed-line {
    border-top: 2px dashed #d8b4fe;
  }

  .legend-line.dotted-line {
    border-top: 2px dotted #fb7185;
  }

  .legend-line.comet-line {
    border-top: 2px dashed #2dd4bf;
  }

  /* 下段：天体クイック選択バー（横スクロール対応） */
  .celestial-nav {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 0.25rem;
    padding-top: 0.24rem;
    padding-bottom: 0.15rem;
    border-top: 1px solid rgba(148, 163, 184, 0.1);
    overflow-x: auto;
    flex-wrap: nowrap;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
  }

  .celestial-nav::-webkit-scrollbar {
    height: 4px;
  }
  .celestial-nav::-webkit-scrollbar-thumb {
    background: rgba(148, 163, 184, 0.3);
    border-radius: 4px;
  }

  .nav-divider {
    width: 1px;
    height: 16px;
    background: rgba(148, 163, 184, 0.22);
    margin: 0 0.15rem;
    flex-shrink: 0;
  }

  .nav-section-tag {
    font-size: 0.62rem;
    font-weight: 700;
    color: #94a3b8;
    padding: 0 0.15rem;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .nav-section-tag.dwarf-tag {
    color: #a3e635;
  }

  .nav-section-tag.plutoid-tag {
    color: #d8b4fe;
  }

  .nav-section-tag.candidate-tag {
    color: #fda4af;
  }

  .nav-section-tag.comet-tag {
    color: #5eead4;
  }

  .nav-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.22rem;
    padding: 0.24rem 0.5rem;
    border-radius: 999px;
    border: 1px solid var(--border-subtle);
    background: rgba(15, 23, 42, 0.72);
    color: var(--text-main);
    font-size: 0.71rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s ease;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .nav-pill.dwarf-pill {
    border-style: dashed;
    border-color: rgba(163, 230, 53, 0.42);
  }

  .nav-pill.plutoid-pill {
    border-color: rgba(216, 180, 254, 0.42);
  }

  .nav-pill.candidate-pill {
    border-style: dotted;
    border-color: rgba(251, 113, 133, 0.48);
  }

  .nav-pill.comet-pill {
    border-style: dashed;
    border-color: rgba(45, 212, 191, 0.45);
  }

  .nav-pill.is-secondary-zone-pill {
    opacity: 0.5;
  }

  .nav-pill:hover {
    border-color: rgba(56, 189, 248, 0.55);
    background: rgba(30, 41, 59, 0.9);
    opacity: 1;
  }

  .nav-pill.active {
    border-style: solid;
    border-color: var(--accent-cyan);
    background: rgba(56, 189, 248, 0.22);
    box-shadow: 0 0 12px rgba(56, 189, 248, 0.28);
    opacity: 1;
  }

  .pill-symbol {
    font-size: 0.82rem;
  }

  .pill-class-badge {
    font-size: 0.58rem;
    font-weight: 700;
    padding: 0.01rem 0.25rem;
    border-radius: 4px;
    background: rgba(163, 230, 53, 0.2);
    color: #bef264;
  }

  .pill-class-badge.plutoid-badge {
    background: rgba(192, 132, 252, 0.22);
    color: #e9d5ff;
  }

  .pill-class-badge.candidate-badge {
    background: rgba(251, 113, 133, 0.22);
    color: #fecdd3;
  }

  .pill-class-badge.comet-badge {
    background: rgba(45, 212, 191, 0.22);
    color: #99f6e4;
  }

  .pill-moon-count {
    font-size: 0.6rem;
    padding: 0.01rem 0.28rem;
    border-radius: 999px;
    background: rgba(148, 163, 184, 0.2);
    color: #cbd5e1;
  }

  /* メインビューポート */
  .viewport-container {
    position: relative;
    z-index: 10;
    flex: 1;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .solar-svg {
    width: 100%;
    height: 100%;
    cursor: grab;
    display: block;
    touch-action: none;
  }

  /* 黄経グリッド目盛り */
  .grid-ring {
    fill: none;
    stroke: rgba(148, 163, 184, 0.12);
    stroke-width: 1;
    stroke-dasharray: 4 6;
  }

  .grid-spoke {
    stroke: rgba(148, 163, 184, 0.055);
    stroke-width: 1;
  }

  .grid-deg-label {
    fill: rgba(148, 163, 184, 0.36);
    font-family: var(--font-mono);
    font-size: 9.5px;
    text-anchor: middle;
    pointer-events: none;
  }

  /* 小惑星帯＆カイパーベルト（多層半透明ダスト・氷微粒子） */
  .belt-group {
    pointer-events: none;
  }

  .belt-band {
    fill: none;
  }

  .main-belt-halo {
    stroke: rgba(163, 230, 53, 0.032);
  }

  .main-belt-band {
    stroke: rgba(163, 230, 53, 0.068);
  }

  .kuiper-belt-halo {
    stroke: rgba(165, 243, 252, 0.032);
  }

  .kuiper-belt-band {
    stroke: rgba(192, 132, 252, 0.072);
  }

  .belt-particle {
    pointer-events: none;
  }

  .belt-particle.tier-halo,
  .belt-particle.tier-frost {
    filter: blur(0.6px);
  }

  /* 惑星・準惑星・準惑星候補・彗星の軌道線 */
  .planet-orbit {
    fill: none;
    stroke-width: 1.35;
    vector-effect: non-scaling-stroke;
  }

  .planet-orbit.orbit-style-dashed {
    stroke-dasharray: 6 4;
  }

  .planet-orbit.orbit-style-dotted {
    stroke-dasharray: 2.2 3.5;
    stroke-linecap: round;
  }

  .planet-orbit.orbit-style-comet {
    stroke-dasharray: 9 3.5 2 3.5;
    stroke-width: 1.25;
  }

  .moon-orbit {
    fill: none;
    stroke: rgba(226, 232, 240, 0.28);
    stroke-width: 0.9;
    stroke-dasharray: 2 2;
    vector-effect: non-scaling-stroke;
  }

  .comet-tail-group {
    pointer-events: none;
  }

  /* 天体ノード */
  .celestial-node {
    cursor: pointer;
    outline: none;
  }

  .celestial-node:hover {
    opacity: 1 !important;
  }

  .celestial-node:hover .planet-sphere {
    filter: url(#planet-glow);
  }

  .selection-ring {
    fill: none;
    stroke-width: 1.6;
    stroke-dasharray: 3 2;
    opacity: 0;
    transition: opacity 0.25s ease;
  }

  .celestial-node.is-selected .selection-ring,
  .celestial-node:hover .selection-ring {
    opacity: 0.95;
  }

  .body-label {
    fill: #e2e8f0;
    font-size: 10.2px;
    font-weight: 600;
    text-anchor: middle;
    pointer-events: none;
    paint-order: stroke;
    stroke: rgba(4, 7, 17, 0.92);
    stroke-width: 3.2px;
    stroke-linejoin: round;
    transition: opacity 0.25s ease;
  }

  .dwarf-label {
    fill: #e9d5ff;
    font-size: 9.8px;
  }

  .candidate-label {
    fill: #fecdd3;
    font-size: 9.6px;
  }

  .comet-label {
    fill: #99f6e4;
    font-size: 9.6px;
  }

  .celestial-node.is-compact-body .planet-label {
    opacity: 0;
  }

  .celestial-node.is-compact-body:hover .planet-label {
    opacity: 1;
  }

  .sun-label {
    fill: #fde047;
    font-size: 11px;
  }

  /* 衛星ラベル */
  .moon-label {
    fill: #cbd5e1;
    font-size: 5.5px;
    font-weight: 500;
    pointer-events: none;
    opacity: 0.68;
    paint-order: stroke;
    stroke: rgba(4, 7, 17, 0.92);
    stroke-width: 1.8px;
    transition: opacity 0.2s ease;
  }

  .celestial-node.is-selected .moon-label,
  .moon-node.is-highlighted .moon-label {
    opacity: 1;
    fill: #f8fafc;
  }

  .moon-node.is-highlighted .moon-sphere {
    stroke: #38bdf8;
    stroke-width: 1.2px;
  }

  /* 左上日時＆3段階縮尺ステータスバッジ */
  .hud-date-badge {
    position: absolute;
    top: 0.75rem;
    left: 0.9rem;
    background: var(--bg-panel);
    backdrop-filter: blur(12px);
    border: 1px solid var(--border-subtle);
    border-radius: 12px;
    padding: 0.55rem 0.85rem;
    pointer-events: none;
    max-width: 360px;
  }

  .hud-date-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.1rem;
  }

  .hud-badge-tag {
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--accent-cyan);
  }

  .hud-speed-indicator {
    font-size: 0.64rem;
    font-family: var(--font-mono);
    color: #34d399;
    background: rgba(16, 185, 129, 0.14);
    padding: 0.06rem 0.42rem;
    border-radius: 999px;
  }

  .hud-speed-indicator.paused {
    color: #fbbf24;
    background: rgba(251, 191, 36, 0.15);
  }

  .hud-current-date {
    font-family: var(--font-mono);
    font-size: 1.3rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    color: #ffffff;
  }

  .hud-j2000-days {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--text-muted);
  }

  .hud-zone-status {
    margin-top: 0.35rem;
    padding-top: 0.32rem;
    border-top: 1px solid rgba(148, 163, 184, 0.16);
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .hud-zone-title {
    font-size: 0.68rem;
    color: #cbd5e1;
  }

  .hud-zone-title strong {
    color: #38bdf8;
    font-weight: 700;
  }

  .hud-zone-range {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    color: var(--text-muted);
  }

  /* 左下ズームコントロール */
  .hud-bottom-left {
    position: absolute;
    bottom: 0.75rem;
    left: 0.9rem;
  }

  .hud-zoom-controls {
    display: flex;
    align-items: center;
    gap: 0.38rem;
  }

  .hud-icon-btn,
  .hud-reset-btn {
    background: var(--bg-panel);
    backdrop-filter: blur(10px);
    border: 1px solid var(--border-subtle);
    color: var(--text-main);
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .hud-icon-btn {
    width: 34px;
    height: 34px;
    font-size: 1rem;
    font-weight: 700;
    display: grid;
    place-items: center;
  }

  .hud-reset-btn {
    height: 34px;
    padding: 0 0.75rem;
    font-size: 0.72rem;
    font-weight: 600;
  }

  .hud-icon-btn:hover,
  .hud-reset-btn:hover {
    border-color: var(--border-highlight);
    background: rgba(30, 41, 59, 0.85);
  }

  /* 右側天体詳細パネル（PC表示） */
  .detail-panel {
    position: absolute;
    top: 0.75rem;
    right: 0.9rem;
    bottom: 0.75rem;
    width: 360px;
    max-width: calc(100vw - 1.8rem);
    background: rgba(10, 16, 33, 0.92);
    backdrop-filter: blur(16px);
    border: 1px solid rgba(148, 163, 184, 0.25);
    border-radius: 14px;
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    overflow-y: auto;
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.55);
    z-index: 25;
  }

  .sheet-drag-handle {
    display: none;
    width: 42px;
    height: 4px;
    border-radius: 999px;
    background: rgba(148, 163, 184, 0.35);
    margin: 0 auto 0.2rem;
    flex-shrink: 0;
  }

  .detail-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .detail-title-group {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .detail-symbol {
    font-size: 1.95rem;
    line-height: 1;
  }

  .detail-badges-row {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    margin-bottom: 0.18rem;
    flex-wrap: wrap;
  }

  .detail-class-badge {
    font-size: 0.62rem;
    font-weight: 700;
    padding: 0.08rem 0.45rem;
    border-radius: 4px;
  }

  .detail-class-badge.badge-planet {
    background: rgba(56, 189, 248, 0.2);
    color: #38bdf8;
  }

  .detail-class-badge.badge-dwarf {
    background: rgba(192, 132, 252, 0.22);
    color: #e9d5ff;
    border: 1px dashed rgba(192, 132, 252, 0.5);
  }

  .detail-class-badge.badge-candidate {
    background: rgba(251, 113, 133, 0.22);
    color: #fecdd3;
    border: 1px dotted rgba(251, 113, 133, 0.65);
  }

  .detail-class-badge.badge-comet {
    background: rgba(45, 212, 191, 0.22);
    color: #99f6e4;
    border: 1px dashed rgba(45, 212, 191, 0.6);
  }

  .detail-class-badge.badge-star {
    background: rgba(251, 191, 36, 0.22);
    color: #fde047;
  }

  .detail-zone-badge {
    font-size: 0.62rem;
    color: #94a3b8;
    background: rgba(148, 163, 184, 0.14);
    padding: 0.08rem 0.45rem;
    border-radius: 4px;
  }

  .detail-name-row {
    display: flex;
    align-items: baseline;
    gap: 0.45rem;
    flex-wrap: wrap;
  }

  .detail-name-row h2 {
    font-size: 1.15rem;
    font-weight: 700;
  }

  .detail-name-en {
    font-size: 0.76rem;
    color: var(--text-muted);
  }

  .detail-category {
    display: inline-block;
    font-size: 0.68rem;
    color: #38bdf8;
    margin-top: 0.1rem;
  }

  .btn-close-detail {
    background: rgba(148, 163, 184, 0.12);
    border: 1px solid transparent;
    color: var(--text-muted);
    width: 28px;
    height: 28px;
    border-radius: 6px;
    cursor: pointer;
    display: grid;
    place-items: center;
    flex-shrink: 0;
  }

  .btn-close-detail:hover {
    color: #ffffff;
    border-color: var(--border-subtle);
  }

  .detail-live-box {
    background: rgba(15, 23, 42, 0.78);
    border: 1px solid rgba(56, 189, 248, 0.28);
    border-radius: 10px;
    padding: 0.55rem 0.7rem;
  }

  .live-box-title {
    font-size: 0.65rem;
    font-weight: 700;
    color: #38bdf8;
    letter-spacing: 0.05em;
    margin-bottom: 0.3rem;
  }

  .live-metrics-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.38rem;
  }

  .live-metric {
    display: flex;
    flex-direction: column;
  }

  .metric-label {
    font-size: 0.62rem;
    color: var(--text-muted);
  }

  .metric-value {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 700;
    color: #f8fafc;
    margin-top: 0.08rem;
  }

  .detail-specs {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.38rem;
  }

  .spec-item {
    background: rgba(15, 23, 42, 0.55);
    border: 1px solid rgba(148, 163, 184, 0.12);
    border-radius: 8px;
    padding: 0.38rem 0.55rem;
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .spec-label {
    font-size: 0.62rem;
    color: var(--text-muted);
  }

  .spec-val {
    font-size: 0.72rem;
    font-weight: 600;
    color: #e2e8f0;
  }

  .detail-description {
    font-size: 0.76rem;
    line-height: 1.52;
    color: #cbd5e1;
  }

  /* 内部・マントル断面構造セクション */
  .detail-interior-section {
    border-top: 1px solid var(--border-subtle);
    padding-top: 0.65rem;
  }

  .moon-count-badge.interior-badge {
    background: rgba(249, 115, 22, 0.22);
    color: #fdba74;
  }

  .detail-interior-summary {
    font-size: 0.7rem;
    font-weight: 600;
    color: #fed7aa;
    margin-bottom: 0.45rem;
    line-height: 1.4;
  }

  .interior-visual-row {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    background: rgba(15, 23, 42, 0.72);
    border: 1px solid rgba(249, 115, 22, 0.22);
    border-radius: 10px;
    padding: 0.45rem 0.6rem;
    margin-bottom: 0.45rem;
  }

  .detail-interior-svg {
    width: 74px;
    height: 74px;
    flex-shrink: 0;
    filter: drop-shadow(0 0 8px rgba(249, 115, 22, 0.22));
  }

  .detail-interior-legend {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.22rem;
  }

  :global(.interior-legend-item) {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.66rem;
  }

  :global(.interior-legend-dot) {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  :global(.interior-legend-name) {
    color: #e2e8f0;
    font-weight: 600;
    flex: 1;
  }

  :global(.interior-legend-pct) {
    font-family: var(--font-mono);
    font-size: 0.6rem;
