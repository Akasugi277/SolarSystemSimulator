        );
        blueEjectaOuter.setAttribute('fill', 'rgba(99, 118, 192, 0.34)');
        atmoClipGroupEl.appendChild(blueEjectaOuter);

        const blueEjectaInner = document.createElementNS(svgNs, 'ellipse');
        blueEjectaInner.setAttribute('cx', '-12');
        blueEjectaInner.setAttribute('cy', '14');
        blueEjectaInner.setAttribute('rx', '26');
        blueEjectaInner.setAttribute('ry', '30');
        blueEjectaInner.setAttribute('fill', 'rgba(147, 168, 238, 0.26)');
        blueEjectaInner.setAttribute('transform', 'rotate(-18 -12 14)');
        atmoClipGroupEl.appendChild(blueEjectaInner);

        // 3. ケレス全面を覆う大小の衝突クレーター群（ドーン実写の凹凸質感）
        for (const cr of [
          { cx: -36, cy: -38, r: 9.5 },
          { cx: -18, cy: -48, r: 6.2 },
          { cx: -48, cy: -14, r: 7.4 },
          { cx: -52, cy: 14, r: 6.0 },
          { cx: -36, cy: 36, r: 8.8 },
          { cx: -14, cy: 52, r: 10.5 },
          { cx: 14, cy: 46, r: 8.2 },
          { cx: 38, cy: 36, r: 9.0 },
          { cx: 52, cy: 8, r: 7.5 },
          { cx: 24, cy: 12, r: 8.4 },
          { cx: 16, cy: -12, r: 6.8 },
          { cx: -6, cy: -32, r: 5.4 },
          { cx: -28, cy: -22, r: 4.8 },
          { cx: -26, cy: 22, r: 4.5 },
          { cx: 4, cy: 28, r: 5.2 },
          { cx: 42, cy: -8, r: 5.8 },
        ]) {
          const cEl = document.createElementNS(svgNs, 'circle');
          cEl.setAttribute('cx', String(cr.cx));
          cEl.setAttribute('cy', String(cr.cy));
          cEl.setAttribute('r', String(cr.r));
          cEl.setAttribute('fill', 'rgba(36, 33, 26, 0.44)');
          cEl.setAttribute('stroke', 'rgba(218, 208, 178, 0.42)');
          cEl.setAttribute('stroke-width', '1.0');
          atmoClipGroupEl.appendChild(cEl);
