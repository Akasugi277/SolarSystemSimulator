        style="display: none;"
      >
        🔍 天体と衛星軌道の専用拡大ビューで表示
      </button>

      <!-- 内部・マントル構造セクション（太陽・8惑星・ケレス・冥王星・エリス選択時に表示） -->
      <div id="detail-interior-section" class="detail-interior-section" style="display: none;">
        <div class="moons-section-header">
          <h3 id="detail-interior-heading">🌐 内部・マントル断面構造</h3>
